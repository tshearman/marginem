{
	"name": "blogupdate",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "node",
	"forwardPorts": [4321],
	"portsAttributes": {
		"4321": {
			"label": "Astro dev server"
		}
	},
	"postCreateCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"astro-build.astro-vscode",
				"biomejs.biome",
				"dbaeumer.vscode-eslint"
			]
		}
	}
}
