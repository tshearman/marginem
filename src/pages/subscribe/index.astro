---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { SITE_NAME } from "../../lib/site";
---

<BaseLayout
  title={`Subscribe | ${SITE_NAME}`}
  description="Email updates when new posts land."
  hero="Subscribe"
  heroNarrow={"SUBSC\nRIBE"}
  heroHeight={140}
  eyebrow="Newsletter"
  bodyClass="full-height"
>
  <div class="page-shell">
    <h2 class="page-statement">Subscribe for notifications on new posts!</h2>
    <SubscribeForm />
  </div>
</BaseLayout>
