---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { SITE_NAME } from "../../lib/site";

export const prerender = true;
---

<BaseLayout
  title={`Subscription confirmed | ${SITE_NAME}`}
  description="You are subscribed."
  hero="You're all set"
  showHero={false}
>
  <PageIntro
    eyebrow="Confirmed"
    title="Subscription confirmed"
    description="Thanks for confirming. You're on the list, and future updates will land in your inbox."
  />
  <section class="subscribe-cta">
    <div class="subscribe-cta__actions">
      <a class="subscribe-cta__button" href="/">Read Recent Posts</a>
      <a class="subscribe-cta__button" href="/newsletter/">
        Peruse Previous Newsletters
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .subscribe-cta {
    text-align: center;
    margin: 5rem auto 0;
    display: grid;
    gap: 1.2rem;
  }

  .subscribe-cta__copy {
    margin: 0;
    color: rgba(15, 23, 42, 0.72);
  }

  .subscribe-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .subscribe-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background-color: #000;
    color: #fff;
  }

  @media (max-width: 640px) {
    .subscribe-cta__actions {
      flex-direction: column;
    }

    .subscribe-cta__button {
      width: 100%;
    }
  }
</style>
