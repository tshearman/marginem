---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../lib/site";
---

<BaseLayout
  title={`Subscription confirmed | ${SITE_NAME}`}
  description="You are subscribed."
  hero="Confirmed"
  heroHeight={140}
  eyebrow="Subscription confirmed"
  bannerSrLabel="Subscription confirmed"
  bodyClass="full-height"
>
  <section class="confirm-hero">
    <p class="page-statement">
      Thanks for confirming &mdash;<br />you're on the list.
    </p>
    <div class="confirm-hero__actions">
      <a class="btn" href="/">Read recent posts</a>
      <a class="btn" href="/newsletter/">Previous newsletters</a>
    </div>
  </section>
</BaseLayout>
