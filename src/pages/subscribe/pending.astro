---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Banner from "../../components/Banner.astro";
import { SITE_NAME } from "../../lib/site";

export const prerender = true;
---

<BaseLayout
  title={`Confirm your subscription | ${SITE_NAME}`}
  description="Check your inbox for a confirmation email."
  hero="Check your inbox"
  showHero={false}
  bodyClass="brutalist form-page subscribe-pending-page"
>
  <div class="page-hero">
    <div class="page-hero__banner">
      <Banner
        text="CHECK INBOX"
        textNarrow={"CHECK\nINBOX"}
        height={140}
        srLabel="Almost there"
      />
      <span class="page-hero__eyebrow">One more step</span>
    </div>
  </div>

  <section class="confirm-hero">
    <p class="confirm-hero__message">
      Almost there &mdash;<br />click the link in your inbox.
    </p>
    <p class="confirm-hero__note">
      If it doesn't show up in a few minutes, check your spam folder or try
      again.
    </p>
    <div class="confirm-hero__actions">
      <a class="btn" href="/">Read recent posts</a>
      <a class="btn" href="/newsletter/">Previous newsletters</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  body.subscribe-pending-page .confirm-hero {
    flex: 1;
    padding: clamp(40px, 10vh, 120px) clamp(16px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  body.subscribe-pending-page .confirm-hero__message {
    margin: 0 0 20px;
    font-family: var(--display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  body.subscribe-pending-page .confirm-hero__note {
    margin: 0 0 40px;
    max-width: 40ch;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: rgb(var(--ink-rgb) / 0.75);
  }

  body.subscribe-pending-page .confirm-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
</style>
