---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../lib/site";
---

<BaseLayout
  title={`Confirm your subscription | ${SITE_NAME}`}
  description="Check your inbox for a confirmation email."
  hero="Check inbox"
  heroNarrow={"CHECK\nINBOX"}
  heroHeight={140}
  eyebrow="One more step"
  bannerSrLabel="Almost there"
  bodyClass="full-height"
>
  <section class="confirm-hero">
    <p class="page-statement">
      Almost there &mdash;<br />click the link in your inbox.
    </p>
    <p class="confirm-hero__note">
      If it doesn't show up in a few minutes, check your spam folder or try
      again.
    </p>
    <div class="confirm-hero__actions">
      <a class="btn" href="/">Read recent posts</a>
      <a class="btn" href="/newsletter/">Previous newsletters</a>
    </div>
  </section>
</BaseLayout>
