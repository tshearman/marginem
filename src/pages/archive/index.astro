---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import { MAIN_PAGES } from "../../lib/site";
import { loadArchiveItems, sortArchiveItems } from "../../lib/archive";

const items = sortArchiveItems(await loadArchiveItems());
const allTags = [...new Set(items.flatMap((item) => item.tags))].sort((a, b) =>
	a.localeCompare(b),
);
const categories = [
	MAIN_PAGES.writing,
	MAIN_PAGES.commonplace,
	MAIN_PAGES.garden,
	MAIN_PAGES.newsletter,
].map((page) => page.label);
---

<BaseLayout
  title={MAIN_PAGES.archive.pageTitle}
  description={MAIN_PAGES.archive.description}
  hero={MAIN_PAGES.archive.label}
  heroHeight={140}
  eyebrow={MAIN_PAGES.archive.eyebrow}
  subtitle={MAIN_PAGES.archive.description}
  activePage={MAIN_PAGES.archive.label}
>
  <div class="page-shell">
    {
      items.length ? (
        <ArchiveList
          items={items}
          filterConfig={{
            filterSelector: ".tag-filter-container .tag--filter",
            categoryFilterSelector: ".category-filter-container [data-category]",
            itemSelector: ".archive-item",
            itemTagSelector: ".archive-item .tag--filter",
            groupSelector: ".archive-year",
            countId: "entriesCount",
            hintId: "entriesClearHint",
            countLabel: "entries",
          }}
        >
          <TagFilterPanel tags={allTags} categories={categories} />
          <FilterableCount contentType="entries" totalCount={items.length} />
        </ArchiveList>
      ) : (
        <p>No entries yet. Check back soon.</p>
      )
    }
  </div>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>
