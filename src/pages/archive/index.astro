---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Banner from "../../components/Banner.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import { getCollection } from "astro:content";
import { MAIN_PAGES } from "../../lib/site";
import { formatAttribution, loadCommonplaceNotes } from "../../lib/commonplace";
import { loadGardenNotes } from "../../lib/garden";
import { plainExcerpt } from "../../lib/gardenPageUtils";
import { oneLineSnippet } from "../../lib/text";
import { generateNoteId } from "../../lib/noteUtils";
import { withSlugs } from "../../lib/content";

/**
 * Normalised archive entry: every kind funnels through ArchiveEntry, so the
 * row only needs title/url/description/tags + a sortDate (used for ordering
 * and year grouping) and a displayDate (rendered in the row, may differ —
 * commonplace notes sort by date-added but display their stated date).
 */
type ArchiveItem = {
	kind: "blog" | "newsletter" | "commonplace" | "garden";
	category: string;
	tags: string[];
	title: string;
	url: string;
	description: string;
	sortDate?: Date;
	displayDate?: Date;
};

export const prerender = true;

const [posts, newsletters, commonplaceNotes, gardenNotes] = await Promise.all([
	getCollection("blog", ({ data }) => !data.draft),
	getCollection("newsletter", ({ data }) => !data.draft),
	loadCommonplaceNotes(),
	loadGardenNotes(),
]);

const postsWithSlugs = withSlugs(posts);
const newslettersWithSlugs = withSlugs(newsletters);

const archiveItems: ArchiveItem[] = [
	...postsWithSlugs.map(
		(post): ArchiveItem => ({
			kind: "blog",
			category: MAIN_PAGES.writing.label,
			tags: post.data.tags ?? [],
			title: post.data.title,
			url: `/posts/${post.slug}/`,
			description: post.data.abstract ?? post.data.description ?? "",
			sortDate: post.data.pubDate,
			displayDate: post.data.pubDate,
		}),
	),
	...newslettersWithSlugs.map(
		(entry): ArchiveItem => ({
			kind: "newsletter",
			category: MAIN_PAGES.newsletter.label,
			tags: entry.data.tags ?? [],
			title: `Issue ${entry.data.issueNumber}: ${entry.data.title}`,
			url: `/newsletter/${entry.slug}/`,
			description: entry.data.description ?? "",
			sortDate: entry.data.pubDate,
			displayDate: entry.data.pubDate,
		}),
	),
	...commonplaceNotes.map((note): ArchiveItem => {
		const noteId = generateNoteId({
			content: note.content,
			author: note.author,
			date: note.date,
		});
		return {
			kind: "commonplace",
			category: MAIN_PAGES.commonplace.label,
			tags: note.tags ?? [],
			title: `"${oneLineSnippet(note.content, 140)}"`,
			url: `${MAIN_PAGES.commonplace.href}#${noteId}`,
			description: formatAttribution(note),
			// Sort/group by the date the note was added to the site; display the
			// note's stated date (fall back to addedAt if missing).
			sortDate: note.addedAt,
			displayDate: note.date ?? note.addedAt,
		};
	}),
	...gardenNotes.map(
		(note): ArchiveItem => ({
			kind: "garden",
			category: MAIN_PAGES.garden.label,
			tags: note.tags ?? [],
			title: note.title,
			url: `/garden/${note.slug}/`,
			description: plainExcerpt(note.content),
			sortDate: note.date ?? note.updatedAt,
			displayDate: note.date ?? note.updatedAt,
		}),
	),
];

const sortedItems = archiveItems.sort((a, b) => {
	const aTime = a.sortDate?.getTime();
	const bTime = b.sortDate?.getTime();
	if (aTime != null && bTime != null) return bTime - aTime;
	if (aTime != null) return -1;
	if (bTime != null) return 1;
	return a.title.localeCompare(b.title);
});

type ItemsByYear = Record<string, ArchiveItem[]>;
const itemsByYear = sortedItems.reduce<ItemsByYear>((acc, item) => {
	const year = item.sortDate
		? item.sortDate.getFullYear().toString()
		: "Undated";
	if (!acc[year]) acc[year] = [];
	acc[year].push(item);
	return acc;
}, {});

const groupedYears = Object.entries(itemsByYear).sort((a, b) => {
	if (a[0] === "Undated") return 1;
	if (b[0] === "Undated") return -1;
	return Number(b[0]) - Number(a[0]);
});

const allTags = [...new Set(sortedItems.flatMap((item) => item.tags))].sort(
	(a, b) => a.localeCompare(b),
);

const categoryOptions = [
	{ label: MAIN_PAGES.writing.label, value: MAIN_PAGES.writing.label },
	{ label: MAIN_PAGES.commonplace.label, value: MAIN_PAGES.commonplace.label },
	{ label: MAIN_PAGES.garden.label, value: MAIN_PAGES.garden.label },
	{ label: MAIN_PAGES.newsletter.label, value: MAIN_PAGES.newsletter.label },
];

const archiveFilterConfig = JSON.stringify({
	filterSelector: ".tag-filter-container .tag--filter",
	categoryFilterSelector: ".category-filter-container [data-category]",
	countId: "entriesCount",
	hintId: "entriesClearHint",
	itemSelector: ".archive-item",
	itemTagSelector: ".archive-item .tag--filter",
	groupSelector: ".archive-year",
	groupItemSelector: ".archive-item",
	stateKey: "archive-all",
	countLabel: "entries",
});
---
<BaseLayout
  title={MAIN_PAGES.archive.pageTitle}
  description={MAIN_PAGES.archive.description}
  hero={MAIN_PAGES.archive.label}
  showHero={false}
  activePage={MAIN_PAGES.archive.label}
  bodyClass="brutalist archive-page"
>
  <div class="page-hero">
    <div class="page-hero__banner">
      <Banner
        text="ARCHIVE"
        height={140}
        srLabel={MAIN_PAGES.archive.label}
      />
      <span class="page-hero__eyebrow">{MAIN_PAGES.archive.eyebrow}</span>
    </div>
    <p class="page-hero__subtitle">{MAIN_PAGES.archive.description}</p>
  </div>

  <div class="page-shell">
  {
    !sortedItems.length ? (
      <p>No entries yet. Check back soon.</p>
    ) : (
      <section class="archive-page" data-filter-config={archiveFilterConfig}>
        <TagFilterPanel tags={allTags} categories={categoryOptions} />
        <FilterableCount contentType="entries" totalCount={sortedItems.length} />
        <div class="archive-years">
          {groupedYears.map(([year, yearEntries]) => (
            <section class="archive-year">
              <h2>{year}</h2>
              <div class="archive-year__entries">
                {yearEntries.map((entry) => (
                  <div
                    class="archive-item"
                    data-tags={JSON.stringify(entry.tags)}
                    data-categories={JSON.stringify([entry.category])}
                  >
                    <ArchiveEntry
                      title={entry.title}
                      url={entry.url}
                      date={entry.displayDate ?? entry.sortDate ?? new Date(0)}
                      description={entry.description}
                      tags={entry.tags}
                      showYear={entry.kind === "commonplace"}
                    />
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )
  }
  </div>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>

<style is:global>
  /*
   * Archive-specific styles. The brutalist frame, hero, shell, tag panel, and
   * count strip come from brutalist-page.css (body.brutalist); this block only
   * adds the inner layout and year-group styling unique to the archive index.
   */

  body.archive-page .archive-page {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ---- YEAR GROUPS ---- */
  body.archive-page .archive-years {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  body.archive-page .archive-year {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  body.archive-page .archive-year h2 {
    display: inline-block;
    align-self: flex-start;
    margin: 0;
    padding: 2px 10px;
    font-family: var(--display);
    font-size: var(--fs-md);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
  }

  body.archive-page .archive-year__entries {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  body.archive-page .archive-item.hidden {
    display: none;
  }

  body.archive-page .archive-item__tags {
    margin: 0 8px 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

</style>
