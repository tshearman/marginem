---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import { getCollection } from "astro:content";
import filterScript from "../../scripts/filterable-content.js?url";
import { MAIN_PAGES } from "../../lib/site";

type BlogEntry = CollectionEntry<"blog">;
type PostsByYear = Record<string, BlogEntry[]>;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
) as BlogEntry[];

const postsByYear = posts.reduce<PostsByYear>((acc, post) => {
	const year = post.data.pubDate.getFullYear().toString();
	if (!acc[year]) {
		acc[year] = [];
	}
	acc[year].push(post);
	return acc;
}, {});

const groupedYears = Object.entries(postsByYear).sort(
	(a, b) => Number(b[0]) - Number(a[0]),
);

const allTags = [
	...new Set(posts.flatMap((post) => post.data.tags || [])),
].sort((a, b) => a.localeCompare(b));

const archiveFilterConfig = JSON.stringify({
	filterSelector: ".tag-filter-container .tag--filter",
	countId: "postsCount",
	hintId: "postsClearHint",
	itemSelector: ".archive-entry",
	itemTagSelector: ".archive-entry .tag--filter",
	stateKey: "archive-posts",
	countLabel: "posts",
});
---
<BaseLayout
  title={MAIN_PAGES.archive.pageTitle}
  description={MAIN_PAGES.archive.description}
  hero={MAIN_PAGES.archive.label}
  showHero={false}
>
  <PageIntro
    eyebrow={MAIN_PAGES.archive.eyebrow}
    title={MAIN_PAGES.archive.label}
    description={MAIN_PAGES.archive.description}
  />
  {
    !posts.length ? (
      <p>No posts yet. Check back soon.</p>
    ) : (
      <section class="archive-page" data-filter-config={archiveFilterConfig}>
        <TagFilterPanel tags={allTags} />
        <FilterableCount
          contentType="posts"
          totalCount={posts.length}
          class="archive-count"
        />
        <div class="archive-years">
          {groupedYears.map(([year, yearPosts]) => (
            <section class="archive-year">
              <h2>{year}</h2>
              <div class="archive-year__entries">
                {yearPosts.map((post) => (
                  <ArchiveEntry
                    title={post.data.title}
                    url={`/posts/${post.slug}/`}
                    date={post.data.pubDate}
                    description={post.data.description}
                    abstract={post.data.abstract}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .archive-page {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .archive-count {
    padding: 0 0.5rem;
  }

  .archive-years {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .archive-year h2 {
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 1rem;
    color: rgba(15, 23, 42, 0.65);
  }

  .archive-year__entries {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .archive-entry {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    background: #fff;
    transition: border-color 0.2s ease;
  }

  .archive-entry:hover {
    border-color: rgba(15, 23, 42, 0.25);
  }

  .archive-entry.hidden {
    display: none;
  }

  @media (max-width: 760px) {
    .archive-count {
      padding: 0;
    }
  }
</style>

<script type="module" is:inline src={filterScript}></script>
