---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Banner from "../../components/Banner.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import { getCollection } from "astro:content";
import { MAIN_PAGES } from "../../lib/site";
import { loadCommonplaceNotes } from "../../lib/commonplace";
import { loadGardenNotes } from "../../lib/garden";
import { plainExcerpt } from "../../lib/gardenPageUtils";
import { generateNoteId } from "../../lib/noteUtils";
import { withSlugs } from "../../lib/content";

/**
 * Normalised archive entry: every kind funnels through ArchiveEntry, so the
 * row only needs title/url/description/tags + a sortDate (used for ordering
 * and year grouping) and a displayDate (rendered in the row, may differ —
 * commonplace notes sort by date-added but display their stated date).
 */
type ArchiveItem = {
	kind: "blog" | "newsletter" | "commonplace" | "garden";
	category: string;
	tags: string[];
	title: string;
	url: string;
	description: string;
	sortDate?: Date;
	displayDate?: Date;
};

export const prerender = true;

const [posts, newsletters, commonplaceNotes, gardenNotes] = await Promise.all([
	getCollection("blog", ({ data }) => !data.draft),
	getCollection("newsletter", ({ data }) => !data.draft),
	loadCommonplaceNotes(),
	loadGardenNotes(),
]);

const postsWithSlugs = withSlugs(posts);
const newslettersWithSlugs = withSlugs(newsletters);

// One-line snippet of a quote for use as a commonplace row's title.
const snippet = (text: string, max = 140): string => {
	const collapsed = text.replace(/\s+/g, " ").trim();
	if (collapsed.length <= max) return collapsed;
	const cut = collapsed.slice(0, max);
	const lastSpace = cut.lastIndexOf(" ");
	return `${cut.slice(0, lastSpace > 0 ? lastSpace : max).trimEnd()}…`;
};

const attribution = (note: { author?: string; source?: string }): string =>
	[note.author, note.source].filter(Boolean).join(" — ");

const archiveItems: ArchiveItem[] = [
	...postsWithSlugs.map(
		(post): ArchiveItem => ({
			kind: "blog",
			category: MAIN_PAGES.writing.label,
			tags: post.data.tags ?? [],
			title: post.data.title,
			url: `/posts/${post.slug}/`,
			description: post.data.abstract ?? post.data.description ?? "",
			sortDate: post.data.pubDate,
			displayDate: post.data.pubDate,
		}),
	),
	...newslettersWithSlugs.map(
		(entry): ArchiveItem => ({
			kind: "newsletter",
			category: MAIN_PAGES.newsletter.label,
			tags: entry.data.tags ?? [],
			title: `Issue ${entry.data.issueNumber}: ${entry.data.title}`,
			url: `/newsletter/${entry.slug}/`,
			description: entry.data.description ?? "",
			sortDate: entry.data.pubDate,
			displayDate: entry.data.pubDate,
		}),
	),
	...commonplaceNotes.map((note): ArchiveItem => {
		const noteId = generateNoteId({
			content: note.content,
			author: note.author,
			tags: note.tags,
			date: note.date,
		});
		return {
			kind: "commonplace",
			category: MAIN_PAGES.commonplace.label,
			tags: note.tags ?? [],
			title: `"${snippet(note.content)}"`,
			url: `${MAIN_PAGES.commonplace.href}#${noteId}`,
			description: attribution(note),
			// Sort/group by the date the note was added to the site; display the
			// note's stated date (fall back to addedAt if missing).
			sortDate: note.addedAt,
			displayDate: note.date ?? note.addedAt,
		};
	}),
	...gardenNotes.map(
		(note): ArchiveItem => ({
			kind: "garden",
			category: MAIN_PAGES.garden.label,
			tags: note.tags ?? [],
			title: note.title,
			url: `/garden/${note.slug}/`,
			description: plainExcerpt(note.content),
			sortDate: note.date ?? note.updatedAt,
			displayDate: note.date ?? note.updatedAt,
		}),
	),
];

const sortedItems = archiveItems.sort((a, b) => {
	const aTime = a.sortDate?.getTime();
	const bTime = b.sortDate?.getTime();
	if (aTime != null && bTime != null) return bTime - aTime;
	if (aTime != null) return -1;
	if (bTime != null) return 1;
	return a.title.localeCompare(b.title);
});

type ItemsByYear = Record<string, ArchiveItem[]>;
const itemsByYear = sortedItems.reduce<ItemsByYear>((acc, item) => {
	const year = item.sortDate
		? item.sortDate.getFullYear().toString()
		: "Undated";
	if (!acc[year]) acc[year] = [];
	acc[year].push(item);
	return acc;
}, {});

const groupedYears = Object.entries(itemsByYear).sort((a, b) => {
	if (a[0] === "Undated") return 1;
	if (b[0] === "Undated") return -1;
	return Number(b[0]) - Number(a[0]);
});

const allTags = [...new Set(sortedItems.flatMap((item) => item.tags))].sort(
	(a, b) => a.localeCompare(b),
);

const categoryOptions = [
	{ label: MAIN_PAGES.writing.label, value: MAIN_PAGES.writing.label },
	{ label: MAIN_PAGES.commonplace.label, value: MAIN_PAGES.commonplace.label },
	{ label: MAIN_PAGES.garden.label, value: MAIN_PAGES.garden.label },
	{ label: MAIN_PAGES.newsletter.label, value: MAIN_PAGES.newsletter.label },
];

const archiveFilterConfig = JSON.stringify({
	filterSelector: ".tag-filter-container .tag--filter",
	categoryFilterSelector: ".category-filter-container [data-category]",
	countId: "entriesCount",
	hintId: "entriesClearHint",
	itemSelector: ".archive-item",
	itemTagSelector: ".archive-item .tag--filter",
	groupSelector: ".archive-year",
	groupItemSelector: ".archive-item",
	stateKey: "archive-all",
	countLabel: "entries",
});
---
<BaseLayout
  title={MAIN_PAGES.archive.pageTitle}
  description={MAIN_PAGES.archive.description}
  hero={MAIN_PAGES.archive.label}
  showHero={false}
  activePage={MAIN_PAGES.archive.label}
  bodyClass="archive-page"
>
  <div class="archive-hero">
    <div class="archive-hero__banner">
      <Banner
        text="ARCHIVE"
        height={140}
        srLabel={MAIN_PAGES.archive.label}
      />
      <span class="archive-hero__eyebrow">{MAIN_PAGES.archive.eyebrow}</span>
    </div>
    <p class="archive-hero__subtitle">{MAIN_PAGES.archive.description}</p>
  </div>

  <div class="archive-shell">
  {
    !sortedItems.length ? (
      <p>No entries yet. Check back soon.</p>
    ) : (
      <section class="archive-page" data-filter-config={archiveFilterConfig}>
        <TagFilterPanel tags={allTags} categories={categoryOptions} />
        <FilterableCount
          contentType="entries"
          totalCount={sortedItems.length}
          class="archive-count"
        />
        <div class="archive-years">
          {groupedYears.map(([year, yearEntries]) => (
            <section class="archive-year">
              <h2>{year}</h2>
              <div class="archive-year__entries">
                {yearEntries.map((entry) => (
                  <div
                    class="archive-item"
                    data-tags={JSON.stringify(entry.tags)}
                    data-categories={JSON.stringify([entry.category])}
                  >
                    <ArchiveEntry
                      title={entry.title}
                      url={entry.url}
                      date={entry.displayDate ?? entry.sortDate ?? new Date(0)}
                      description={entry.description}
                      tags={entry.tags}
                      showYear={entry.kind === "commonplace"}
                    />
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )
  }
  </div>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>

<style is:global>
  /*
   * Brutalist archive index styles. Scoped by `body.archive-page` (set above
   * via BaseLayout's bodyClass). Mirrors commonplace/garden/newsletter so the
   * archive section adopts the same frame, hero, tag-chip, and count patterns.
   */

  /* ---- PAGE FRAME ---- */
  body.archive-page {
    max-width: 860px;
    margin: 0 auto;
    font-family: var(--mono);
    line-height: 1.4;
    color: var(--ink);
    background: var(--paper);
    border-left: 4px solid var(--ink);
    border-right: 4px solid var(--ink);
  }

  /* ---- HERO ---- */
  body.archive-page .archive-hero {
    margin: 0;
  }

  body.archive-page .archive-hero__banner {
    position: relative;
  }

  body.archive-page .archive-hero .banner {
    width: 100%;
    border-bottom: 4px solid var(--ink);
  }

  body.archive-page .archive-hero__eyebrow {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 3px 10px;
    font-family: var(--display);
    font-size: var(--fs-2xs);
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  body.archive-page .archive-hero__subtitle {
    margin: 0;
    padding: 10px 12px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper);
  }

  /* ---- SHELL ---- */
  body.archive-page .archive-shell {
    padding: 24px clamp(16px, 4vw, 48px) 40px;
  }

  body.archive-page .archive-page {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ---- TAG / CATEGORY FILTER PANELS ---- */
  body.archive-page .tag-filter-container,
  body.archive-page .category-filter-container {
    margin: 0;
  }

  body.archive-page .category-filter-container {
    margin-top: 1rem;
  }

  body.archive-page .tag-filter-section {
    margin: 0;
    padding: 0;
    border-radius: 0;
    text-align: left;
  }

  body.archive-page .tag-filter-section h3 {
    display: inline-block;
    margin: 0 0 12px;
    padding: 2px 8px;
    font-family: var(--display);
    font-size: var(--fs-sm);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper) !important;
    background: var(--ink);
  }

  body.archive-page .tag-filter-section .tag-list {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-start;
  }

  body.archive-page .tag {
    border-radius: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--fs-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 8px;
    margin: 0;
    line-height: 1.3;
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  body.archive-page .tag--small {
    font-size: var(--fs-3xs);
    padding: 1px 6px;
  }

  body.archive-page .tag:hover,
  body.archive-page .tag--filter:hover {
    background: var(--highlight);
    color: var(--ink);
  }

  body.archive-page .tag--filter[data-selected="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  body.archive-page .tag--filter[data-selected="true"]:hover {
    background: var(--highlight);
    color: var(--ink);
  }

  /* ---- COUNT ---- */
  body.archive-page .archive-count {
    margin: 0.5rem 0 0;
    padding: 8px 0;
    border-top: 1px dotted var(--ink);
    border-bottom: 1px dotted var(--ink);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  body.archive-page .archive-count .count-text {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  body.archive-page .archive-count .clear-hint {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / 0.65);
  }

  /* ---- YEAR GROUPS ---- */
  body.archive-page .archive-years {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  body.archive-page .archive-year {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  body.archive-page .archive-year h2 {
    display: inline-block;
    align-self: flex-start;
    margin: 0;
    padding: 2px 10px;
    font-family: var(--display);
    font-size: var(--fs-md);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
  }

  body.archive-page .archive-year__entries {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  body.archive-page .archive-item.hidden {
    display: none;
  }

  body.archive-page .archive-item__tags {
    margin: 0 8px 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ---- MOBILE ---- */
  @media (max-width: 720px) {
    body.archive-page {
      border-left: none;
      border-right: none;
    }
    body.archive-page .archive-shell {
      padding: 18px 14px 32px;
    }
    body.archive-page .site-footer {
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
  }
</style>
