---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/PostPreview.astro";
import Pagination from "../../components/Pagination.astro";
import { getCollection } from "astro:content";
import { POSTS_PER_PAGE } from "../../lib/blog";
import { formatDate } from "../../lib/date";

type BlogEntry = CollectionEntry<"blog">;

export async function getStaticPaths() {
	const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	) as BlogEntry[];
	const pageCount = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
	return Array.from({ length: Math.max(pageCount - 1, 0) }).map((_, index) => {
		const currentPage = index + 2;
		const start = (currentPage - 1) * POSTS_PER_PAGE;
		const pagePosts = posts.slice(start, start + POSTS_PER_PAGE);
		return {
			params: { page: String(currentPage) },
			props: { pagePosts, currentPage, pageCount },
		};
	});
}

interface PageProps {
	pagePosts?: BlogEntry[];
	currentPage: number;
	pageCount: number;
}

const { pagePosts = [], currentPage, pageCount } = Astro.props as PageProps;
---
<BaseLayout title={`Page ${currentPage} | Notebook`} description="Older posts" hero="Notebook">
  {pagePosts.map((post) => (
    <PostPreview
      id={post.slug}
      title={post.data.title}
      url={`/posts/${post.slug}/`}
      pubDate={post.data.pubDate?.toISOString?.() ?? ''}
      displayDate={formatDate(post.data.pubDate)}
      description={post.data.description ?? ''}
      abstract={post.data.abstract ?? post.data.description ?? ''}
      tags={post.data.tags}
    />
  ))}
  <Pagination currentPage={currentPage} totalPages={pageCount} />
</BaseLayout>
