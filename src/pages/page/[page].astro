---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 5;

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const pageCount = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  return Array.from({ length: Math.max(pageCount - 1, 0) }).map((_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const pagePosts = posts.slice(start, start + POSTS_PER_PAGE);
    return {
      params: { page: String(currentPage) },
      props: { pagePosts, currentPage, pageCount }
    };
  });
}

const { pagePosts = [], currentPage, pageCount } = Astro.props;
const formatDate = (date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---
<BaseLayout title={`Page ${currentPage} | Notebook`} description="Older posts" hero="Notebook">
  {pagePosts.map((post) => (
    <article style="margin-bottom: 3rem;">
      <p style="margin: 0; color: #64748b;">{formatDate(post.data.pubDate)}</p>
      <h2 style="margin: 0.35rem 0 0.5rem;">
        <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
      </h2>
      <p>{post.data.description}</p>
      <TagList tags={post.data.tags} />
    </article>
  ))}
  <Pagination currentPage={currentPage} totalPages={pageCount} />
</BaseLayout>
