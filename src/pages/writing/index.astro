---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import { MAIN_PAGES } from "../../lib/site";
import { loadArchiveItems, sortArchiveItems } from "../../lib/archive";

const posts = sortArchiveItems(
	(await loadArchiveItems()).filter((item) => item.kind === "blog"),
);
const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort((a, b) =>
	a.localeCompare(b),
);
---

<BaseLayout
  title={MAIN_PAGES.writing.pageTitle}
  description={MAIN_PAGES.writing.description}
  hero={MAIN_PAGES.writing.label}
  heroHeight={140}
  eyebrow={MAIN_PAGES.writing.eyebrow}
  subtitle={MAIN_PAGES.writing.description}
  activePage={MAIN_PAGES.writing.label}
>
  <div class="page-shell">
    {
      posts.length ? (
        <ArchiveList
          items={posts}
          filterConfig={{
            filterSelector: ".tag-filter-container .tag--filter",
            itemSelector: ".archive-item",
            itemTagSelector: ".archive-item .tag--filter",
            groupSelector: ".archive-year",
            countId: "postsCount",
            hintId: "postsClearHint",
            countLabel: "posts",
          }}
        >
          <TagFilterPanel tags={allTags} />
          <FilterableCount contentType="posts" totalCount={posts.length} />
        </ArchiveList>
      ) : (
        <p>No posts yet. Check back soon.</p>
      )
    }
  </div>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>
