---
import BaseLayout from "../layouts/BaseLayout.astro";
import Banner from "../components/Banner.astro";
import { MAIN_PAGES, SITE_NAME } from "../lib/site";

export const prerender = true;
---

<BaseLayout
  title={`Page not found | ${SITE_NAME}`}
  description="The page you are looking for does not exist."
  hero="Page not found"
  showHero={false}
  activePage={undefined}
  bodyClass="brutalist not-found-page"
>
  <div class="page-hero">
    <div class="page-hero__banner">
      <Banner text="404" srLabel="Page not found" />
      <span class="page-hero__eyebrow">Page not found</span>
    </div>
  </div>

  <section class="not-found__banner">
    <p class="not-found__message">That page has wandered off.</p>
    <div class="not-found__actions">
      <a class="btn btn--invert" href="/">Home</a>
      <a class="btn btn--invert" href={MAIN_PAGES.archive.href}>Archive</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Reuses the brutalist frame (body.brutalist), the .page-hero banner, and
     the shared .btn buttons. The rules below add the full-height layout: the
     content container is black, the centred message sits on it, and the footer
     is pinned to the bottom of the window on the page's paper background. */

  /* Fill the viewport so the footer rests at the bottom of the window. */
  body.not-found-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body.not-found-page .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--ink);
  }

  /* The message + actions, centred on the black container. */
  body.not-found-page .not-found__banner {
    padding: clamp(28px, 6vh, 64px) 18px;
    margin: 2rem 0;
    color: var(--paper);
    text-align: center;
  }

  body.not-found-page .site-footer {
    margin-top: auto;
    /* Keep the footer on the page's paper background like every other page,
       even though the content container above it is black for this test. */
    background: var(--paper);
  }

  body.not-found-page .not-found__message {
    margin: 0 0 20px;
    font-family: var(--display);
    font-size: var(--fs-2xl);
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--paper);
  }

  body.not-found-page .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
</style>
