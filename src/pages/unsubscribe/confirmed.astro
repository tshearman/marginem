---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../lib/site";
---

<BaseLayout
  title={`Unsubscribed | ${SITE_NAME}`}
  description="You have been removed from the list."
  hero="Unsubscribed"
  heroNarrow={"UNSUB\nSCRIBED"}
  heroHeight={140}
  eyebrow="Unsubscribed"
  bannerSrLabel="You're unsubscribed"
  bodyClass="full-height"
>
  <section class="confirm-hero">
    <p class="page-statement">
      You're off the list &mdash;<br />no more emails from me.
    </p>
    <p class="confirm-hero__note">
      If this was a mistake, you can resubscribe anytime.
    </p>
    <div class="confirm-hero__actions">
      <a class="btn" href="/">Read recent posts</a>
      <a class="btn" href="/subscribe/">Subscribe again</a>
    </div>
  </section>
</BaseLayout>
