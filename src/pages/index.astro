---
import { MAIN_PAGES, MAIN_NAV, SITE_NAME, WRITING_PAGE_POST_LIMIT } from "../lib/site";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/date";
import { withSlugs, type BlogEntry } from "../lib/content";
import { formatAttribution, loadCommonplaceNotes } from "../lib/commonplace";
import { oneLineSnippet } from "../lib/text";
import { KIND_LABELS } from "../lib/kinds";
import BaseLayout from "../layouts/BaseLayout.astro";
import SubscribeBanner from "../components/SubscribeBanner.astro";
import "../styles/home.css";

export const prerender = true;

const posts = withSlugs(
	await getCollection("blog", ({ data }) => !data.draft),
).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
) as BlogEntry[];
const latestPosts = posts.slice(0, WRITING_PAGE_POST_LIMIT);

const RECENT_COMMONPLACE_LIMIT = 5;
const recentCommonplace = (await loadCommonplaceNotes())
	.sort((a, b) => b.addedAt.getTime() - a.addedAt.getTime())
	.slice(0, RECENT_COMMONPLACE_LIMIT);

type FeedItem =
	| { kind: "writing"; date: Date; post: BlogEntry }
	| {
			kind: "commonplace";
			date: Date;
			note: (typeof recentCommonplace)[number];
	  };

const feed: FeedItem[] = [
	...latestPosts.map(
		(post) => ({ kind: "writing", date: post.data.pubDate, post }) as FeedItem,
	),
	...recentCommonplace.map(
		(note) => ({ kind: "commonplace", date: note.addedAt, note }) as FeedItem,
	),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, WRITING_PAGE_POST_LIMIT + RECENT_COMMONPLACE_LIMIT);

const getAbstract = (post: BlogEntry) =>
	post.data.abstract ?? post.data.description ?? "";

// The six site sections, rendered as an overview grid of brutalist cells.
const sections = MAIN_NAV.map((page, i) => ({
	label: page.label,
	href: page.href,
	eyebrow: page.eyebrow,
	description: page.description,
	mark: `§${i + 1}`,
}));

const title = `${SITE_NAME} — Notes from the Margins`;
const description = MAIN_PAGES.writing.description;
const postCount = posts.length;
---

<BaseLayout
  title={title}
  description={description}
  hero="MARGINEM"
  bannerSrLabel="Ad Marginem — Notes from the margins"
  activePage="Writing"
  bodyClass="brutalist home-page"
>
  <div class="grid">
    <div class="cell tall" id="about">
      <p class="lead">Essays, experiments, and explorations from the margins.</p>
      <p>
        A working notebook on mathematics, computing, learning, and games.
        Longer-form writing sits beside collected quotations and a live view
        of a personal Obsidian vault &mdash; theory and marginalia in one place.
      </p>
      <p class="stat">
        {postCount} essays<br />+ commonplace &amp; garden<br />1 newsletter
      </p>
      <p><a class="btn btn--invert" href="#subscribe">Subscribe</a></p>
    </div>

    {
      sections.map((s) => (
        <a class="cell cell--link" href={s.href}>
          <h2>{s.label}</h2>
          <p class="cell__eyebrow">{s.eyebrow}</p>
          <p>{s.description}</p>
        </a>
      ))
    }
  </div>

  <section class="block" id="still-drying">
    <h2>Still Drying</h2>
    <ul class="index">
      {
        feed.map((item) =>
          item.kind === "writing" ? (
            <li>
              <span class="index__kind">{KIND_LABELS.writing}</span>
              <span class="index__body">
                <a href={`/posts/${item.post.slug}/`}>{item.post.data.title}</a>
                <span class="index__excerpt">{getAbstract(item.post)}</span>
              </span>
              <span class="index__date">{formatDate(item.post.data.pubDate)}</span>
            </li>
          ) : (
            <li>
              <span class="index__kind">{KIND_LABELS.note}</span>
              <span class="index__body">
                <a href={MAIN_PAGES.commonplace.href}>"{oneLineSnippet(item.note.content)}"</a>
                <span class="index__excerpt">{formatAttribution(item.note)}</span>
              </span>
              <span class="index__date">{item.note.date ? formatDate(item.note.date) : ""}</span>
            </li>
          ),
        )
      }
    </ul>
    <p class="block__more">
      <a class="btn" href={MAIN_PAGES.archive.href}>Full Archive</a>
    </p>
  </section>

  <SubscribeBanner invert />
</BaseLayout>
