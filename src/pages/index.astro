---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLayouts from '../components/HomeLayouts.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { POSTS_PER_PAGE } from '../lib/blog';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const pageCount = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const formatDate = (date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---
<BaseLayout
  title="Notebook"
  description="Ideas on math, visualization, and systems"
  hero="Notebook"
>
  <HomeLayouts posts={pagePosts} formatDate={formatDate} />
  <Pagination currentPage={1} totalPages={pageCount} />
</BaseLayout>
