---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import Pagination from "../components/Pagination.astro";
import PageIntro from "../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { POSTS_PER_PAGE } from "../lib/blog";

type BlogEntry = CollectionEntry<"blog">;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
) as BlogEntry[];
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const pageCount = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("en", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(date);
---
<BaseLayout
  title="Notebook"
  description="Ideas on math, visualization, and systems"
  hero="Notebook"
  showHero={false}
>
  <PageIntro
    eyebrow="Ideas on math, visualization, and systems"
    title="Notebook"
    description="Fresh research notes, experiments, and essays."
  />
  <HomeLayout posts={pagePosts} formatDate={formatDate} />
  <Pagination currentPage={1} totalPages={pageCount} />
</BaseLayout>
