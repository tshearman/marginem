---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { MAIN_PAGES } from "../lib/site";
import { getCollection } from "astro:content";
import { POSTS_PER_PAGE } from "../lib/blog";
import { formatDate } from "../lib/date";

type BlogEntry = CollectionEntry<"blog">;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
) as BlogEntry[];
const pagePosts = posts.slice(0, 7);
---

<BaseLayout
  title={MAIN_PAGES.writing.pageTitle}
  description={MAIN_PAGES.writing.description}
  hero={MAIN_PAGES.writing.label}
  showHero={false}
>
  <PageIntro
    eyebrow={MAIN_PAGES.writing.eyebrow}
    title={MAIN_PAGES.writing.label}
    description={MAIN_PAGES.writing.description}
  />
  <HomeLayout posts={pagePosts} formatDate={formatDate} />
  <nav class="notes-older" aria-label="Archive link">
    <a href="/archive/">Archive →</a>
  </nav>
</BaseLayout>

<style>
  .notes-older {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: right;
  }

  .notes-older a {
    font-size: 0.95rem;
  }
</style>
