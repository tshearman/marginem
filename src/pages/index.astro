---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { MAIN_PAGES, WRITING_PAGE_POST_LIMIT } from "../lib/site";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/date";
import SubscribeForm from "src/components/SubscribeForm.astro";

type BlogEntry = CollectionEntry<"blog">;

export const prerender = true;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
) as BlogEntry[];
const pagePosts = posts.slice(0, WRITING_PAGE_POST_LIMIT);
---

<BaseLayout
  title={MAIN_PAGES.writing.pageTitle}
  description={MAIN_PAGES.writing.description}
  hero={MAIN_PAGES.writing.label}
  showHero={false}
  activePage={MAIN_PAGES.writing.label}
>
  <PageIntro
    eyebrow={MAIN_PAGES.writing.eyebrow}
    title={MAIN_PAGES.writing.label}
    description={MAIN_PAGES.writing.description}
  />
  <HomeLayout posts={pagePosts} formatDate={formatDate} />
  <hr class="subscription-divider" />
  <h2>Stay connected</h2>
  <div>
    <SubscribeForm variant="compact" redirectUrl="/subscribe/confirmed" />
  </div>
</BaseLayout>

<style>
  .notes-older {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: right;
  }

  .notes-older a {
    font-size: 0.95rem;
  }

  .subscription-divider {
    border: 0;
    border-top: 1px solid rgba(15, 23, 42, 0.12);
    margin: 5rem 0 5rem;
  }
</style>
