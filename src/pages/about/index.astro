---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import iconWriting from "../../assets/icons/fa-pen-nib-solid-full.svg?raw";
import iconCommonplace from "../../assets/icons/fa-quote-right-solid-full.svg?raw";
import iconGarden from "../../assets/icons/fa-leaf-solid-full.svg?raw";
import iconArchive from "../../assets/icons/fa-box-archive-solid-full.svg?raw";
import iconNewsletter from "../../assets/icons/pa-newspaper-solid-full.svg?raw";
import { MAIN_PAGES, SITE_NAME } from "../../lib/site";

export const prerender = true;

const ICONS = {
  writing: iconWriting,
  commonplace: iconCommonplace,
  garden: iconGarden,
  archive: iconArchive,
  newsletter: iconNewsletter,
};

const mosaicPages = [
  { ...MAIN_PAGES.writing, size: "wide" },
  { ...MAIN_PAGES.commonplace, size: "normal" },
  { ...MAIN_PAGES.garden, size: "normal" },
  { ...MAIN_PAGES.newsletter, size: "normal" },
  { ...MAIN_PAGES.archive, size: "normal" },
];
---

<BaseLayout
  title={`${MAIN_PAGES.about.pageTitle}`}
  description={MAIN_PAGES.about.description}
  hero={MAIN_PAGES.about.label}
  showHero={false}
  activePage={MAIN_PAGES.about.label}
>
  <PageIntro
    eyebrow=`${MAIN_PAGES.about.eyebrow}`
    title=`${SITE_NAME}`
    description=`This is a place for long-form writing, notes in progress, and newsletters.`
  />
  <section class="about-page">
    <h2 class="about-page__heading">Why write?</h2>
    <h2 class="about-page__heading">What you’ll find here</h2>
    <div class="about-page__mosaic">
      {
        mosaicPages.map((page) =>
          (() => {
            const icon = ICONS[page.icon] ?? iconGarden;
            const isImageIcon =
              typeof icon === "string" && !icon.trim().startsWith("<");
            return (
              <a
                class={`about-page__mosaic-item ${
                  page.size === "wide" ? "about-page__mosaic-item--wide" : ""
                }`}
                href={page.href}
              >
                {isImageIcon ? (
                  <img
                    class="about-page__mosaic-icon"
                    src={icon}
                    alt=""
                    aria-hidden="true"
                  />
                ) : (
                  <span
                    class="about-page__mosaic-icon"
                    aria-hidden="true"
                    set:html={icon}
                  />
                )}
                <span class="about-page__mosaic-eyebrow">{page.eyebrow}</span>
                <h2>{page.label}</h2>
                <p>{page.description}</p>
              </a>
            );
          })(),
        )
      }
    </div>
  </section>
  <div class="about-page__subscribe">
    <SubscribeForm variant="compact" redirectUrl="/subscribe/confirmed" />
  </div>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: 1.5rem;
    margin: 0 auto 3rem;
  }

  .about-page__heading {
    margin: 0;
    font-size: 1.4rem;
  }

  .about-page__mosaic {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-page__mosaic-item {
    border: var(--thin-border);
    border-radius: 1.25rem;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    min-height: 11rem;
    padding: 1.5rem;
    text-decoration: none;
  }

  .about-page__mosaic-icon {
    align-items: center;
    background: rgb(var(--ink-rgb) / 0.08);
    border-radius: 999px;
    display: inline-flex;
    height: 1.6rem;
    justify-content: center;
    width: 1.6rem;
  }

  .about-page__mosaic-icon {
    color: var(--fg);
  }

  .about-page__mosaic-icon :global(svg) {
    height: 1.5rem;
    width: 1.5rem;
  }

  .about-page__mosaic-icon :global(svg path) {
    fill: currentColor;
  }

  .about-page__mosaic-icon img {
    height: 0.85rem;
    width: 0.85rem;
  }

  .about-page__mosaic-item:hover .about-page__mosaic-icon {
    color: var(--accent);
  }

  .about-page__mosaic-item--wide {
    grid-column: span 2;
  }

  .about-page__mosaic-eyebrow {
    color: rgb(var(--ink-rgb) / 0.6);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-page__mosaic-item h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .about-page__mosaic-item p {
    margin: 0;
    color: rgb(var(--ink-rgb) / 0.75);
  }

  .about-page__card {
    background: rgb(var(--ink-rgb) / 0.04);
    border: var(--thin-border);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .about-page__card h2 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
  }

  .about-page__card p {
    margin: 0;
    color: rgb(var(--ink-rgb) / 0.75);
  }

  .subscription-divider {
    border: 0;
    border-top: var(--thin-border);
    margin: 3rem 0 3rem;
  }

  .about-page__subscribe {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .about-page__mosaic {
      grid-template-columns: 1fr;
    }

    .about-page__mosaic-item {
      min-height: auto;
      padding: 1.25rem;
    }

    .about-page__mosaic-item--wide {
      grid-column: auto;
    }

    .about-page__card {
      padding: 1.25rem;
    }
  }
</style>
