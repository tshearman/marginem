---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/date";
import {
  createGardenLinkResolver,
  type GardenNote,
  loadGardenNotes,
  renderGardenMarkdown,
} from "../../lib/garden";

export const prerender = true;

export async function getStaticPaths() {
  const notes = await loadGardenNotes({ includeUnpublished: true });
  const published = notes.filter((note) => note.published);
  return published.map((note) => ({
    params: { slug: note.slug },
    props: { note, notes },
  }));
}

interface PageProps {
  note: GardenNote;
  notes: GardenNote[];
}

const { note, notes } = Astro.props as PageProps;
const resolveLink = createGardenLinkResolver(notes);
const { html } = await renderGardenMarkdown(note.content, resolveLink);

const breadcrumbSegments = note.relativePath.replace(/\.md$/i, "").split("/");
const breadcrumbLinks = breadcrumbSegments.map((segment, index) => {
  const href =
    index === breadcrumbSegments.length - 1
      ? undefined
      : `/garden/${breadcrumbSegments
          .slice(0, index + 1)
          .map(slugify)
          .join("/")}/`;
  return { label: segment, href };
});

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-");
}
---

<BaseLayout
  title={`${note.title} | Garden`}
  description="Living note pulled from the Obsidian vault."
  hero="Garden"
  showHero={false}
>
  <article class="garden-entry">
    <header class="garden-entry__header">
      <p class="garden-entry__eyebrow">Updated {formatDate(note.updatedAt)}</p>
      <nav class="garden-entry__breadcrumbs" aria-label="Breadcrumb">
        <a href="/garden/">Garden</a>
        {
          breadcrumbLinks.map((crumb) => (
            <>
              <span aria-hidden="true">/</span>
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span>{crumb.label}</span>
              )}
            </>
          ))
        }
      </nav>
    </header>

    <div class="garden-entry__content" set:html={html} />
  </article>
</BaseLayout>

<style>
  .garden-entry {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .garden-entry__eyebrow {
    margin: 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: rgba(15, 23, 42, 0.65);
  }

  .garden-entry__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    color: rgba(15, 23, 42, 0.7);
  }

  .garden-entry__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .garden-entry__breadcrumbs a:hover,
  .garden-entry__breadcrumbs a:focus-visible {
    text-decoration: underline;
  }

  .garden-entry__header h1 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .garden-entry__content :global(h2) {
    margin-top: 1.25rem;
  }

  .garden-entry__content :global(a[data-obsidian-link]) {
    border-bottom: 1px dashed rgba(15, 23, 42, 0.25);
  }
</style>
