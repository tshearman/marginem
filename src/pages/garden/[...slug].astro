---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GardenLayout from "../../layouts/GardenLayout.astro";
import ForceGraph from "../../components/ForceGraph.astro";
import DateStamp from "../../components/DateStamp.astro";
import { formatDate } from "../../lib/date";
import "../../styles/post.css";
import "../../styles/garden.css";
// Mirror of the KaTeX imports in PostLayout — garden notes go through
// rehype-katex (see src/lib/garden.ts) and reuse `.paper-body` typography, so
// they need both the vendor stylesheet and our overrides to render math.
import "katex/dist/katex.min.css";
import "../../styles/katex.css";
import {
	createGardenLinkResolver,
	type GardenNote,
	loadGardenNotes,
	renderGardenMarkdown,
} from "../../lib/garden";
import {
	buildFolderGraphData,
	buildNeighborGraphData,
	buildBreadcrumbs,
	collectFolderPaths,
	getIncomingNeighborSlugs,
	getOutgoingNeighborSlugs,
	plainExcerpt,
} from "../../lib/gardenPageUtils";
import { slugifyObsidianTarget } from "../../../plugins/remark-obsidian-links.js";
import { MAIN_PAGES } from "../../lib/site";

export async function getStaticPaths() {
	const notes = await loadGardenNotes({ includeUnpublished: true });
	const published = notes.filter((note) => note.published);
	const notePaths = published.map((note) => ({
		params: { slug: note.slug },
		props: { type: "note", note, notes },
	}));

	const folderPages = collectFolderPaths(published).map((folderPath) => ({
		params: { slug: slugifyObsidianTarget(folderPath) },
		props: { type: "folder", folderPath, notes: published },
	}));

	return [...notePaths, ...folderPages];
}

interface PageProps {
	type: "note" | "folder";
	note?: GardenNote;
	notes: GardenNote[];
	folderPath?: string;
}

const { type, note, notes, folderPath } = Astro.props as PageProps;
const resolveLink = createGardenLinkResolver(notes);

const noteBreadcrumbs = note
	? buildBreadcrumbs(note.relativePath.replace(/\.md$/i, "").split("/"))
	: [];

const folderSegments = folderPath ? folderPath.split("/") : [];
const folderBreadcrumbs = folderSegments.length
	? buildBreadcrumbs(folderSegments)
	: [];

const folderNotes = folderPath
	? notes.filter((item) => item.relativePath.startsWith(`${folderPath}/`))
	: [];

const folderNoteCards = folderNotes.map((item) => ({
	...item,
	excerpt: plainExcerpt(item.content),
}));

const { nodes: graphNodeList, links: folderGraphLinks } =
	folderPath && folderNotes.length
		? buildFolderGraphData({ folderNotes, folderPath, resolveLink })
		: { nodes: [], links: [] };

const noteBySlug = new Map(notes.map((item) => [item.slug, item]));
const currentSlug = note?.slug ?? "";

const outgoingNeighborSlugs = note
	? getOutgoingNeighborSlugs(note, resolveLink)
	: [];

const incomingNeighborSlugs =
	note && currentSlug
		? getIncomingNeighborSlugs(notes, currentSlug, resolveLink)
		: [];

const backlinks = incomingNeighborSlugs
	.map((slug) => noteBySlug.get(slug))
	.filter((item): item is GardenNote => Boolean(item))
	.map((item) => ({
		slug: item.slug,
		title: item.title,
	}))
	.sort((a, b) => a.title.localeCompare(b.title));

const { nodes: neighborNodes, links: neighborEdges } =
	note && currentSlug
		? buildNeighborGraphData({
				note,
				notes,
				resolveLink,
				incomingNeighborSlugs,
				outgoingNeighborSlugs,
			})
		: { nodes: [], links: [] };

const { html } =
	type === "note" && note
		? await renderGardenMarkdown(note.content, resolveLink)
		: { html: "" };
---

{
	type === "note" && note ? (
		<BaseLayout
			title={`${note.title} | Garden`}
			description="Living note pulled from the Obsidian vault."
			showHero={false}
			activePage={MAIN_PAGES.garden.label}
			bodyClass="post-page garden-entry-page"
		>
			<div class="post-shell">
				<article class="garden-entry">
					<header class="garden-entry__header">
						<p class="garden-entry__eyebrow">
							Updated{" "}
							<DateStamp
								datetime={note.updatedAt}
								label={formatDate(note.updatedAt)}
							/>
						</p>
						<h1 class="garden-entry__title">{note.title}</h1>
						<nav
							class="garden-entry__breadcrumbs"
							aria-label="Breadcrumb"
						>
							<a href="/garden/">Garden</a>
							{noteBreadcrumbs.map((crumb) => (
								<>
									<span aria-hidden="true">/</span>
									{crumb.href ? (
										<a href={crumb.href}>{crumb.label}</a>
									) : (
										<span>{crumb.label}</span>
									)}
								</>
							))}
						</nav>
					</header>

					<div class="garden-entry__content paper-body" set:html={html} />
					{backlinks.length ? (
						<section class="garden-entry__backlinks">
							<h2>Backlinks</h2>
							<ul>
								{backlinks.map((item) => (
									<li>
										<a href={`/garden/${item.slug}/`}>
											{item.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					) : null}
					{neighborNodes.length > 1 ? (
						<section class="garden-entry__neighbors">
							<ForceGraph
								nodes={neighborNodes}
								links={neighborEdges}
								height={240}
								labelKey="title"
							/>
						</section>
					) : null}
				</article>
			</div>
		</BaseLayout>
	) : (
		<GardenLayout
			pageTitle={`${folderSegments.slice(-1)[0] || "Folder"} | Garden`}
			description="Notes grouped by vault folder."
			eyebrow="Evergreen notes"
			heading={folderSegments.slice(-1)[0] || "Folder"}
			intro={`Notes in ${folderPath}`}
			notes={folderNoteCards}
			breadcrumbs={folderBreadcrumbs}
			graph={{
				nodes: graphNodeList,
				links: folderGraphLinks,
				labelKey: "title",
			}}
		/>
	)
}

