---
import GardenLayout from "../../layouts/GardenLayout.astro";
import { createGardenLinkResolver, loadGardenNotes } from "../../lib/garden";
import { buildFolderGraphData, plainExcerpt } from "../../lib/gardenPageUtils";
import { MAIN_PAGES } from "../../lib/site";

const notes = (await loadGardenNotes()).map((note) => ({
	...note,
	excerpt: plainExcerpt(note.content),
}));
const graph = buildFolderGraphData({
	folderNotes: notes,
	resolveLink: createGardenLinkResolver(notes),
});
---

<GardenLayout
  pageTitle={MAIN_PAGES.garden.pageTitle}
  description={MAIN_PAGES.garden.description}
  eyebrow={MAIN_PAGES.garden.eyebrow}
  heading={MAIN_PAGES.garden.label}
  intro={MAIN_PAGES.garden.description}
  notes={notes}
  graph={{ ...graph, labelKey: "title" }}
  emptyMessage="Set <code>OBSIDIAN_VAULT</code> to the root of an Obsidian vault (in .env or your shell) and run <code>npm run sync:obsidian</code> to publish Garden notes into <code>content/garden</code>."
/>
