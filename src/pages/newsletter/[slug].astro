---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import SubscribeBanner from "../../components/SubscribeBanner.astro";

export async function getStaticPaths() {
	const entries = await getCollection("newsletter", ({ data }) => !data.draft);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout
  frontmatter={entry.data}
  activePage="Newsletter"
  showHero={false}
  eyebrow={`Newsletter · Issue #${entry.data.issueNumber}`}
  showAbstract={false}
>
  <Content />
  <SubscribeBanner slot="after-body" invert />
</PostLayout>
