---
import { getCollection, getEntry, render } from "astro:content";
import NewsletterLayout from "../../layouts/NewsletterLayout.astro";
import { withSlugs } from "../../lib/content";

export const prerender = true;

export async function getStaticPaths() {
	const entries = withSlugs(
		await getCollection("newsletter", ({ data }) => !data.draft),
	);
	return entries.map((entry) => ({
		params: { slug: entry.slug },
	}));
}

const slug = Astro.params.slug;
if (!slug) {
	throw new Error("Missing newsletter slug");
}

const entry = await getEntry("newsletter", slug);
if (!entry) {
	return Astro.redirect("/404");
}

const { Content } = await render(entry);
const frontmatter = entry.data;
---

<NewsletterLayout frontmatter={frontmatter} slug={slug} activePage="Newsletter">
  <Content />
</NewsletterLayout>
