---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Banner from "../../components/Banner.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { getCollection } from "astro:content";
import { withSlugs } from "../../lib/content";
import { MAIN_PAGES } from "../../lib/site";

const newsletters = withSlugs(
	await getCollection("newsletter", ({ data }) => !data.draft),
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={MAIN_PAGES.newsletter.pageTitle}
  description={MAIN_PAGES.newsletter.description}
  hero={MAIN_PAGES.newsletter.label}
  showHero={false}
  activePage={MAIN_PAGES.newsletter.label}
  bodyClass="brutalist newsletter-page"
>
  <div class="page-hero">
    <div class="page-hero__banner">
      <Banner
        text="NEWSLETTER"
        textNarrow={"NEWSL\nETTER"}
        height={140}
        srLabel={MAIN_PAGES.newsletter.label}
      />
      <span class="page-hero__eyebrow">{MAIN_PAGES.newsletter.eyebrow}</span>
    </div>
  </div>

  <div class="newsletter-grid">
    <section class="newsletter-grid__issues" aria-labelledby="newsletter-archive-label">
      <h2 id="newsletter-archive-label" class="newsletter-section__label">Back Issues</h2>
      <p class="newsletter-issues__intro">{MAIN_PAGES.newsletter.description}</p>
      <div class="newsletter-archive__list">
        {
          newsletters.length ? (
            newsletters.map((entry) => (
              <ArchiveEntry
                title={`Issue ${entry.data.issueNumber}: ${entry.data.title}`}
                url={`/newsletter/${entry.slug}/`}
                date={entry.data.pubDate}
                description={entry.data.description}
                tags={entry.data.tags}
              />
            ))
          ) : (
            <p class="newsletter-archive__empty">
              No newsletters yet. Subscribe to get the first issue.
            </p>
          )
        }
      </div>
    </section>

    <aside class="newsletter-grid__subscribe" aria-labelledby="newsletter-subscribe-label">
      <h2 id="newsletter-subscribe-label" class="newsletter-section__label newsletter-section__label--invert">Subscribe</h2>
      <p class="newsletter-subscribe__intro">
        Occasional dispatches from the margins &mdash; new essays, notes, and
        whatever else is drying on the page.
      </p>
      <SubscribeForm variant="compact" redirectUrl="/subscribe/confirmed" invert />
    </aside>
  </div>
</BaseLayout>

<style is:global>
  /*
   * Newsletter-specific styles. The brutalist frame, hero, and footer chrome
   * come from brutalist-page.css (body.brutalist); this block adds the
   * vertical flex layout and the two-cell issues/subscribe grid.
   */

  /* Vertical flex column so the grid fills the viewport and the footer pins to
     the bottom; the rest of the frame comes from brutalist-page.css. */
  body.newsletter-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body.newsletter-page .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ---- INTRO INSIDE ISSUES CELL ---- */
  body.newsletter-page .newsletter-issues__intro {
    margin: 0 0 18px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ---- THREE-COLUMN GRID (mirrors homepage .grid: 2/3 issues, 1/3 subscribe) ---- */
  /* flex: 1 + a defined row track lets the grid fill the viewport down to the footer. */
  body.newsletter-page .newsletter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr;
    flex: 1;
  }

  body.newsletter-page .newsletter-grid > * {
    padding: 18px;
  }

  body.newsletter-page .newsletter-grid__issues {
    grid-column: span 2;
    border-right: 4px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  body.newsletter-page .newsletter-grid__subscribe {
    grid-column: span 1;
    background: var(--ink);
    color: var(--paper);
  }

  /* ---- SECTION LABEL (matches home.css .block > h2) ---- */
  body.newsletter-page .newsletter-section__label {
    display: inline-block;
    margin: 0 0 14px;
    padding: 2px 8px;
    font-family: var(--display);
    font-size: var(--fs-sm);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
  }

  /* Inverted variant on dark cell (mirrors home.css .tall h2). */
  body.newsletter-page .newsletter-section__label--invert {
    color: var(--ink);
    background: var(--paper);
  }

  /* ---- ARCHIVE LIST ---- */
  body.newsletter-page .newsletter-archive__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    width: 100%;
  }

  body.newsletter-page .newsletter-archive__empty {
    margin: 0;
    padding: 16px;
    border: 3px solid var(--ink);
    background: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--ink);
  }

  /* Archive-entry brutalist styles live in ArchiveEntry.astro (is:global). */

  /* ---- DARK SUBSCRIBE CELL (mirrors home.css .tall) ---- */
  body.newsletter-page .newsletter-grid__subscribe a {
    color: var(--paper);
  }

  body.newsletter-page .newsletter-subscribe__intro {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--paper);
  }

  body.newsletter-page .newsletter-grid__subscribe .subscribe-form {
    display: block;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--paper);
  }

  /* Hide the form's own h2 — section label already announces the cell. */
  body.newsletter-page .newsletter-grid__subscribe .subscribe-form h2 {
    display: none;
  }

  body.newsletter-page .newsletter-grid__subscribe .subscribe-form__field {
    display: block;
    margin: 0 0 12px;
  }

  body.newsletter-page .newsletter-grid__subscribe .subscribe-form label {
    display: block;
    margin: 0 0 4px;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
  }

  body.newsletter-page
    .newsletter-grid__subscribe
    .subscribe-form
    input[type="email"],
  body.newsletter-page
    .newsletter-grid__subscribe
    .subscribe-form
    input[type="text"] {
    width: 100%;
    padding: 8px;
    font-family: var(--mono);
    font-size: var(--fs-base);
    background: var(--paper);
    color: var(--ink);
    border: 3px solid var(--paper);
    border-radius: 0;
    box-shadow: none;
  }

  body.newsletter-page .newsletter-grid__subscribe .subscribe-form input:focus {
    outline: 3px solid var(--paper-accent);
    outline-offset: 0;
    border-color: var(--paper);
    box-shadow: none;
  }

  /* Subscribe button uses the shared .btn / .btn--invert from buttons.css —
     no per-page overrides. */

  body.newsletter-page .newsletter-grid__subscribe .subscribe-form__note {
    margin: 12px 0 0;
    font-family: var(--mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 0.75);
  }

  /* ---- MOBILE ---- */
  @media (max-width: 720px) {
    body.newsletter-page .newsletter-grid {
      grid-template-columns: 1fr;
    }
    body.newsletter-page .newsletter-grid__issues {
      grid-column: span 1;
      border-right: none;
    }
    body.newsletter-page .newsletter-grid__subscribe {
      grid-column: span 1;
    }
    body.newsletter-page .newsletter-grid > * {
      padding: 14px;
    }
  }
</style>
