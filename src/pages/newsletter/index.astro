---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { getCollection } from "astro:content";
import { withSlugs } from "../../lib/content";
import { MAIN_PAGES } from "../../lib/site";

const newsletters = withSlugs(
	await getCollection("newsletter", ({ data }) => !data.draft),
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={MAIN_PAGES.newsletter.pageTitle}
  description={MAIN_PAGES.newsletter.label}
  hero={MAIN_PAGES.newsletter.label}
  showHero={false}
  activePage={MAIN_PAGES.newsletter.label}
>
  <PageIntro
    eyebrow={MAIN_PAGES.newsletter.eyebrow}
    title={MAIN_PAGES.newsletter.label}
    description={MAIN_PAGES.newsletter.description}
  />
  <section class="newsletter-archive">
    <div class="newsletter-archive__list">
      {
        newsletters.length ? (
          newsletters.map((entry) => (
            <ArchiveEntry
              title={`Issue ${entry.data.issueNumber}: ${entry.data.title}`}
              url={`/newsletter/${entry.slug}/`}
              date={entry.data.pubDate}
              description={entry.data.description}
              tags={entry.data.tags}
            />
          ))
        ) : (
          <p class="newsletter-archive__empty">
            No newsletters yet. Subscribe to get the first issue.
          </p>
        )
      }
    </div>
    <div class="newsletter-archive__subscribe">
      <SubscribeForm variant="compact" redirectUrl="/subscribe/confirmed" />
    </div>
  </section>
</BaseLayout>

<style>
  .newsletter-archive {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .newsletter-archive__subscribe h2 {
    margin: 0 0 1rem;
  }

  .newsletter-archive__list {
    display: grid;
    gap: 1rem;
  }

  .newsletter-archive__empty {
    color: rgba(15, 23, 42, 0.7);
  }
</style>
