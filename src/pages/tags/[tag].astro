---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Map();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      const key = tag.toLowerCase();
      const existing = tags.get(key) ?? { label: tag, posts: [] };
      existing.posts.push(post);
      existing.label = tag;
      tags.set(key, existing);
    });
  });
  return Array.from(tags.entries()).map(([slug, value]) => ({
    params: { tag: slug },
    props: { tag: value.label, slug, posts: value.posts }
  }));
}

const { tag, posts } = Astro.props;
const formatDate = (date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---
<BaseLayout title={`${tag} — Notebook`} description={`Entries tagged ${tag}`} hero={`#${tag}`}>
  {posts.length === 0 ? (
    <p>No entries yet.</p>
  ) : (
    posts
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .map((post) => (
        <article style="margin-bottom: 3rem;">
          <p style="margin: 0; color: #64748b;">{formatDate(post.data.pubDate)}</p>
          <h2 style="margin: 0.35rem 0 0.5rem;">
            <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <TagList tags={post.data.tags} />
        </article>
      ))
  )}
</BaseLayout>
