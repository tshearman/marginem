---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Map();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      const key = tag.toLowerCase();
      const existing = tags.get(key) ?? { label: tag, posts: [] };
      existing.posts.push(post);
      existing.label = tag;
      tags.set(key, existing);
    });
  });
  return Array.from(tags.entries()).map(([slug, value]) => ({
    params: { tag: slug },
    props: { tag: value.label, slug, posts: value.posts }
  }));
}

const { tag, posts } = Astro.props;
const formatDate = (date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---
<BaseLayout title={`${tag} — Notebook`} description={`Entries tagged ${tag}`} hero={`#${tag}`}>
  {posts.length === 0 ? (
    <p>No entries yet.</p>
  ) : (
    posts
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .map((post) => (
        <PostPreview
          id={post.slug}
          title={post.data.title}
          url={`/posts/${post.slug}/`}
          pubDate={post.data.pubDate?.toISOString?.() ?? ''}
          displayDate={formatDate(post.data.pubDate)}
          description={post.data.description ?? ''}
          abstract={post.data.abstract ?? post.data.description ?? ''}
          tags={post.data.tags}
        />
      ))
  )}
</BaseLayout>
