---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/PostPreview.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../lib/date";
import { MAIN_PAGES, SITE_NAME } from "../../lib/site";
import { slugifyTag } from "../../lib/tags";
import { withSlugs, type BlogEntry } from "../../lib/content";

export async function getStaticPaths() {
	const posts = withSlugs(
		await getCollection("blog", ({ data }) => !data.draft),
	);

	const tagsBySlug = posts.reduce((map, post) => {
		for (const tag of post.data.tags ?? []) {
			const slug = slugifyTag(tag);
			if (!slug) continue;
			const entry = map.get(slug) ?? { label: tag, posts: [] as BlogEntry[] };
			entry.posts.push(post as BlogEntry);
			entry.label = tag; // keep last-seen casing
			map.set(slug, entry);
		}
		return map;
	}, new Map<string, { label: string; posts: BlogEntry[] }>());

	return Array.from(tagsBySlug, ([slug, value]) => ({
		params: { tag: slug },
		props: { tag: value.label, slug, posts: value.posts },
	}));
}

export const prerender = true;

interface TagPageProps {
	tag: string;
	posts: BlogEntry[];
}

const { tag, posts = [] } = Astro.props as TagPageProps;
---
<BaseLayout
  title={`${tag} — ${SITE_NAME}`}
  description={`Entries tagged ${tag}`}
  hero={`#${tag}`}
  activePage={MAIN_PAGES.archive.label}
>
  {posts.length === 0 ? (
    <p>No entries yet.</p>
  ) : (
    posts
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .map((post) => (
        <PostPreview
          id={post.slug}
          title={post.data.title}
          url={`/posts/${post.slug}/`}
          pubDate={post.data.pubDate?.toISOString?.() ?? ''}
          displayDate={formatDate(post.data.pubDate)}
          description={post.data.description ?? ''}
          abstract={post.data.abstract ?? post.data.description ?? ''}
          tags={post.data.tags}
        />
      ))
  )}
</BaseLayout>
