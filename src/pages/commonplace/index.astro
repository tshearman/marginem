---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/NoteCard.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import PageIntro from "../../components/PageIntro.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import filterScript from "../../scripts/filterable-content.js?url";
import { getCollection } from "astro:content";
import { generateNoteId } from "../../lib/noteUtils";
import { MAIN_PAGES } from "../../lib/site";

const notesCollection = await getCollection("notes");
const allNotes: Array<{
  content: string;
  source?: string;
  author?: string;
  tags: string[];
  date?: Date;
}> = [];

for (const file of notesCollection) {
  allNotes.push(
    ...file.data.map((entry) => ({
      ...entry,
      tags: entry.tags ?? [],
      date: entry.date ? new Date(entry.date) : undefined,
    })),
  );
}

const sortedNotes = allNotes.sort((a, b) => {
  if (!a.date && !b.date) return 0;
  if (!a.date) return 1;
  if (!b.date) return -1;
  return b.date.getTime() - a.date.getTime();
});

const annotateColumnSpan = (contentLength: number) => {
  if (contentLength > 460) return 3;
  if (contentLength > 180) return 2;
  return 1;
};

const notesWithGrid = sortedNotes.map((note) => ({
  ...note,
  columnSpan: annotateColumnSpan(note.content.length),
  noteId: generateNoteId({
    content: note.content,
    author: note.author,
    tags: note.tags,
    date: note.date,
  }),
}));
const allTags = [
  ...new Set(sortedNotes.flatMap((note) => note.tags || [])),
].sort((a, b) => a.localeCompare(b));
const commonplaceFilterConfig = JSON.stringify({
  filterSelector: ".tag-filter-container .tag--filter",
  countId: "notesCount",
  hintId: "notesClearHint",
  itemSelector: ".note-section",
  itemTagSelector: ".note-card .tag--filter",
  stateKey: "commonplace-notes",
  countLabel: "notes",
});
---

<BaseLayout
  title={MAIN_PAGES.commonplace.pageTitle}
  description={MAIN_PAGES.commonplace.description}
  hero={MAIN_PAGES.commonplace.label}
  showHero={false}
  activePage={MAIN_PAGES.commonplace.label}
>
  <section
    class="commonplace-page"
    data-filter-config={commonplaceFilterConfig}
  >
    <PageIntro
      eyebrow={MAIN_PAGES.commonplace.eyebrow}
      title={MAIN_PAGES.commonplace.label}
      description={MAIN_PAGES.commonplace.description}
    />

    <div class="content-layout">
      <TagFilterPanel tags={allTags} />

      <FilterableCount
        contentType="notes"
        totalCount={sortedNotes.length}
        class="commonplace-count"
      />

      <div class="notes-masonry" id="notesMasonry">
        {
          notesWithGrid.map((note) => {
            const spanClass =
              note.columnSpan > 1 ? `span-${note.columnSpan}` : "";
            return (
              <section
                id={note.noteId}
                class={`note-section ${spanClass}`}
                aria-label="Commonplace note"
                data-tags={JSON.stringify(note.tags)}
              >
                <NoteCard
                  content={note.content}
                  source={note.source}
                  author={note.author}
                  date={note.date}
                  tags={note.tags}
                  idOverride={note.noteId}
                />
              </section>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-layout {
    padding: 0 1rem;
  }

  .tag-filter-container {
    width: 100%;
  }

  .commonplace-count {
    padding: 0 1rem;
  }

  .notes-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: 1rem;
    padding-top: 1rem;
    width: 100%;
    min-height: 60vh;
    contain: layout style paint;
    grid-template-rows: auto;
  }
  :global(.note-section.hidden) {
    display: none;
  }

  :global(.note-section.span-2) {
    grid-column: span 2 !important;
  }

  :global(.note-section.span-3) {
    grid-column: span 3 !important;
  }

  @media (max-width: 800px) {
    .content-layout {
      padding: 0;
    }

    .notes-masonry {
      grid-template-columns: 1fr;
    }

    :global(.note-section.span-2),
    :global(.note-section.span-3) {
      grid-column: span 1 !important;
    }

    .commonplace-count {
      padding: 0;
    }
  }
</style>

<script type="module" is:inline src={filterScript}></script>
