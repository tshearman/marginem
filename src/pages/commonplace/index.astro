---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/NoteCard.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import Banner from "../../components/Banner.astro";
import { generateNoteId } from "../../lib/noteUtils";
import { MAIN_PAGES } from "../../lib/site";
import { loadCommonplaceNotes } from "../../lib/commonplace";

export const prerender = true;

const allNotes: Array<{
	content: string;
	source?: string;
	author?: string;
	tags: string[];
	date?: Date;
}> = await loadCommonplaceNotes();

const sortedNotes = allNotes.sort((a, b) => {
	if (!a.date && !b.date) return 0;
	if (!a.date) return 1;
	if (!b.date) return -1;
	return b.date.getTime() - a.date.getTime();
});

const annotateColumnSpan = (contentLength: number) => {
	if (contentLength > 460) return 3;
	if (contentLength > 180) return 2;
	return 1;
};

const notesWithGrid = sortedNotes.map((note) => ({
	...note,
	columnSpan: annotateColumnSpan(note.content.length),
	noteId: generateNoteId({
		content: note.content,
		author: note.author,
		date: note.date,
	}),
}));
const allTags = [
	...new Set(sortedNotes.flatMap((note) => note.tags || [])),
].sort((a, b) => a.localeCompare(b));
const commonplaceFilterConfig = JSON.stringify({
	filterSelector: ".tag-filter-container .tag--filter",
	countId: "notesCount",
	hintId: "notesClearHint",
	itemSelector: ".note-section",
	itemTagSelector: ".note-card .tag--filter",
	stateKey: "commonplace-notes",
	countLabel: "notes",
});
---

<BaseLayout
  title={MAIN_PAGES.commonplace.pageTitle}
  description={MAIN_PAGES.commonplace.description}
  hero={MAIN_PAGES.commonplace.label}
  showHero={false}
  activePage={MAIN_PAGES.commonplace.label}
  bodyClass="brutalist commonplace-page"
>
  <div class="page-hero">
    <div class="page-hero__banner">
      <Banner
        text="COMMONPLACE"
        textNarrow={"COMMON\nPLACE"}
        height={140}
        srLabel={MAIN_PAGES.commonplace.label}
      />
      <span class="page-hero__eyebrow">{MAIN_PAGES.commonplace.eyebrow}</span>
    </div>
    <p class="page-hero__subtitle">{MAIN_PAGES.commonplace.description}</p>
  </div>
  <section
    class="commonplace-page page-shell"
    data-filter-config={commonplaceFilterConfig}
  >
    <TagFilterPanel tags={allTags} />

    <FilterableCount contentType="notes" totalCount={sortedNotes.length} />

    <div class="notes-masonry" id="notesMasonry">
      {
        notesWithGrid.map((note) => {
          const spanClass =
            note.columnSpan > 1 ? `span-${note.columnSpan}` : "";
          return (
            <section
              id={note.noteId}
              class={`note-section ${spanClass}`}
              aria-label="Commonplace note"
              data-tags={JSON.stringify(note.tags)}
            >
              <NoteCard
                content={note.content}
                source={note.source}
                author={note.author}
                date={note.date}
                tags={note.tags}
                idOverride={note.noteId}
              />
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>

<style is:global>
  /*
   * Commonplace-specific styles. The brutalist frame, hero, shell, tag panel,
   * and count strip come from brutalist-page.css (body.brutalist); this block
   * only adds the masonry grid and note-card treatment unique to this page.
   */

  /* ---- MASONRY GRID ---- */
  body.commonplace-page .notes-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    grid-auto-rows: min-content;
    align-items: start;
    gap: 14px;
    padding: 0;
    width: 100%;
    min-height: 60vh;
    contain: layout style paint;
  }

  body.commonplace-page .note-section.span-2 {
    grid-column: span 2 !important;
  }

  body.commonplace-page .note-section.span-3 {
    grid-column: span 3 !important;
  }

  body.commonplace-page .note-section.hidden {
    display: none;
  }

  /* ---- NOTE CARD ---- */
  body.commonplace-page .note-card {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    box-shadow: none;
    padding: 14px 14px 12px;
    margin: 0;
    display: flex;
    flex-direction: column;
    transition: background-color 0.12s ease;
  }

  body.commonplace-page .note-card:hover {
    background: rgb(var(--ink-rgb) / 0.03);
  }

  body.commonplace-page .note-card__anchor-link {
    position: absolute;
    top: 6px;
    right: 8px;
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--fs-sm);
    color: var(--ink);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  body.commonplace-page .note-card:hover .note-card__anchor-link,
  body.commonplace-page .note-card:focus-within .note-card__anchor-link {
    opacity: 1;
  }

  body.commonplace-page .note-content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  body.commonplace-page .note-content {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  body.commonplace-page .note-text {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    font-family: var(--mono);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--ink);
    font-style: normal;
  }

  /* Suppress the global blockquote ::before pseudo-bar inside note cards. */
  body.commonplace-page .note-text::before {
    content: none;
    display: none;
  }

  body.commonplace-page .note-attribution {
    margin: 0;
    text-align: left;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
  }

  body.commonplace-page .note-author {
    font-family: var(--display);
    font-weight: 900;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  body.commonplace-page .note-source {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  body.commonplace-page .note-source::before {
    content: "— ";
  }

  body.commonplace-page .note-date {
    display: inline-block;
    margin-left: auto;
    font-family: var(--mono);
    font-style: normal;
    font-size: var(--fs-3xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--ink-rgb) / 0.7);
  }

  body.commonplace-page .note-tags {
    margin: 0;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 6px;
  }

  /* ---- MOBILE ---- */
  @media (max-width: 800px) {
    body.commonplace-page .notes-masonry {
      grid-template-columns: 1fr;
    }
    body.commonplace-page .note-section.span-2,
    body.commonplace-page .note-section.span-3 {
      grid-column: span 1 !important;
    }
  }

</style>
