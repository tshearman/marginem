---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/NoteCard.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import TagFilterPanel from "../../components/TagFilterPanel.astro";
import Banner from "../../components/Banner.astro";
import { generateNoteId } from "../../lib/noteUtils";
import { MAIN_PAGES } from "../../lib/site";
import { loadCommonplaceNotes } from "../../lib/commonplace";
import "../../styles/commonplace.css";

export const prerender = true;

// const allNotes = await loadCommonplaceNotes();
const allNotes: Array<{
	content: string;
	source?: string;
	author?: string;
	tags: string[];
	date?: Date;
}> = await loadCommonplaceNotes();

const sortedNotes = allNotes.sort((a, b) => {
	if (!a.date && !b.date) return 0;
	if (!a.date) return 1;
	if (!b.date) return -1;
	return b.date.getTime() - a.date.getTime();
});

const annotateColumnSpan = (contentLength: number) => {
	if (contentLength > 460) return 3;
	if (contentLength > 180) return 2;
	return 1;
};

const notesWithGrid = sortedNotes.map((note) => ({
	...note,
	columnSpan: annotateColumnSpan(note.content.length),
	noteId: generateNoteId({
		content: note.content,
		author: note.author,
		tags: note.tags,
		date: note.date,
	}),
}));
const allTags = [
	...new Set(sortedNotes.flatMap((note) => note.tags || [])),
].sort((a, b) => a.localeCompare(b));
const commonplaceFilterConfig = JSON.stringify({
	filterSelector: ".tag-filter-container .tag--filter",
	countId: "notesCount",
	hintId: "notesClearHint",
	itemSelector: ".note-section",
	itemTagSelector: ".note-card .tag--filter",
	stateKey: "commonplace-notes",
	countLabel: "notes",
});
---

<BaseLayout
  title={MAIN_PAGES.commonplace.pageTitle}
  description={MAIN_PAGES.commonplace.description}
  hero={MAIN_PAGES.commonplace.label}
  showHero={false}
  activePage={MAIN_PAGES.commonplace.label}
  bodyClass="commonplace-page"
>
  <div class="commonplace-hero">
    <div class="commonplace-hero__banner">
      <Banner
        text="COMMONPLACE"
        textNarrow={"COMMON\nPLACE"}
        height={140}
        srLabel={MAIN_PAGES.commonplace.label}
      />
      <span class="commonplace-hero__eyebrow">{MAIN_PAGES.commonplace.eyebrow}</span>
    </div>
    <p class="commonplace-hero__subtitle">{MAIN_PAGES.commonplace.description}</p>
  </div>
  <section
    class="commonplace-page"
    data-filter-config={commonplaceFilterConfig}
  >
    <TagFilterPanel tags={allTags} />

    <FilterableCount
      contentType="notes"
      totalCount={sortedNotes.length}
      class="commonplace-count"
    />

    <div class="notes-masonry" id="notesMasonry">
      {
        notesWithGrid.map((note) => {
          const spanClass =
            note.columnSpan > 1 ? `span-${note.columnSpan}` : "";
          return (
            <section
              id={note.noteId}
              class={`note-section ${spanClass}`}
              aria-label="Commonplace note"
              data-tags={JSON.stringify(note.tags)}
            >
              <NoteCard
                content={note.content}
                source={note.source}
                author={note.author}
                date={note.date}
                tags={note.tags}
                idOverride={note.noteId}
              />
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  import "../../scripts/filterable-content.js";
</script>
