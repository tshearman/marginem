---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/NoteCard.astro";
import Tag from "../../components/Tag.astro";
import FilterableCount from "../../components/FilterableCount.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getCollection } from "astro:content";

const notesCollection = await getCollection("notes");
const allNotes: Array<{
  content: string;
  source?: string;
  author?: string;
  tags: string[];
  date?: Date;
}> = [];

notesCollection.forEach((file) => {
  allNotes.push(
    ...file.data.map((entry) => ({
      ...entry,
      tags: entry.tags ?? [],
      date: entry.date ? new Date(entry.date) : undefined,
    })),
  );
});

const sortedNotes = allNotes.sort((a, b) => {
  if (!a.date && !b.date) return 0;
  if (!a.date) return 1;
  if (!b.date) return -1;
  return b.date.getTime() - a.date.getTime();
});

const createGridFillingLayout = (notes: typeof sortedNotes) => {
  const withSpans = notes.map((note) => {
    const contentLength = note.content.length;
    let columnSpan = 1;

    if (contentLength > 400) {
      columnSpan = 3;
    } else if (contentLength > 200) {
      columnSpan = 2;
    } else if (contentLength > 100 && Math.random() < 0.15) {
      columnSpan = 2;
    }

    return { ...note, columnSpan };
  });

  const shuffled = [...withSpans];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }

  return { notes: shuffled };
};

const { notes: notesWithGrid } = createGridFillingLayout(sortedNotes);
const allTags = [
  ...new Set(sortedNotes.flatMap((note) => note.tags || [])),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="Commonplace | Notebook"
  description="Collected passages, marginalia, and fragments."
  hero="Commonplace"
  showHero={false}
>
  <section class="commonplace-page">
    <PageIntro
      eyebrow="Notebook Series"
      title="Commonplace"
      description="Collected passages, marginalia, and fragments to revisit when the well runs dry."
    />

    <div class="content-layout">
      <div class="tag-filter-container">
        <div class="tag-filter-section">
          <h3>Filter by tags:</h3>
          <div class="tag-list" id="tagList">
            {
              allTags.map((tag) => (
                <Tag tag={tag} variant="filter" size="medium" />
              ))
            }
          </div>
        </div>
      </div>

      <FilterableCount
        contentType="notes"
        totalCount={sortedNotes.length}
        class="commonplace-count"
      />

      <div class="notes-masonry" id="notesMasonry">
        {
          notesWithGrid.map((note) => {
            const spanClass =
              note.columnSpan > 1 ? `span-${note.columnSpan}` : "";
            return (
              <NoteCard
                content={note.content}
                source={note.source}
                author={note.author}
                date={note.date}
                tags={note.tags}
                class={spanClass}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-layout {
    padding: 0 1rem;
  }

  .tag-filter-container {
    width: 100%;
  }

  .tag-filter-section {
    margin: 0 0 1.5rem;
    padding: 1.25rem;
    border-radius: 1rem;
    text-align: center;
  }

  .tag-filter-section h3 {
    margin: 0 0 0.65rem;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(15, 23, 42, 0.8);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }

  .commonplace-count {
    padding: 0 1rem;
  }

  .notes-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: 1rem;
    padding-top: 1rem;
    width: 100%;
    min-height: 60vh;
    contain: layout style paint;
    grid-template-rows: auto;
  }

  :global(.note-card.span-2) {
    grid-column: span 2 !important;
  }

  :global(.note-card.span-3) {
    grid-column: span 3 !important;
  }

  @media (max-width: 760px) {
    .content-layout {
      padding: 0;
    }

    .tag-filter-section {
      padding: 1rem;
    }

    .notes-masonry {
      grid-template-columns: 1fr;
    }

    :global(.note-card.span-2),
    :global(.note-card.span-3) {
      grid-column: span 1 !important;
    }

    .commonplace-count {
      padding: 0;
    }
  }

  @media (min-width: 761px) and (max-width: 1200px) {
    .notes-masonry {
      grid-template-columns: repeat(2, 1fr);
    }

    :global(.note-card.span-3) {
      grid-column: span 2 !important;
    }
  }
</style>

<script>
  (() => {
    const pageFilterStates = new Map();
    let cleanupHandlers = [];

    const getPageKey = () => window.location.pathname;
    const getSelectedTags = () => {
      const key = getPageKey();
      if (!pageFilterStates.has(key)) {
        pageFilterStates.set(key, new Set());
      }
      return pageFilterStates.get(key);
    };

    const syncTagButtonStates = (buttons, noteTagButtons) => {
      const selected = getSelectedTags();
      [...buttons, ...noteTagButtons].forEach((button) => {
        const tag = button.dataset.tag;
        if (!tag) return;
        button.dataset.selected = selected.has(tag) ? "true" : "false";
      });
    };

    const updateCounts = (visible, total, hasFilters) => {
      const countEl = document.getElementById("notesCount");
      const hintEl = document.getElementById("notesClearHint");
      if (countEl) {
        countEl.textContent = hasFilters
          ? `Showing ${visible} of ${total} notes`
          : `Showing all ${total} notes`;
      }
      if (hintEl) {
        hintEl.hidden = !hasFilters;
      }
    };

    const filterNotes = (noteCards, tagButtons, noteTagButtons) => {
      const selected = getSelectedTags();
      const total = noteCards.length;
      let visible = 0;

      noteCards.forEach((card) => {
        const tags = JSON.parse(card.dataset.tags || "[]");
        const shouldShow =
          selected.size === 0 || tags.some((tag) => selected.has(tag));
        if (shouldShow) {
          card.classList.remove("hidden");
          visible += 1;
        } else {
          card.classList.add("hidden");
        }
      });

      syncTagButtonStates(tagButtons, noteTagButtons);
      updateCounts(visible, total, selected.size > 0);
    };

    const clearHandlers = () => {
      cleanupHandlers.forEach((cleanup) => cleanup());
      cleanupHandlers = [];
    };

    const attachHandler = (element, event, handler) => {
      element.addEventListener(event, handler);
      cleanupHandlers.push(() => element.removeEventListener(event, handler));
    };

    const initializeFiltering = () => {
      const tagButtons = document.querySelectorAll(".tag.tag--filter");
      const noteTagButtons = document.querySelectorAll(".tag.tag--display");
      const noteCards = document.querySelectorAll(".note-card");

      if (!noteCards.length) return;

      clearHandlers();

      const handleClick = (tag) => (event) => {
        event.preventDefault();
        const selected = getSelectedTags();
        if (selected.has(tag)) {
          selected.delete(tag);
        } else {
          selected.add(tag);
        }
        filterNotes(noteCards, tagButtons, noteTagButtons);
      };

      const handleClear = (event) => {
        event.preventDefault();
        const selected = getSelectedTags();
        selected.clear();
        filterNotes(noteCards, tagButtons, noteTagButtons);
      };

      tagButtons.forEach((button) => {
        const tag = button.dataset.tag;
        if (!tag) return;
        attachHandler(button, "click", handleClick(tag));
        attachHandler(button, "contextmenu", handleClear);
      });

      noteTagButtons.forEach((button) => {
        const tag = button.dataset.tag;
        if (!tag) return;
        attachHandler(button, "click", handleClick(tag));
        attachHandler(button, "contextmenu", handleClear);
      });

      filterNotes(noteCards, tagButtons, noteTagButtons);
    };

    document.addEventListener("DOMContentLoaded", initializeFiltering);
    document.addEventListener("astro:page-load", initializeFiltering);
  })();
</script>
