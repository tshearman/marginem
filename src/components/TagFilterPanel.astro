---
import Tag from "./Tag.astro";

interface Props {
	title?: string;
	tags?: string[];
	categoryTitle?: string;
	categories?: Array<string | { label: string; value: string }>;
}

const {
	title = "Filter by tags:",
	tags = [],
	categoryTitle = "Filter by category:",
	categories = [],
} = Astro.props as Props;

const normalizedCategories = categories
	.map((category) =>
		typeof category === "string"
			? { label: category, value: category }
			: category,
	)
	.filter(
		(category) =>
			typeof category?.label === "string" &&
			typeof category?.value === "string",
	);
---

<div class="tag-filter-container">
  <div class="tag-filter-section">
    <h3>{title}</h3>
    <div class="tag-list">
      {tags.map((tag) => <Tag tag={tag} variant="filter" size="medium" />)}
    </div>
  </div>
</div>
{
  normalizedCategories.length ? (
    <div class="category-filter-container">
      <div class="tag-filter-section">
        <h3>{categoryTitle}</h3>
        <div class="tag-list">
          {normalizedCategories.map((category) => (
            <button
              class="tag tag--filter"
              type="button"
              data-category={category.value}
              data-selected="false"
              aria-pressed="false"
            >
              {category.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  ) : null
}

<!-- The filter panel is only rendered on brutalist pages; its frame, label
     stamp, and chip layout come from brutalist-page.css (body.brutalist). -->

