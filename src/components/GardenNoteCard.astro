---
import { GardenNoteCard as PreactGardenNoteCard } from "./preact/GardenNoteCard";
import { formatDate } from "../lib/date";

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	updatedAt: Date;
	relativePath: string;
	vaultRoot?: string;
}

const { slug, title, excerpt, updatedAt } = Astro.props as Props;
---

<PreactGardenNoteCard
  variant="card"
  href={`/garden/${slug}/`}
  title={title}
  excerpt={excerpt}
  updatedAt={updatedAt}
  dateLabel={formatDate(updatedAt)}
/>

<style>
  :global(.garden-card) {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 0px solid rgb(var(--ink-rgb) / 0.08);
    text-decoration: none;
    color: inherit;
    text-align: left;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.garden-card:hover),
  :global(.garden-card:focus-visible) {
    text-decoration: none;
  }

  :global(.garden-card:hover h3),
  :global(.garden-card:focus-visible h3) {
    text-decoration: underline;
  }

  :global(.garden-card__row) {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.65rem;
  }

  :global(.garden-card h3) {
    margin: 0;
    font-size: var(--fs-md);
    color: rgb(var(--ink-rgb) / 0.95);
    font-weight: 600;
  }

  :global(.garden-card__date) {
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  :global(.garden-card__excerpt) {
    margin: 0.2rem 0 0;
    color: rgb(var(--ink-rgb) / 0.85);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
