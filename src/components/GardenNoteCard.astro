---
import { renderGardenNoteCard } from "../lib/card-html";
import { formatDate } from "../lib/date";

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	updatedAt: Date;
	relativePath: string;
	vaultRoot?: string;
}

const { slug, title, excerpt, updatedAt } = Astro.props as Props;
const html = renderGardenNoteCard({
	variant: "card",
	href: `/garden/${slug}/`,
	title,
	excerpt,
	updatedAt,
	dateLabel: formatDate(updatedAt),
});
---

<Fragment set:html={html} />
