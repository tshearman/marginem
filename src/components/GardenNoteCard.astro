---
import DateStamp from "./DateStamp.astro";
import { formatDate } from "../lib/date";

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	updatedAt: Date;
	relativePath: string;
	vaultRoot?: string;
}

const { slug, title, excerpt, updatedAt, relativePath, vaultRoot } =
	Astro.props as Props;
---

<a class="garden-card" href={`/garden/${slug}/`}>
  <div class="garden-card__row">
    <DateStamp
      datetime={updatedAt}
      class="garden-card__date"
      label={formatDate(updatedAt)}
    />
    <h3>{title}</h3>
  </div>
  <p class="garden-card__excerpt">{excerpt}</p>
</a>

<style>
  .garden-card {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 0px solid rgba(15, 23, 42, 0.08);
    text-decoration: none;
    color: inherit;
    text-align: left;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .garden-card__row {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.65rem;
  }

  .garden-card h3 {
    margin: 0;
    font-size: 1.05rem;
    color: rgba(15, 23, 42, 0.95);
    font-weight: 600;
  }

  .garden-card__date {
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .garden-card__excerpt {
    margin: 0.2rem 0 0;
    color: rgba(15, 23, 42, 0.85);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
