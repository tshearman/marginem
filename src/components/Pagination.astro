---
const { currentPage = 1, totalPages = 1 } = Astro.props;
const prevHref = currentPage > 1 ? (currentPage === 2 ? '/' : `/page/${currentPage - 1}/`) : null;
const nextHref = currentPage < totalPages ? `/page/${currentPage + 1}/` : null;
---
{totalPages > 1 ? (
  <nav class="paginator" aria-label="Pagination">
    {prevHref ? <a href={prevHref}>← Newer posts</a> : <span />}
    <span>
      Page {currentPage} of {totalPages}
    </span>
    {nextHref ? <a href={nextHref}>Older posts →</a> : <span />}
  </nav>
) : null}

<style>
  .paginator {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
