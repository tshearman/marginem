---
const { currentPage = 1, totalPages = 1 } = Astro.props;
const prevHref =
	currentPage > 1
		? currentPage === 2
			? "/"
			: `/page/${currentPage - 1}/`
		: null;
const nextHref = currentPage < totalPages ? `/page/${currentPage + 1}/` : null;
---
{totalPages > 1 ? (
  <nav class="paginator" aria-label="Pagination">
    {prevHref ? (
      <a class="paginator__link paginator__link--prev" href={prevHref}>
        ← Newer posts
      </a>
    ) : (
      <span class="paginator__spacer paginator__spacer--prev" aria-hidden="true"></span>
    )}
    <span class="paginator__status">
      Page {currentPage} of {totalPages}
    </span>
    {nextHref ? (
      <a class="paginator__link paginator__link--next" href={nextHref}>
        Older posts →
      </a>
    ) : (
      <span class="paginator__spacer paginator__spacer--next" aria-hidden="true"></span>
    )}
  </nav>
) : null}

<style>
  .paginator {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    gap: 1rem;
  }

  .paginator__link {
    font-size: 0.95rem;
  }

  .paginator__link--prev,
  .paginator__spacer--prev {
    justify-self: flex-start;
    text-align: left;
  }

  .paginator__link--next,
  .paginator__spacer--next {
    justify-self: flex-end;
    text-align: right;
  }

  .paginator__spacer {
    visibility: hidden;
  }

  .paginator__status {
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
</style>
