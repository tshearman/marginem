---
import TagList from "./TagList.astro";
import PostPreview from "./PostPreview.astro";

const { posts = [], formatDate } = Astro.props;
const format = formatDate
  ? (date) => formatDate(date)
  : (date) =>
      new Intl.DateTimeFormat("en", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(date);

const hasPosts = posts.length > 0;
const hybridHero = posts[0];
const hybridListPosts = posts.slice(1, posts.length);
const featuredPosts = posts.filter((post) => post?.data?.featured);
const marqueeSource = featuredPosts.length ? featuredPosts : posts;
const marqueeCopies = 6;
const hybridMarqueePosts = Array.from({ length: marqueeCopies }, () =>
  marqueeSource.slice(0, 6),
).flat();
const heroImage = (post) => post?.data?.heroImage ?? null;
const heroStyle = (post, overlay = "rgba(0,0,0,0.35)") => {
  const src = heroImage(post);
  if (!src) return null;
  return `linear-gradient(135deg, ${overlay}, rgba(0,0,0,0.2)), url(${src})`;
};
const getUrl = (post) => `/posts/${post.slug}/`;
const getExcerpt = (post) => post.data.description ?? "";
---

{
  !hasPosts ? (
    <p>No posts yet. Check back soon.</p>
  ) : (
    hybridHero && (
      <section class="home-layout home-layout--stack">
        <article
          class="stack-hero"
          style={`background-image: ${
            heroStyle(hybridHero, "rgba(17,24,39,0.65)") ??
            "linear-gradient(135deg, rgba(17,24,39,0.8), rgba(15,118,110,0.6))"
          };`}
        >
          <div class="stack-hero__body">
            <p>{format(hybridHero.data.pubDate)}</p>
            <h2>
              <a href={getUrl(hybridHero)}>{hybridHero.data.title}</a>
            </h2>
            <p>{getExcerpt(hybridHero)}</p>
            <TagList tags={hybridHero.data.tags} />
          </div>
        </article>
        <div class="stack-post-previews">
          {hybridListPosts.map((post) => (
            <PostPreview
              id={post.slug}
              title={post.data.title}
              url={getUrl(post)}
              pubDate={post.data.pubDate?.toISOString?.() ?? ""}
              displayDate={format(post.data.pubDate)}
              description={getExcerpt(post)}
              tags={post.data.tags}
            />
          ))}
        </div>
        <div class="stack-marquee">
          {[0, 1].map((copy) => (
            <div class="stack-marquee__track" aria-hidden={copy > 0}>
              {hybridMarqueePosts.map((post, index) => (
                <article
                  class={`stack-mini-panel stack-mini-panel--${index % 3}`}
                  style={`background-image: ${
                    heroStyle(post, "rgba(15,15,15,0.6)") ??
                    "linear-gradient(135deg, rgba(15,15,15,0.7), rgba(15,118,110,0.5))"
                  };`}
                >
                  <div class="stack-mini-panel__body">
                    <span class="stack-mini-panel__index">{index + 1}</span>
                    <p>{format(post.data.pubDate)}</p>
                    <h3>
                      <a href={getUrl(post)}>{post.data.title}</a>
                    </h3>
                    <p>{getExcerpt(post)}</p>
                    <TagList tags={post.data.tags} />
                  </div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </section>
    )
  )
}
