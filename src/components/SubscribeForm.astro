---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Get the next post",
	description = "Occasional updates when new essays or notes ship. No spam.",
} = Astro.props as Props;
---

<section class="subscribe">
  <div class="subscribe__header">
    <p class="subscribe__eyebrow">Newsletter</p>
    <h2>{title}</h2>
    <p class="subscribe__description">{description}</p>
  </div>
  <form class="subscribe__form" data-subscribe-form novalidate>
    <label class="sr-only" for="subscribe-email">Email address</label>
    <input
      id="subscribe-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder="you@example.com"
      class="subscribe__input"
    />
    <input
      type="text"
      name="nickname"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="subscribe__honeypot"
    />
    <button type="submit" class="subscribe__button">Subscribe</button>
    <p class="subscribe__status" data-subscribe-status role="status"></p>
  </form>
</section>

<script>
  const form = document.querySelector("[data-subscribe-form]");
  if (form) {
    const statusEl = form.querySelector("[data-subscribe-status]");
    const emailInput = form.querySelector("#subscribe-email");
    const honeypot = form.querySelector(".subscribe__honeypot");
    const button = form.querySelector(".subscribe__button");

    const setStatus = (message, kind = "info") => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.dataset.state = kind;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!emailInput || !button) return;

      const email = emailInput.value.trim();
      if (!email) {
        setStatus("Add your email first.", "error");
        emailInput.focus();
        return;
      }

      button.disabled = true;
      setStatus("One sec…", "info");

      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            nickname: honeypot?.value ?? "",
          }),
        });

        if (response.status === 204) {
          setStatus("Thanks! You're all set.", "success");
          emailInput.value = "";
          return;
        }

        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(errorText || "Unable to subscribe right now.");
        }

        const payload = await response.json();
        if (payload.status === "already_confirmed") {
          setStatus(
            "You're already subscribed. Thanks for reading!",
            "success",
          );
        } else {
          setStatus("Check your email for a confirmation link.", "success");
        }
        emailInput.value = "";
      } catch (error) {
        console.error(error);
        setStatus("Couldn't add that email.", "error");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .subscribe {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 2.5rem 0 1rem;
    background: linear-gradient(145deg, #f5f3ef, #ffffff);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
  }

  .subscribe__eyebrow {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #6a6a6a;
  }

  .subscribe__header h2 {
    margin: 0.2rem 0 0.35rem;
    font-size: 1.45rem;
  }

  .subscribe__description {
    margin: 0 0 1rem;
    color: #4b5563;
  }

  .subscribe__form {
    display: grid;
    grid-template-columns: 2fr auto;
    gap: 0.75rem;
    align-items: center;
  }

  .subscribe__input {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    font-size: 1rem;
    font-family: inherit;
  }

  .subscribe__input:focus-visible {
    outline: 2px solid rgba(0, 0, 0, 0.65);
    outline-offset: 2px;
  }

  .subscribe__button {
    padding: 0.8rem 1.35rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(0, 0, 0, 0.25);
    background: #1b1b1d;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition:
      transform 0.1s ease,
      box-shadow 0.2s ease,
      opacity 0.2s ease;
  }

  .subscribe__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .subscribe__button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .subscribe__status {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.95rem;
    color: #333;
    min-height: 1.25rem;
  }

  .subscribe__status[data-state="success"] {
    color: #14532d;
  }

  .subscribe__status[data-state="error"] {
    color: #b91c1c;
  }

  .subscribe__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .subscribe__form {
      grid-template-columns: 1fr;
    }
  }
</style>
