---
interface Props {
  action?: string;
  method?: "get" | "post";
  idBase?: string;
  variant?: "default" | "compact";
  redirectUrl?: string;
}

const {
  action = "/api/subscribe",
  method = "post",
  idBase = "subscribe",
} = Astro.props as Props;

const emailId = `${idBase}-email`;
const nameId = `${idBase}-name`;
---

<form class="subscribe-form" action={action} method={method}>
  <div class="subscribe-form__field">
    <label for={emailId}>Email</label>
    <input
      id={emailId}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      placeholder="you@example.com"
    />
  </div>
  <div class="subscribe-form__field">
    <label for={nameId}>What should I call you?</label>
    <input
      id={nameId}
      name="name"
      type="text"
      autocomplete="name"
      placeholder="Optional"
    />
  </div>
  <button type="submit">Subscribe</button>
  <p class="subscribe-form__note">
    Occasional updates, no spam. Unsubscribe anytime.
  </p>
</form>

<style>
  .subscribe-form {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: #fff;
    /* box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08); */
  }

  .subscribe-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .subscribe-form label {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .subscribe-form input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    font-size: 1rem;
    font-family: inherit;
    color: var(--fg);
    background: #fafafa;
    transition:
      border-color 0.2s ease,
      /* box-shadow 0.2s ease, */ background 0.2s ease;
  }

  .subscribe-form input:focus {
    outline: none;
    border-color: rgba(15, 23, 42, 0.6);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 760px) {
    .subscribe-form input {
      font-size: 16px;
    }
  }

  .subscribe-form button {
    justify-self: center;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.35);
    background: var(--fg);
    color: #fff;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background 0.2s ease;
  }

  .subscribe-form button:focus-visible {
    outline: 2px solid rgba(15, 23, 42, 0.6);
    outline-offset: 3px;
  }

  .subscribe-form__note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
