---
interface Props {
	action?: string;
	method?: "get" | "post";
	idBase?: string;
	variant?: "default" | "compact";
	redirectUrl?: string;
	invert?: boolean;
}

const {
	action = "/api/subscribe",
	method = "post",
	idBase = "subscribe",
	invert = false,
} = Astro.props as Props;

const emailId = `${idBase}-email`;
const nameId = `${idBase}-name`;
const buttonClass = ["btn", invert ? "btn--invert" : null]
	.filter(Boolean)
	.join(" ");
---

<div class={invert ? "subscribe-form-wrap subscribe-form-wrap--invert" : "subscribe-form-wrap"}>
  <form class="subscribe-form" action={action} method={method}>
    <h2 class="subscribe-form__heading">Subscribe for notifications on new posts!</h2>
    <div class="subscribe-form__field">
      <label for={emailId}>Email</label>
      <input
        id={emailId}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder="you@example.com"
      />
    </div>
    <div class="subscribe-form__field">
      <label for={nameId}>What should I call you?</label>
      <input
        id={nameId}
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Optional"
      />
    </div>
    <button type="submit" class={buttonClass}>Subscribe</button>
    <p class="subscribe-form__note">
      Occasional updates, no spam. Unsubscribe anytime.
    </p>
  </form>
</div>

<!-- Styles live in src/styles/brutalist-page.css so other forms
     (e.g. the unsubscribe form) can reuse .subscribe-form without
     importing this component. -->
