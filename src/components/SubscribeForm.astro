---
interface Props {
	idBase?: string;
	invert?: boolean;
}

const { idBase = "subscribe", invert = false } = Astro.props;

const emailId = `${idBase}-email`;
const nameId = `${idBase}-name`;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";
---

<div class={invert ? "subscribe-form-wrap subscribe-form-wrap--invert" : "subscribe-form-wrap"}>
  <form
    class="subscribe-form"
    action="/api/subscribe"
    method="post"
    data-subscribe-form
    data-turnstile-sitekey={sitekey}
  >
    <div class="subscribe-form__field">
      <label for={emailId}>Email</label>
      <input
        id={emailId}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder="you@example.com"
      />
    </div>
    <div class="subscribe-form__field">
      <label for={nameId}>What should I call you?</label>
      <input
        id={nameId}
        name="name"
        type="text"
        autocomplete="name"
        maxlength="100"
        placeholder="Optional"
      />
    </div>
    <div class="subscribe-honeypot" aria-hidden="true">
      <label for={`${idBase}-company`}>Company (leave blank)</label>
      <input
        id={`${idBase}-company`}
        name="company"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <div class="cf-turnstile-mount"></div>
    <button type="submit" class={invert ? "btn btn--invert" : "btn"}>Subscribe</button>
    <p class="subscribe-form__note">
      Occasional updates, no spam. Unsubscribe anytime.
    </p>
  </form>
</div>

<script>
  import "../lib/subscribe-form-client";
</script>

<!-- Styles live in src/styles/brutalist-page.css so other forms
     (e.g. the unsubscribe form) can reuse .subscribe-form without
     importing this component. -->
