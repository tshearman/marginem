    padding: 12px 80px 12px 12px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    border: 0;
    border-bottom: 1px dotted var(--ink);
    border-radius: 0;
    box-shadow: none;
    transform: none;
    cursor: pointer;
  }

  .search-modal :global(.post-preview__body:hover),
  .search-modal :global(.note-card--interactive:hover),
  .search-modal :global(.note-card--interactive:focus-visible),
  .search-modal :global(.garden-search:hover),
  .search-modal :global(.garden-search:focus-visible) {
    background: var(--highlight);
    color: var(--highlight-fg);
    box-shadow: none;
    transform: none;
    outline: none;
    text-decoration: none;
