    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
    line-height: 1;
  }

  .nav-search__trigger:hover,
  .nav-search__trigger:focus-visible {
    background: var(--highlight);
    color: var(--highlight-fg);
    outline: none;
  }

  .nav-search__icon {
    width: 14px;
    height: 14px;
