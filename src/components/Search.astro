---
---

<div class="nav-search">
  <button
    id="search-trigger"
    class="nav-search__trigger"
    type="button"
    aria-label="Search articles and notes"
  >
    <svg
      class="nav-search__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <span class="nav-search__text">Search</span>
    <span class="nav-search__shortcut">/</span>
  </button>
</div>

<div id="search-modal" class="search-modal" hidden aria-hidden="true">
  <div id="search-overlay" class="search-modal__overlay" tabindex="-1"></div>
  <div
    class="search-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-heading"
  >
    <div class="search-modal__header">
      <div class="search-modal__field">
        <svg
          class="search-modal__field-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          id="search-input"
          class="search-modal__input"
          type="text"
          placeholder="Search posts, tags, and text…"
          autocomplete="off"
          aria-label="Search site content"
        />
      </div>
      <button
        id="search-close"
        class="search-modal__close"
        type="button"
        aria-label="Close search"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div id="search-results" class="search-modal__results" aria-live="polite">
      <div class="search-modal__placeholder">
        Type to search the entire archive.
      </div>
    </div>
  </div>
</div>

<style>
  .nav-search__trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg, #fff);
    border: 1px solid var(--border, #d4d4d4);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    font: inherit;
    color: var(--fg, #121212);
    cursor: pointer;
    min-width: 9rem;
    justify-content: flex-start;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav-search__trigger:hover,
  .nav-search__trigger:focus-visible {
    border-color: rgba(0, 0, 0, 0.35);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
  }

  .nav-search__icon {
    color: rgba(0, 0, 0, 0.55);
  }

  .nav-search__text {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-search__shortcut {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--muted, #6a6a6a);
    background: rgba(0, 0, 0, 0.05);
    padding: 0.1rem 0.4rem;
    border-radius: 0.4rem;
  }

  @media (max-width: 760px) {
    .nav-search__trigger {
      min-width: 0;
    }
    .nav-search__text {
      font-size: 0.8rem;
      display: none;
    }
    .nav-search__shortcut {
      display: none;
    }
  }

  .search-modal {
    position: fixed;
    inset: 0;
    display: none;
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 4vh, 2.5rem) clamp(1rem, 4vw, 2.5rem);
    overflow-y: auto;
    height: 100dvh;
    min-height: 100vh;
  }

  .search-modal.is-visible {
    display: flex;
  }

  .search-modal__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
  }

  .search-modal__panel {
    position: relative;
    width: min(var(--site-max-width), 100%);
    max-height: calc(100vh - clamp(2rem, 8vh, 4rem));
    background: var(--bg, #fff);
    color: var(--fg, #111);
    border-radius: 1.35rem;
    border: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  @media (max-width: 760px) {
    .search-modal__panel {
      width: 100%;
      border-radius: 1rem;
      padding: 1rem;
      max-height: calc(100vh - 2rem);
    }
  }

  @media (max-width: 420px) {
    .search-modal {
      padding: 0.75rem;
    }

    .search-modal__panel {
      border-radius: 0.85rem;
      padding: 0.85rem;
      max-width: 100%;
      max-height: calc(100vh - 1.5rem);
    }
  }

  @supports (-webkit-touch-callout: none) {
    .search-modal {
      height: -webkit-fill-available;
    }
  }

  .search-modal__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    padding-bottom: 0.85rem;
    flex-shrink: 0;
    background: var(--bg, #fff);
  }

  .search-modal__field {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.9rem;
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.04);
  }

  .search-modal__field-icon {
    color: rgba(0, 0, 0, 0.5);
  }

  .search-modal__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-family: inherit;
    color: inherit;
    outline: none;
  }

  .search-modal__close {
    border: none;
    background: transparent;
    padding: 0.4rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--muted, #6a6a6a);
  }

  .search-modal__close:hover,
  .search-modal__close:focus-visible {
    background: rgba(0, 0, 0, 0.08);
    color: var(--fg, #111);
  }

  @media (max-width: 760px) {
    .search-modal__input {
      font-size: 16px;
    }
  }

  .search-modal__results {
    margin-top: 1rem;
    overflow-y: auto;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-right: 0.4rem;
    padding-bottom: 0.75rem;
    scrollbar-width: thin;
    min-height: 0;
  }

  .search-modal__results::-webkit-scrollbar {
    width: 0.4rem;
  }

  .search-modal__results::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.35);
    border-radius: 999px;
  }

  .search-modal__results::-webkit-scrollbar-track {
    background: transparent;
  }

  .search-modal__placeholder,
  .search-modal__empty {
    padding: 1.5rem;
    text-align: center;
    color: rgba(15, 23, 42, 0.6);
    font-size: 0.95rem;
  }

  .search-modal :global(.search-kind) {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(15, 23, 42, 0.5);
    position: absolute;
    top: 0.7rem;
    right: 0.85rem;
  }

  .search-modal :global(.post-preview__body) {
    position: relative;
    padding-right: 3.5rem;
  }

  .search-modal :global(.note-card--interactive) {
    position: relative;
    padding-right: 3.5rem;
  }

  .search-modal :global(.garden-search) {
    position: relative;
  }

  .search-modal :global(.garden-search__header) {
    padding-right: 3.5rem;
  }

  .search-modal :global(.note-card--interactive:hover),
  .search-modal :global(.note-card--interactive:focus-visible) {
    box-shadow: none;
    transform: none;
    outline: none;
  }

  .search-modal :global(.garden-search) {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 0.85rem;
    padding: 0.85rem 1rem;
    background: #fff;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .search-modal :global(.garden-search:hover),
  .search-modal :global(.garden-search:focus-visible) {
    text-decoration: none;
  }

  .search-modal :global(.garden-search__header) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .search-modal :global(.garden-search__title) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .search-modal :global(.garden-search__date) {
    font-size: 0.85rem;
  }

  .search-modal :global(.garden-search__excerpt) {
    margin: 0.4rem 0 0;
    color: rgba(15, 23, 42, 0.75);
  }

  .search-modal :global(.tag--filter:hover),
  .search-modal :global(.tag--default:hover) {
    background: rgba(15, 23, 42, 0.05);
  }

  :global(body.search-locked) {
    overflow: hidden;
  }
</style>
<script>
  import "../scripts/search-modal.ts";
</script>
