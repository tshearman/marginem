    width: min(960px, 100%);
    max-height: calc(100vh - clamp(2rem, 8vh, 4rem));
    background: var(--paper);
    color: var(--ink);
    border: 4px solid var(--ink);
    border-radius: 0;
    box-shadow: 8px 8px 0 var(--ink);
