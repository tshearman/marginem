---
import Tag from "./Tag.astro";

interface Props {
	tags?: string[];
	align?: "start" | "center" | "end";
	linkToTags?: boolean;
	variant?: "default" | "filter" | "display";
}

const {
	tags = [],
	align = "start",
	linkToTags,
	variant = "display",
} = Astro.props as Props;
const normalized = tags.filter(Boolean);
const shouldLinkToTags =
	typeof linkToTags === "boolean" ? linkToTags : variant !== "filter";
const alignmentClass =
	align === "center"
		? "tag-list--center"
		: align === "end"
			? "tag-list--end"
			: "";
---

{
  normalized.length ? (
    <p class={`tag-list ${alignmentClass}`}>
      {normalized.map((tag) => (
        <Tag tag={tag} variant={variant} asLink={shouldLinkToTags} />
      ))}
    </p>
  ) : null
}
