---
import Tag from "./Tag.astro";

interface Props {
	tags?: string[];
	align?: "start" | "center" | "end";
	linkToTags?: boolean;
}

const { tags = [], align = "start", linkToTags = false } = Astro.props as Props;
const normalized = tags.filter(Boolean);
const alignmentClass =
	align === "center"
		? "tag-list--center"
		: align === "end"
			? "tag-list--end"
			: "";
---

{
  normalized.length ? (
    <p class={`tag-list ${alignmentClass}`}>
      {normalized.map((tag) => (
        <Tag tag={tag} variant="filter" asLink={linkToTags} />
      ))}
    </p>
  ) : null
}

<style>
  .tag-list {
    margin: 0.5rem 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-start;
  }

  .tag-list--center {
    justify-content: center;
  }

  .tag-list--end {
    justify-content: flex-end;
  }
</style>
