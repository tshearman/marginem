---
import Tag from "./Tag.astro";

interface Props {
	tags?: string[];
	align?: "start" | "center" | "end";
	/** Defaults to linking unless the tags are filter buttons. */
	linkToTags?: boolean;
	variant?: "default" | "filter" | "display";
}

const {
	tags = [],
	align = "start",
	linkToTags,
	variant = "display",
} = Astro.props as Props;
const normalized = tags.filter(Boolean);
const asLink = linkToTags ?? variant !== "filter";
const alignmentClass = align === "start" ? "" : `tag-list--${align}`;
---

{
  normalized.length ? (
    <p class={`tag-list ${alignmentClass}`}>
      {normalized.map((tag) => (
        <Tag tag={tag} variant={variant} asLink={asLink} />
      ))}
    </p>
  ) : null
}
