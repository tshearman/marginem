---
import Tag from './Tag.astro';

const { tags = [] } = Astro.props;
const normalized = tags.filter(Boolean);
---
{normalized.length ? (
  <p style="margin: 0.5rem 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem;">
    {normalized.map((tag) => (
      <Tag tag={tag} />
    ))}
  </p>
) : null}
