---
// Shared <head> contents: charset/viewport, title/description, favicon, font
// face declarations, and the site-wide banner preload. Used by BaseLayout and
// the standalone homepage so the document-head boilerplate lives in one place.
import { Font } from "astro:assets";
import favicon from "../assets/favicon.png";
import bannerSrcUrl from "../assets/banners/_optimized/notebook_banner_c.webp?url";
import { HIGHLIGHT_POOL } from "../lib/highlight-pool";
import { SITE_NAME } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = SITE_NAME,
	description = "Explorations in math, code, and visualization",
} = Astro.props as Props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
{/* Resolve theme before paint to avoid a flash, and lock in one random
    highlight for the banner (regardless of theme) via inline custom
    properties on :root. highlight-hover.ts re-rolls per hover; this
    pick is what the banner reads and stays put for the page load. */}
<script is:inline define:vars={{ POOL: HIGHLIGHT_POOL }}>
  (function () {
    var root = document.documentElement;
    try {
      var stored = localStorage.getItem("theme");
      var theme =
        stored ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      root.dataset.theme = theme;
    } catch (e) {}
    var p = POOL[Math.floor(Math.random() * POOL.length)];
    root.style.setProperty("--highlight", p.highlight);
    root.style.setProperty("--highlight-fg", p.fg);
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href={favicon.src} type="image/png" />
<!-- iA Writer Duo @font-face declarations + a preload for the regular face,
     so layout stabilises before the browser restores scroll on Back.
     Astro's Fonts API also injects a fallback @font-face whose metrics
     match Courier New, preventing reflow on font swap. -->
<!-- Preload only the regular face — italic/bold can swap in via font-display
     without blocking first paint. -->
<Font
  cssVariable="--font-ia-writer"
  preload={[{ weight: "400", style: "normal" }]}
/>
<link
  rel="preload"
  as="image"
  href={bannerSrcUrl}
  type="image/webp"
  fetchpriority="high"
/>
