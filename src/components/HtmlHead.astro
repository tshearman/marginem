---
// Shared <head> contents: charset/viewport, theme bootstrap, title/description,
// favicon, fonts, and the site-wide banner preload. Used by BaseLayout.
import { Font } from "astro:assets";
import favicon from "../assets/favicon.png";
import bannerSrcUrl from "../assets/banners/_optimized/notebook_banner_c.webp?url";
import { HIGHLIGHT_POOL } from "../lib/highlight-pool";
import { SITE_NAME } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
	/** Banner image to preload; defaults to the site-wide banner. */
	bannerSrc?: string;
}

const {
	title = SITE_NAME,
	description = "Explorations in math, code, and visualization",
	bannerSrc,
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
{/* Canvas colour + color-scheme, inlined so the very first frame of every
    page is already in the right theme. Without this the browser paints its
    default white canvas until the external stylesheet arrives, which shows
    as a white flash between pages in dark mode. */}
<style is:inline>
  html { color-scheme: light; background-color: #e8e8e8; }
  html[data-theme="dark"] { color-scheme: dark; background-color: #000; }
</style>
{/* Theme: resolved before first paint (stored choice, else OS preference).
    All theme state lives here: the Masthead toggle is handled by a delegated
    click listener, and `themechange` fires on document whenever the theme
    changes so canvases (banner, charts) can repaint.

    Also pins one random highlight on :root for the page load. The banner
    reads it; highlight-hover.ts re-rolls per hovered element.

    data-cfasync="false" exempts it from Cloudflare Rocket Loader, which
    would otherwise defer it past first paint and flash the light theme. */}
<script is:inline data-cfasync="false" define:vars={{ POOL: HIGHLIGHT_POOL }}>
  (function () {
    var root = document.documentElement;
    var darkQuery = matchMedia("(prefers-color-scheme: dark)");

    function resolve() {
      var stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch (e) {}
      return stored || (darkQuery.matches ? "dark" : "light");
    }

    function apply(theme) {
      if (root.dataset.theme === theme) return;
      root.dataset.theme = theme;
      document.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme: theme } }),
      );
    }

    apply(resolve());

    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!(target instanceof Element) || !target.closest("[data-theme-toggle]"))
        return;
      var next = root.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      apply(next);
    });

    // Re-sync when the theme may have changed behind this page's back: a
    // back/forward-cache restore after toggling elsewhere, another tab, or
    // an OS switch while no explicit choice is stored.
    addEventListener("pageshow", function (event) {
      if (event.persisted) apply(resolve());
    });
    addEventListener("storage", function (event) {
      if (event.key === "theme") apply(resolve());
    });
    darkQuery.addEventListener("change", function () {
      apply(resolve());
    });

    var pick = POOL[Math.floor(Math.random() * POOL.length)];
    root.style.setProperty("--highlight", pick.highlight);
    root.style.setProperty("--highlight-fg", pick.fg);
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href={favicon.src} type="image/png" />
{/* Preload only the regular face; italic/bold swap in via font-display.
    The Fonts API also emits a metric-matched Courier New fallback, so the
    swap doesn't reflow. */}
<Font
  cssVariable="--font-ia-writer"
  preload={[{ weight: "400", style: "normal" }]}
/>
<link
  rel="preload"
  as="image"
  href={bannerSrc ?? bannerSrcUrl}
  type="image/webp"
  fetchpriority="high"
/>
