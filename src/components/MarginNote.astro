---
const { title = "Note" } = Astro.props;
---

<aside class="margin-note">
  <strong>{title}</strong>
  <slot />
</aside>

<style>
  .margin-note {
    position: relative;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--muted);
  }

  .margin-note::before {
    content: "";
    position: absolute;
    top: 0rem;
    bottom: -0.25rem;
    left: 0.75rem;
    width: 0.35rem;
    border: var(--thin-border);
  }

  @media (min-width: 761px) {
    .margin-note {
      float: right;
      clear: right;
      margin: 0 0 1rem 1.5rem;
      width: min(18rem, 40%);
      max-width: 18rem;
      padding: 0 0 0 1rem;
      font-size: 0.9rem;
    }

    .margin-note::before {
      content: "";
      position: absolute;
      top: 0rem;
      bottom: -0.25rem;
      left: 0rem;
      width: 0.35rem;
      border: var(--thin-border);
    }
  }
</style>
