---
const { title = "Note" } = Astro.props;
---

<aside class="margin-note">
  <strong class="margin-note__title">{title}</strong>
  <div class="margin-note__body"><slot /></div>
</aside>

<style>
  .margin-note {
    position: relative;
    margin: 1.5rem 0;
    padding: 0.6rem 0.85rem 0.6rem 1rem;
    color: var(--fg);
    border-left: 4px solid var(--ink);
    background: rgb(var(--ink-rgb) / 0.04);
    font-family: var(--mono);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .margin-note__title {
    display: inline-block;
    margin-bottom: 0.35rem;
    padding: 1px 6px;
    font-family: var(--display);
    font-size: var(--fs-3xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    font-weight: 900;
  }

  @media (min-width: 761px) {
    .margin-note {
      float: right;
      clear: right;
      margin: 0.25rem 0 1rem 1.5rem;
      width: min(18rem, 40%);
      max-width: 18rem;
    }
  }
</style>
