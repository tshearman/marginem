---
const { title = 'Note' } = Astro.props;
---
<aside class="margin-note">
  <strong>{title}</strong>
  <slot />
</aside>

<style>
  .margin-note {
    position: relative;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--muted);
    border-left: 3px solid var(--border);
  }

  @media (min-width: 960px) {
    .margin-note {
      float: right;
      clear: right;
      margin: 0 0 1rem 1.5rem;
      max-width: 18rem;
      border-left: none;
      border-right: 3px solid var(--border);
      padding: 0 0 0 1rem;
      font-size: 0.9rem;
    }
  }
</style>
