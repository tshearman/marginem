---
/**
 * Full-width subscribe block — the brutalist banner used at the bottom of
 * the homepage and on long-form pages (newsletter issues, etc.). Self-contained:
 * carries its own scoped styles and relies only on the shared .btn classes
 * from buttons.css. Toggle `invert` for use on dark backgrounds.
 */
interface Props {
  action?: string;
  method?: "get" | "post";
  idBase?: string;
  invert?: boolean;
  heading?: string;
  description?: string;
}

const {
  action = "/api/subscribe",
  method = "post",
  idBase = "subscribe",
  invert = false,
  heading = "Subscribe",
  description = "Get notified when a new essay or note goes up. Occasional updates, no spam, unsubscribe anytime.",
} = Astro.props as Props;

const emailId = `${idBase}-email`;
const nameId = `${idBase}-name`;
const sectionClass = ["subscribe-banner", invert ? "subscribe-banner--invert" : null]
  .filter(Boolean)
  .join(" ");
const buttonClass = ["btn", invert ? "btn--invert" : null].filter(Boolean).join(" ");
---

<section class={sectionClass} id={idBase}>
  <h2 class="subscribe-banner__heading">{heading}</h2>
  <p class="subscribe-banner__lede">{description}</p>
  <form class="subscribe-banner__form" action={action} method={method}>
    <div class="subscribe-banner__cols">
      <div class="subscribe-banner__row">
        <label for={emailId}>Email</label>
        <input
          id={emailId}
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          placeholder="you@example.com"
        />
      </div>
      <div class="subscribe-banner__row">
        <label for={nameId}>What should I call you?</label>
        <input
          id={nameId}
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Optional"
        />
      </div>
    </div>
    <input type="submit" value="Subscribe" class={buttonClass} />
  </form>
</section>

<style is:global>
  /* `is:global` so per-page overrides (e.g. `body.post-page
     .subscribe-banner + .site-footer { margin-top: 0 }` in post.css) can
     target this banner's classes without fighting scoped specificity. The
     selectors are namespaced under `.subscribe-banner`. */
  .subscribe-banner {
    padding: 18px;
    border-top: 6px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .subscribe-banner--invert {
    background: var(--ink);
    color: var(--paper);
    border-top-color: var(--paper);
  }

  .subscribe-banner__heading {
    display: inline-block;
    margin: 0 0 14px;
    padding: 2px 8px;
    font-family: var(--display);
    font-size: var(--fs-sm);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
  }

  .subscribe-banner--invert .subscribe-banner__heading {
    color: var(--ink);
    background: var(--paper);
  }

  .subscribe-banner__lede {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: var(--fs-base);
    line-height: 1.5;
  }

  .subscribe-banner__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .subscribe-banner__row {
    margin: 0 0 12px;
  }

  .subscribe-banner__row label {
    display: block;
    margin: 0 0 4px;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
  }

  .subscribe-banner__row input[type="email"],
  .subscribe-banner__row input[type="text"] {
    width: 100%;
    padding: 8px;
    font-family: var(--mono);
    /* 16px minimum keeps iOS Safari from zooming on focus. */
    font-size: var(--fs-md);
    color: var(--ink);
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 0;
  }

  .subscribe-banner--invert .subscribe-banner__row input[type="email"],
  .subscribe-banner--invert .subscribe-banner__row input[type="text"] {
    border-color: var(--paper);
  }

  .subscribe-banner__row input:focus {
    outline: 3px solid var(--highlight);
    outline-offset: 0;
  }

  @media (max-width: 720px) {
    .subscribe-banner__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
