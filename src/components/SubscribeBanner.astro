---
/**
 * Full-width subscribe block for the bottom of the homepage and long-form
 * pages (newsletter issues, etc.). Uses the shared .btn classes and the
 * honeypot / Turnstile-mount styles from brutalist-page.css. Toggle `invert`
 * for dark backgrounds.
 *
 * `linkOnly` swaps the form for a link to /subscribe, so the homepage never
 * loads the Turnstile script.
 */
interface Props {
	idBase?: string;
	invert?: boolean;
	linkOnly?: boolean;
}

const { idBase = "subscribe", invert = false, linkOnly = false } = Astro.props;

const emailId = `${idBase}-email`;
const nameId = `${idBase}-name`;
const buttonClass = invert ? "btn btn--invert" : "btn";
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";
---

<section class={invert ? "subscribe-banner subscribe-banner--invert" : "subscribe-banner"} id={idBase}>
  <p class="subscribe-banner__lede">
    Get notified when a new essay or note goes up. Occasional updates, no spam,
    unsubscribe anytime.
  </p>
  {linkOnly ? (
    <p class="subscribe-banner__cta">
      <a href="/subscribe" class={buttonClass}>Subscribe</a>
    </p>
  ) : (
    <form
      class="subscribe-banner__form"
      action="/api/subscribe"
      method="post"
      data-subscribe-form
      data-turnstile-sitekey={sitekey}
    >
      <div class="subscribe-banner__cols">
        <div class="subscribe-banner__row">
          <label for={emailId}>Email</label>
          <input
            id={emailId}
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            placeholder="you@example.com"
          />
        </div>
        <div class="subscribe-banner__row">
          <label for={nameId}>What should I call you?</label>
          <input
            id={nameId}
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            placeholder="Optional"
          />
        </div>
      </div>
      <div class="subscribe-honeypot" aria-hidden="true">
        <label for={`${idBase}-company`}>Company (leave blank)</label>
        <input
          id={`${idBase}-company`}
          name="company"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div class="cf-turnstile-mount"></div>
      <input type="submit" value="Subscribe" class={buttonClass} />
    </form>
  )}
</section>

{!linkOnly && <script>import "../lib/subscribe-form-client";</script>}

<style is:global>
  /* `is:global` so page-level rules (e.g. `.subscribe-banner + .site-footer`
     in brutalist-page.css) can target these classes without fighting scoped
     specificity. Selectors are namespaced under `.subscribe-banner`. */
  .subscribe-banner {
    padding: 18px;
    border-top: 6px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .subscribe-banner--invert {
    background: var(--ink);
    color: var(--paper);
    border-top-color: var(--paper);
  }

  .subscribe-banner__lede {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: var(--fs-base);
    line-height: 1.5;
  }

  .subscribe-banner__cta {
    margin: 0;
  }

  .subscribe-banner__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .subscribe-banner__row {
    margin: 0 0 12px;
  }

  .subscribe-banner__row label {
    display: block;
    margin: 0 0 4px;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
  }

  .subscribe-banner__row input[type="email"],
  .subscribe-banner__row input[type="text"] {
    width: 100%;
    padding: 8px;
    font-family: var(--mono);
    /* 16px minimum keeps iOS Safari from zooming on focus. */
    font-size: var(--fs-md);
    color: var(--ink);
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 0;
  }

  .subscribe-banner--invert .subscribe-banner__row input[type="email"],
  .subscribe-banner--invert .subscribe-banner__row input[type="text"] {
    border-color: var(--paper);
  }

  .subscribe-banner__row input:focus {
    outline: 3px solid var(--highlight);
    outline-offset: 0;
  }

  @media (max-width: 720px) {
    .subscribe-banner__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
