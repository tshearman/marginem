---
interface Props {
	tag?: string;
	href?: string;
	variant?: "default" | "filter" | "display";
	size?: "small" | "medium" | "large";
	selected?: boolean;
	clickable?: boolean;
	asLink?: boolean;
}

const {
	tag = "",
	href,
	variant = "default",
	size = "medium",
	selected = false,
	clickable = true,
	asLink = false,
} = Astro.props as Props;

const label = tag?.trim() ?? "";
const url =
	href ??
	(label ? `/tags/${encodeURIComponent(label.toLowerCase())}/` : undefined);
const classes = ["tag", `tag--${variant}`, `tag--${size}`]
	.filter(Boolean)
	.join(" ");
const dataAttrs = {
	"data-tag": label || undefined,
	"data-selected": selected ? "true" : "false",
};
const shouldRenderFilterButton =
	variant === "filter" && clickable && !(asLink && clickable && url);
---

{
  label ? (
    shouldRenderFilterButton ? (
      <button
        class={classes}
        type="button"
        {...dataAttrs}
        aria-pressed={selected ? "true" : "false"}
      >
        #{label}
      </button>
    ) : clickable && url ? (
      <a class={classes} href={url} {...dataAttrs}>
        #{label}
      </a>
    ) : (
      <span class={classes} {...dataAttrs}>
        #{label}
      </span>
    )
  ) : null
}
