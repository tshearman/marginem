---
import { Tag as PreactTag } from "./preact/Tag";

type Props = {
	tag?: string;
	href?: string;
	variant?: "default" | "filter" | "display";
	size?: "small" | "medium" | "large";
	selected?: boolean;
	clickable?: boolean;
	asLink?: boolean;
	className?: string;
};

const props = Astro.props as Props;
---

<PreactTag {...props} />
