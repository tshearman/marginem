---
interface Props {
  datetime: string | Date;
  label?: string;
  class?: string;
}

import { formatDateLabelHtml } from "../lib/date";

const { datetime, label = "", class: className } = Astro.props as Props;
const isoDate =
  typeof datetime === "string" ? datetime : datetime.toISOString();
const renderedLabel = formatDateLabelHtml(label);
---

<time datetime={isoDate} class={`date-stamp ${className ?? ""}`.trim()}>
  {label ? <span set:html={renderedLabel} /> : null}
</time>

<style>
  .hero-feature__date {
    /* margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem; */
    color: rgba(255, 255, 255, 0.95);
  }
</style>
