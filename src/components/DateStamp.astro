---
import { DateStamp as PreactDateStamp } from "./preact/DateStamp";

interface Props {
	datetime: string | Date;
	label?: string;
	class?: string;
}

const { datetime, label = "", class: className } = Astro.props as Props;
---

<PreactDateStamp datetime={datetime} label={label} className={className} />

<style>
  .hero-feature__date {
    /* margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--fs-sm); */
    color: var(--fg-inverse-soft);
  }
</style>
