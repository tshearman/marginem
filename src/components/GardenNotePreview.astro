---
import { renderGardenNoteCard } from "../lib/card-html";
import { formatDate } from "../lib/date";

interface Props {
	note: {
		slug: string;
		title: string;
		excerpt: string;
		updatedAt: Date;
	};
}

const { note } = Astro.props as Props;
const html = renderGardenNoteCard({
	href: `/garden/${note.slug}/`,
	title: note.title,
	excerpt: note.excerpt,
	updatedAt: note.updatedAt,
	dateLabel: formatDate(note.updatedAt),
});
---

<Fragment set:html={html} />
