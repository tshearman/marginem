---
import Tag from "./Tag.astro";
import DateStamp from "./DateStamp.astro";
import { ellipsizeText } from "../lib/text";
import { formatDate } from "../lib/date";

interface Props {
	title: string;
	url: string;
	date: Date;
	description?: string;
	abstract?: string;
	tags?: string[];
	class?: string;
}

const {
	title,
	url,
	date,
	description = "",
	abstract = "",
	tags = [],
	class: className = "",
} = Astro.props as Props;

const dateLabel = formatDate(date, { month: "long", day: "numeric" });
const preview = ellipsizeText(abstract || description || "", 220);
---

<article class={`archive-entry ${className}`} data-tags={JSON.stringify(tags)}>
  <div class="archive-entry__meta">
    <DateStamp datetime={date} label={dateLabel} />
  </div>
  <div class="archive-entry__body">
    <h3 class="archive-entry__title">
      <a href={url}>{title}</a>
    </h3>
    {preview ? <p class="archive-entry__excerpt">{preview}</p> : null}
    {
      tags.length ? (
        <div class="archive-entry__tags">
          {tags.map((tag) => (
            <Tag tag={tag} variant="filter" size="small" />
          ))}
        </div>
      ) : null
    }
  </div>
</article>

<style>
  .archive-entry {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--bg);
    transition: border-color 0.2s ease;
  }

  .archive-entry:hover {
    border-color: var(--thin-border-color);
  }

  .archive-entry.hidden {
    display: none;
  }

  .archive-entry__meta {
    font-size: var(--fs-base);
  }

  .archive-entry__meta .date-stamp {
    display: inline-block;
  }

  .archive-entry__title {
    margin: 0;
    font-size: var(--fs-xl);
  }

  .archive-entry__title a {
    color: inherit;
    text-decoration: none;
  }

  .archive-entry__title a:hover {
    text-decoration: underline;
  }

  .archive-entry__excerpt {
    margin: 0.35rem 0 0;
    color: rgb(var(--ink-rgb) / 0.8);
  }

  .archive-entry__tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  @media (min-width: 761px) {
    .archive-entry {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }

    .archive-entry__meta {
      min-width: 7rem;
    }

    .archive-entry__body {
      flex: 1;
    }
  }
</style>
