---
import type { CollectionEntry } from "astro:content";
import FeaturedCard from "./FeaturedCard.astro";

type BlogEntry = CollectionEntry<"blog">;

interface Props {
  posts?: BlogEntry[];
  formatDate?: (date: Date) => string;
}

const { posts = [], formatDate } = Astro.props as Props;
const featured = posts.filter(Boolean);
const format = formatDate
  ? (date: Date) => formatDate(date)
  : (date: Date) =>
      new Intl.DateTimeFormat("en", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(date);
const marqueeRepeats = Array.from({ length: 3 }, (_, index) => index);
---

{
  featured.length ? (
    <div
      class="featured-marquee"
      aria-label="Featured posts"
      data-repeat-count={marqueeRepeats.length}
      data-speed="30"
    >
      <button
        class="featured-marquee__control featured-marquee__control--prev"
        type="button"
        data-control="prev"
        aria-label="Scroll featured posts backward"
      >
        ‹
      </button>
      <div class="featured-marquee__window">
        <div class="featured-marquee__viewport">
          <div class="featured-marquee__inner" aria-hidden="true">
            {marqueeRepeats.map((repeatIndex) => (
              <div class="featured-marquee__group" data-repeat={repeatIndex}>
                {featured.map((post) => (
                  <FeaturedCard post={post} formatDate={format} />
                ))}
              </div>
            ))}
          </div>
        </div>
        <div
          class="featured-marquee__fade featured-marquee__fade--left"
          aria-hidden="true"
        />
        <div
          class="featured-marquee__fade featured-marquee__fade--right"
          aria-hidden="true"
        />
      </div>
      <button
        class="featured-marquee__control featured-marquee__control--next"
        type="button"
        data-control="next"
        aria-label="Scroll featured posts forward"
      >
        ›
      </button>
    </div>
  ) : null
}

<style>
  .featured-marquee {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    --offset: 5vw;
    --move-initial: calc(-25% + var(--offset));
    --move-final: calc(-50% + var(--offset));
    --marquee-speed: 35s;
    margin-top: 1rem;
    width: 100%;
  }

  .featured-marquee__window {
    position: relative;
    flex: 1 1 auto;
    max-width: 100%;
    min-width: 0;
  }

  .featured-marquee__viewport {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    background: #fff;
  }

  .featured-marquee__inner {
    display: flex;
    gap: 1rem;
    width: fit-content;
    padding: 0.5rem 0;
  }

  .featured-marquee__group {
    display: flex;
    gap: 1rem;
  }

  .featured-marquee__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1rem;
    pointer-events: none;
    z-index: 1;
  }

  .featured-marquee__fade--left {
    left: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0)
    );
  }

  .featured-marquee__fade--right {
    right: 0;
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0)
    );
  }

  .featured-marquee__control {
    background: #fff;
    color: rgba(15, 23, 42, 0.75);
    border: 0;
    font-size: 3rem;
    cursor: pointer;
  }
</style>

<script>
  const initFeaturedMarqueeControls = () => {
    document.querySelectorAll(".featured-marquee").forEach((marquee) => {
      if (marquee.dataset.controlsReady === "true") return;
      const viewport = marquee.querySelector(".featured-marquee__viewport");
      const inner = marquee.querySelector(".featured-marquee__inner");
      const prevBtn = marquee.querySelector("[data-control='prev']");
      const nextBtn = marquee.querySelector("[data-control='next']");
      if (!viewport || !inner || (!prevBtn && !nextBtn)) return;

      const repeatCount = Number(marquee.dataset.repeatCount) || 4;
      const baseWidth = inner.scrollWidth / repeatCount;
      const speed = Number(marquee.dataset.speed) || 45;
      let resumeTimer;
      let rafId;
      let lastTime;

      viewport.scrollLeft = baseWidth;
      alignToCard();

      function getCardWidth() {
        const card = marquee.querySelector(".featured-card");
        if (!card) return 220;
        const gap = parseFloat(
          window.getComputedStyle(inner).columnGap ||
            window.getComputedStyle(inner).gap ||
            "0",
        );
        return card.offsetWidth + gap;
      }

      function getCenterOffset() {
        const card = marquee.querySelector(".featured-card");
        if (!card) return 0;
        return Math.max((viewport.clientWidth - card.offsetWidth) / 2, 0);
      }

      function normalizeScroll() {
        const maxScroll = inner.scrollWidth - viewport.clientWidth;
        if (viewport.scrollLeft <= baseWidth * 0.5) {
          viewport.scrollLeft += baseWidth;
        } else if (viewport.scrollLeft >= maxScroll - baseWidth * 0.5) {
          viewport.scrollLeft -= baseWidth;
        }
      }

      function alignToCard() {
        const cardWidth = getCardWidth();
        if (!cardWidth) return;
        const centerOffset = getCenterOffset();
        const index = Math.round(
          (viewport.scrollLeft + centerOffset) / cardWidth,
        );
        const target = index * cardWidth - centerOffset;
        viewport.scrollLeft = target;
      }

      const step = (timestamp) => {
        if (!lastTime) lastTime = timestamp;
        const delta = (timestamp - lastTime) / 1000;
        lastTime = timestamp;
        viewport.scrollLeft += speed * delta;
        normalizeScroll();
        rafId = requestAnimationFrame(step);
      };

      const startAutoScroll = () => {
        if (rafId) return;
        lastTime = undefined;
        rafId = requestAnimationFrame(step);
      };

      const stopAutoScroll = () => {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = undefined;
        }
      };

      const resumeAfterDelay = () => {
        clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          startAutoScroll();
        }, 1400);
      };

      const scrollToCard = (direction) => {
        stopAutoScroll();
        const cardWidth = getCardWidth();
        if (!cardWidth) return;
        const centerOffset = getCenterOffset();
        const currentIndex = Math.round(
          (viewport.scrollLeft + centerOffset) / cardWidth,
        );
        const targetIndex = currentIndex + direction;
        const target = targetIndex * cardWidth - centerOffset;
        viewport.scrollTo({ left: target, behavior: "smooth" });
        setTimeout(() => {
          normalizeScroll();
          alignToCard();
        }, 350);
        resumeAfterDelay();
      };

      prevBtn?.addEventListener("click", () => scrollToCard(-1));
      nextBtn?.addEventListener("click", () => scrollToCard(1));
      marquee.addEventListener("mouseenter", stopAutoScroll);
      marquee.addEventListener("mouseleave", () => {
        resumeAfterDelay();
      });
      marquee.dataset.controlsReady = "true";
      startAutoScroll();
    });
  };

  document.addEventListener("DOMContentLoaded", initFeaturedMarqueeControls);
  document.addEventListener("astro:page-load", initFeaturedMarqueeControls);
</script>
