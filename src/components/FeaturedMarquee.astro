---
import type { CollectionEntry } from "astro:content";
import FeaturedCard from "./FeaturedCard.astro";
import marqueeScript from "../scripts/featured-marquee.ts?url";

type BlogEntry = CollectionEntry<"blog">;

interface Props {
	posts?: BlogEntry[];
	formatDate?: (date: Date) => string;
}

const { posts = [], formatDate } = Astro.props as Props;
const featured = posts.filter(Boolean);
const format = formatDate
	? (date: Date) => formatDate(date)
	: (date: Date) =>
			new Intl.DateTimeFormat("en", {
				month: "short",
				day: "numeric",
				year: "numeric",
			}).format(date);
const marqueeRepeats = Array.from({ length: 3 }, (_, index) => index);
---

{
  featured.length ? (
    <div
      class="featured-marquee"
      aria-label="Featured posts"
      data-repeat-count={marqueeRepeats.length}
      data-speed="30"
    >
      <button
        class="featured-marquee__control featured-marquee__control--prev"
        type="button"
        data-control="prev"
        aria-label="Scroll featured posts backward"
      >
        ‹
      </button>
      <div class="featured-marquee__window">
        <div class="featured-marquee__viewport">
          <div class="featured-marquee__inner" aria-hidden="true">
            {marqueeRepeats.map((repeatIndex) => (
              <div class="featured-marquee__group" data-repeat={repeatIndex}>
                {featured.map((post) => (
                  <FeaturedCard post={post} formatDate={format} />
                ))}
              </div>
            ))}
          </div>
        </div>
        <div
          class="featured-marquee__fade featured-marquee__fade--left"
          aria-hidden="true"
        />
        <div
          class="featured-marquee__fade featured-marquee__fade--right"
          aria-hidden="true"
        />
      </div>
      <button
        class="featured-marquee__control featured-marquee__control--next"
        type="button"
        data-control="next"
        aria-label="Scroll featured posts forward"
      >
        ›
      </button>
    </div>
  ) : null
}

<style>
  .featured-marquee {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    --offset: 5vw;
    --move-initial: calc(-25% + var(--offset));
    --move-final: calc(-50% + var(--offset));
    --marquee-speed: 35s;
    margin-top: 1rem;
    width: 100%;
  }

  .featured-marquee__window {
    position: relative;
    flex: 1 1 auto;
    max-width: 100%;
    min-width: 0;
  }

  .featured-marquee__viewport {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    background: #fff;
  }

  .featured-marquee__inner {
    display: flex;
    gap: 1rem;
    width: fit-content;
    padding: 0.5rem 0;
  }

  .featured-marquee__group {
    display: flex;
    gap: 1rem;
  }

  .featured-marquee__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1rem;
    pointer-events: none;
    z-index: 1;
  }

  .featured-marquee__fade--left {
    left: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0)
    );
  }

  .featured-marquee__fade--right {
    right: 0;
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0)
    );
  }

  .featured-marquee__control {
    background: #fff;
    color: rgba(15, 23, 42, 0.75);
    border: 0;
    font-size: 3rem;
    cursor: pointer;
  }
</style>

---
import marqueeScript from "../scripts/featured-marquee.ts?url";
---
<script type="module" is:inline src={marqueeScript}></script>
