---
import type { LikeTargetType } from "../lib/likes/types";

interface Props {
	slug: string;
	target: LikeTargetType;
	align?: "left" | "right";
	icon?: "heart" | "plus";
	class?: string;
}

const {
	slug,
	target,
	align = "left",
	icon = "heart",
	class: className,
} = Astro.props as Props;
const domId = `like-${target}-${slug}`.replace(/[^a-zA-Z0-9-_]/g, "_");
---

<div
	id={domId}
	class={`like-control align-${align} ${className ?? ""}`}
	data-slug={slug}
	data-target={target}
>
	<button class="like-button" type="button">
		{
			icon === "plus" ? (
				<svg
					class="like-icon like-icon--plus"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M12 6.25v11.5m-5.75-5.75h11.5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			) : (
				<svg
					class="like-icon like-icon--heart"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25 3 15 12 20.25 12 20.25S21 15 21 8.25Z"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linejoin="round"
					/>
				</svg>
			)
		}
		<span class="count" data-count>—</span>
	</button>
</div>

<script is:inline data-dom-id={domId}>
	(() => {
		const script = document.currentScript;
		const domId = script?.dataset.domId;
		const root =
			(domId && document.getElementById(domId)) ||
			(script?.previousElementSibling?.classList?.contains("like-control")
				? script.previousElementSibling
				: script?.parentElement?.querySelector(".like-control"));
		if (!root) {
			console.warn("[LikeButton] missing root element", { domId });
			return;
		}

		const slug = root.dataset.slug || "";
		const target = root.dataset.target || "";
		const button = root.querySelector("button");
		const countEl = root.querySelector("[data-count]");

		let liked = false;
		let count = 0;
		let pending = false;

		const setState = () => {
			if (!button || !countEl) return;
			button.disabled = pending;
			button.classList.toggle("is-liked", liked);
			button.setAttribute("aria-pressed", String(liked));
			button.setAttribute("aria-label", liked ? "Unlike" : "Like");
			countEl.textContent = String(count);
		};

		setState();

		const load = async () => {
			if (!slug || !target) {
				console.warn("[LikeButton] missing slug/target", {
					slug,
					target,
				});
				return;
			}
			try {
				const res = await fetch(
					`/api/likes?type=${encodeURIComponent(target)}&slug=${encodeURIComponent(slug)}`,
					{ headers: { Accept: "application/json" } },
				);
				if (!res.ok)
					throw new Error(`Failed to load likes (${res.status})`);
				const data = await res.json();
				liked = Boolean(data?.liked);
				count = Number(data?.count ?? 0);
				setState();
			} catch (error) {
				console.error("[LikeButton] load error", error);
				setState();
			}
		};

		const toggle = async () => {
			if (pending || !slug || !target) return;
			pending = true;
			setState();
			try {
				const method = liked ? "DELETE" : "POST";
				const res = await fetch("/api/likes", {
					method,
					headers: {
						"Content-Type": "application/json",
						Accept: "application/json",
					},
					body: JSON.stringify({
						type: target,
						slug,
						action: liked ? "unlike" : "like",
					}),
				});
				if (!res.ok)
					throw new Error(`Failed to ${method} (${res.status})`);
				const data = await res.json();
				liked = Boolean(data?.liked);
				count = Number(data?.count ?? count);
			} catch (error) {
				console.error("[LikeButton] toggle error", error);
				setState();
			} finally {
				pending = false;
				setState();
			}
		};

		button?.addEventListener("click", toggle);
		load();
	})();
</script>

<style>
	.like-control {
		display: inline-flex;
		align-items: center;
		gap: 0.54rem;
		font-size: 0.86rem;
		color: var(--fg);
	}

	.like-control.align-right {
		justify-content: flex-end;
	}

	.like-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.36rem 0.68rem;
		border: 1px solid rgba(15, 23, 42, 0.12);
		border-radius: 999px;
		background: #fff;
		color: inherit;
		cursor: pointer;
		transition:
			border-color 160ms ease,
			outline-color 120ms ease;
	}

	.like-button:focus-visible {
		outline: 2px solid rgba(15, 23, 42, 0.25);
		outline-offset: 2px;
	}

	.like-button.is-liked {
		background: linear-gradient(135deg, #ff7a7a, #ff4f81);
		color: #fff;
		border-color: transparent;
	}

	.like-button .like-icon {
		width: 1.1rem;
		height: 1.1rem;
		display: block;
	}

	.like-button.is-liked .like-icon--heart path {
		fill: currentColor;
	}

	.like-button.is-liked .like-icon--plus path {
		fill: none;
		stroke: currentColor;
	}

	.like-button .count {
		font-variant-numeric: tabular-nums;
		min-width: 1.5ch;
		text-align: right;
	}
</style>
