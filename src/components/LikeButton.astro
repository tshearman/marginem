---
import FeelbackPulse from "astro-feelback/components/FeelbackPulse.astro";
import iconHeart from "@feelback/js/icons/icon-heart.svg?raw";
import iconHeartActive from "@feelback/js/icons/icon-heart-active.svg?raw";

type LikeTargetType = "post" | "note";

interface Props {
	slug: string;
	target: LikeTargetType;
	align?: "left" | "right";
	icon?: "heart" | "plus";
	class?: string;
}

const { slug, target, align = "left", class: className } = Astro.props as Props;

const contentSetId = import.meta.env.PUBLIC_FEELBACK_CONTENT_SET_ID;
const contentKey = `${target}:${slug}`;
const likePreset = {
	icon: [iconHeart, iconHeartActive] as const,
	title: "Like",
};
---

<div class={`like-control align-${align} ${className ?? ""}`}>
	{
		contentSetId ? (
			<FeelbackPulse
				contentSetId={contentSetId}
				key={contentKey}
				preset={likePreset}
				showCount
			/>
		) : null
	}
</div>

<style>
	.like-control {
		display: inline-flex;
		align-items: center;
		color: var(--fg);
		border: 0px solid var(--border);
		border-radius: 999px;
		transition:
			transform 160ms ease,
			box-shadow 160ms ease;
	}

	.like-control.align-right {
		justify-content: flex-end;
	}

	.like-control:hover {
		transform: translateY(-1px);
		box-shadow: 0 3px 10px rgba(15, 23, 42, 0.12);
	}

	:global(.feelback-container.feelback-pulse) {
		--highlight-opacity: 0;
	}

	.like-control :global(.feelback-btn.active > .feelback-icon.active) {
		color: var(--feelback-like, #ec5a8d);
	}

	.like-control :global(.feelback-btn.active > .feelback-icon) {
		transform: none;
	}

	.like-control :global(.feelback-btn.active > .feelback-icon.active svg) {
		overflow: visible;
		display: block;
		paint-order: fill stroke;
	}

	.like-control
		:global(.feelback-btn.active > .feelback-icon.active svg path) {
		stroke: var(--fg);
		stroke-width: 48;
		stroke-linejoin: round;
	}

	.like-control :global(.feelback-count) {
		font-family: inherit;
		font-weight: 400;
	}

	.like-control :global(.feelback-btn:hover:not(.disabled)) {
		background-color: transparent;
	}

	.like-control :global(.feelback-btn:hover:not(.disabled) > .feelback-icon) {
		transform: none;
		transition: none;
	}
</style>
