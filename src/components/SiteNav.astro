---
import Search from "./Search.astro";

const currentPath = Astro.url.pathname;
---

<nav class="site-nav">
  <div class="site-nav__links">
    <a href="/" class={currentPath === "/" ? "is-active" : undefined}>Home</a>
    <a
      href="/commonplace/"
      class={currentPath.startsWith("/commonplace") ? "is-active" : undefined}
    >
      Commonplace
    </a>
    <a
      href="/archive/"
      class={currentPath.startsWith("/archive") ? "is-active" : undefined}
    >
      Archive
    </a>
  </div>
  <div class="site-nav__search">
    <Search />
  </div>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem 0.4rem;
    background: #fff;
    width: min(var(--site-max-width), 100%);
    margin: 0 auto;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: 1;
  }

  .site-nav__links a {
    position: relative;
    color: rgba(15, 23, 42, 0.78);
    text-decoration: none;
    padding: 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .site-nav__links a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.65rem;
    width: 1.75rem;
    height: 2px;
    background: rgba(15, 23, 42, 0.85);
    transform: translateX(-50%) scaleX(0);
    opacity: 0;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      height 0.2s ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a:focus-visible {
    color: rgba(15, 23, 42, 1);
  }

  .site-nav__links a:hover::after,
  .site-nav__links a:focus-visible::after {
    transform: translateX(-50%) scaleX(1);
    opacity: 1;
    height: 2px;
  }

  .site-nav__links a.is-active {
    color: rgba(15, 23, 42, 1);
  }

  .site-nav__links a.is-active::after {
    transform: translateX(-50%) scaleX(1);
    opacity: 1;
    height: 4px;
  }

  .site-nav__search {
    margin-left: auto;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 760px) {
    .site-nav {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .site-nav__links {
      /* width: auto; */
      order: 1;
    }
    .site-nav__search {
      order: 2;
      /* width: 100%; */
      margin-left: 0;
    }
  }
</style>
