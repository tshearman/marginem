---
import Search from "./Search.astro";
import IconWriting from "./icons/IconWriting.astro";
import IconCommonplace from "./icons/IconCommonplace.astro";
import IconGarden from "./icons/IconGarden.astro";
import IconArchive from "./icons/IconArchive.astro";
import IconNewsletter from "./icons/IconNewsletter.astro";
import { MAIN_NAV } from "../lib/site";

interface SiteNavProps {
	activePage?: string;
}

const { activePage } = Astro.props as SiteNavProps;
const ICONS = {
	writing: IconWriting,
	commonplace: IconCommonplace,
	garden: IconGarden,
	archive: IconArchive,
	newsletter: IconNewsletter,
};
---

<nav class="site-nav">
  <div class="site-nav__links">
    {
      MAIN_NAV.map((item) => {
        const isActive = activePage
          ? item.label.toLowerCase() === activePage.toLowerCase()
          : false;
        const Icon = ICONS[item.icon] ?? IconGarden;
        const linkClass = [
          isActive ? "is-active" : null,
          item.isCompact ? "is-compact" : null,
        ]
          .filter(Boolean)
          .join(" ");
        return (
          <a href={item.href} class={linkClass || undefined}>
            <span class="site-nav__text">{item.label}</span>
            <span class="site-nav__icon">
              <Icon />
            </span>
          </a>
        );
      })
    }
  </div>
  <div class="site-nav__search">
    <Search />
  </div>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem 0.4rem;
    background: #fff;
    width: min(var(--site-max-width), 100%);
    margin: 0 auto;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: 1;
  }

  .site-nav__links a {
    position: relative;
    color: rgba(15, 23, 42, 0.78);
    text-decoration: none;
    padding: 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .site-nav__links a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.65rem;
    width: 1.75rem;
    height: 2px;
    background: rgba(15, 23, 42, 0.85);
    transform: translateX(-50%) scaleX(0);
    opacity: 0;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      height 0.2s ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a:focus-visible {
    color: rgba(15, 23, 42, 1);
  }

  .site-nav__links a:hover::after,
  .site-nav__links a:focus-visible::after {
    transform: translateX(-50%) scaleX(1);
    opacity: 1;
    height: 2px;
  }

  .site-nav__links a.is-active {
    color: rgba(15, 23, 42, 1);
  }

  .site-nav__links a.is-active::after {
    transform: translateX(-50%) scaleX(1);
    opacity: 1;
    height: 4px;
  }

  .site-nav__search {
    margin-left: auto;
    display: flex;
    justify-content: flex-end;
  }

  .site-nav__icon {
    display: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  .site-nav__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 760px) {
    .site-nav {
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 0.85rem 1rem 0.4rem;
    }
    .site-nav__links {
      width: auto;
      order: 1;
      font-size: 0.8rem;
      flex-wrap: wrap;
      min-width: 0;
      row-gap: 0.35rem;
    }
    .site-nav__search {
      order: 2;
      margin-left: 0;
    }
  }

  @media (max-width: 420px) {
    .site-nav {
      padding: 1rem 1rem 0.6rem;
    }

    .site-nav__links a.is-compact .site-nav__text {
      display: none;
    }

    .site-nav__links a.is-compact .site-nav__icon {
      display: inline-flex;
      width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
