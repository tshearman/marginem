---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: string | ImageMetadata;
	alt?: string;
	caption?: string;
	height?: string | number;
}

const { src, alt = "", caption, height } = Astro.props as Props;
const heightValue =
	typeof height === "number" ? `${height}px` : height ?? undefined;
const style = heightValue ? `height: ${heightValue};` : undefined;
---
<figure>
  {
    typeof src === "string"
      ? <img src={src} alt={alt} loading="lazy" style={style} />
      : <Image src={src} alt={alt} loading="lazy" style={style} />
  }
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
