---
import { renderPostPreview } from "../lib/card-html";
import { ellipsizeText } from "../lib/text";

interface Props {
	id?: string;
	title: string;
	url: string;
	pubDate?: string;
	displayDate?: string;
	description?: string;
	abstract?: string;
	tags?: string[];
}

const { abstract, description, ...props } = Astro.props as Props;
const html = renderPostPreview({
	...props,
	excerpt: ellipsizeText(abstract || description || "", 340, {
		alwaysAppend: true,
	}),
});
---

<Fragment set:html={html} />
