---
import Tag from "./Tag.astro";
import LikeButton from "./LikeButton.astro";
import DateStamp from "./DateStamp.astro";
import { ellipsizeText } from "../lib/text";

interface Props {
	id?: string;
	title: string;
	url: string;
	pubDate?: string;
	displayDate?: string;
	description?: string;
	abstract?: string;
	tags?: string[];
	showLikes?: boolean;
}

const {
	id,
	title,
	url,
	pubDate = "",
	displayDate = "",
	description = "",
	abstract = "",
	tags = [],
	showLikes = false,
} = Astro.props as Props;

const EXCERPT_LIMIT = 340;

const excerptSource = abstract || description || "";
const excerptPreview = ellipsizeText(excerptSource, EXCERPT_LIMIT, {
	alwaysAppend: true,
});
---

<article class="post-preview" data-search-id={id || undefined}>
  <div class="post-preview__body">
    <h3 class="post-preview__title">
      <a class="post-preview__link" href={url}>{title}</a>
    </h3>
    <div class="post-preview__authors">
      {
        displayDate ? (
          <DateStamp datetime={pubDate} label={displayDate} />
        ) : null
      }
    </div>
    <div class="post-preview__section">
      {
        excerptPreview ? (
          <p class="post-preview__excerpt">{excerptPreview}</p>
        ) : null
      }
    </div>
    <div class="post-preview__meta">
      {
        tags.length ? (
          tags.map((tag) => <Tag tag={tag} />)
        ) : (
          <span class="post-preview__meta-empty">Research Notes</span>
        )
      }
    </div>
    {
      showLikes && id ? (
        <div class="post-preview__likes">
          <LikeButton
            slug={id}
            target="post"
            class="post-preview__like-button"
          />
        </div>
      ) : null
    }
  </div>
</article>
