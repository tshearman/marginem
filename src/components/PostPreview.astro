---
import { renderPostPreview } from "../lib/card-html";
import { ellipsizeText } from "../lib/text";

interface Props {
	id?: string;
	title: string;
	url: string;
	pubDate?: string;
	displayDate?: string;
	description?: string;
	abstract?: string;
	tags?: string[];
}

const {
	id,
	title,
	url,
	pubDate = "",
	displayDate = "",
	description = "",
	abstract = "",
	tags = [],
} = Astro.props as Props;

const EXCERPT_LIMIT = 340;
const excerptSource = abstract || description || "";
const excerptPreview = ellipsizeText(excerptSource, EXCERPT_LIMIT, {
	alwaysAppend: true,
});
const html = renderPostPreview({
	id,
	title,
	url,
	pubDate,
	displayDate,
	excerpt: excerptPreview,
	tags,
});
---

<Fragment set:html={html} />
