---
import LikeButton from "./LikeButton.astro";
import { PostPreview } from "./preact/PostPreview";
import { ellipsizeText } from "../lib/text";

interface Props {
	id?: string;
	title: string;
	url: string;
	pubDate?: string;
	displayDate?: string;
	description?: string;
	abstract?: string;
	tags?: string[];
	showLikes?: boolean;
}

const {
	id,
	title,
	url,
	pubDate = "",
	displayDate = "",
	description = "",
	abstract = "",
	tags = [],
	showLikes = false,
} = Astro.props as Props;

const EXCERPT_LIMIT = 340;

const excerptSource = abstract || description || "";
const excerptPreview = ellipsizeText(excerptSource, EXCERPT_LIMIT, {
	alwaysAppend: true,
});
---

<PostPreview
  id={id}
  title={title}
  url={url}
  pubDate={pubDate}
  displayDate={displayDate}
  excerpt={excerptPreview}
  tags={tags}
  showLikes={showLikes && Boolean(id)}
>
  {
    showLikes && id ? (
      <LikeButton
        slug={id}
        target="post"
        class="post-preview__like-button"
      />
    ) : null
  }
</PostPreview>
