---
type PlotPayload = {
	data?: unknown[];
	layout?: Record<string, unknown>;
	config?: Record<string, unknown>;
};

const { data = [], layout = {}, config = {} } = Astro.props as PlotPayload;
const layoutHeight =
	typeof layout.height === "number" && Number.isFinite(layout.height)
		? layout.height
		: undefined;
const chartStyle = [
	"width: 100%",
	layoutHeight !== undefined
		? `height: ${layoutHeight}px`
		: "min-height: 320px",
].join(" ");
const chartId = `plotly-${
	globalThis.crypto?.randomUUID?.() ?? Math.random().toString(36).slice(2)
}`;
const combinedConfig = {
	displayModeBar: false,
	responsive: true,
	...config,
};
const payloadAttr = JSON.stringify({
	data,
	layout,
	config: combinedConfig,
}).replace(/</g, "\\u003c");
---
<div class="plotly-shell">
  <div
    id={chartId}
    class="plotly-chart"
    style={chartStyle}
    data-plotly={payloadAttr}
  ></div>
</div>
<script>
  import "../scripts/plotly-client.ts";
</script>

<style>
  .plotly-shell {
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
  }

  .plotly-chart {
    display: block;
    max-width: 100%;
    background: #fff;
  }
</style>
