---
import TagList from "./TagList.astro";
import { ellipsizeText } from "../lib/text";

interface Props {
	title: string;
	url: string;
	dateLabel?: string;
	description?: string;
	tags?: string[];
	backgroundImage?: string | null;
}

const {
	title,
	url,
	dateLabel = "",
	description = "",
	tags = [],
	backgroundImage = null,
} = Astro.props as Props;

const summary = ellipsizeText(description, 260);
---

<article
  class={`hero-feature ${backgroundImage ? "" : "hero-feature--fallback"}`}
  style={backgroundImage ? `background-image: ${backgroundImage};` : undefined}
>
  <div
    class={`hero-feature__body ${
      backgroundImage ? "hero-feature__body--image" : ""
    }`}
  >
    {dateLabel ? <p class="hero-feature__date">{dateLabel}</p> : null}
    <h2 class="hero-feature__title">
      <a href={url}>{title}</a>
    </h2>
    {summary ? <p class="hero-feature__summary">{summary}</p> : null}
    <TagList tags={tags} />
  </div>
</article>

<style>
  .hero-feature {
    border-radius: 0.25rem;
    padding: 3rem;
    color: #fff;
    background-size: cover;
    background-position: center;
    border: 1px solid rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: auto;
    min-height: 450px;
  }

  .hero-feature__body {
    text-shadow: none;
  }

  .hero-feature__body--image {
    text-shadow:
      0 0 3px rgba(0, 0, 0, 0.85),
      0 0 6px rgba(0, 0, 0, 0.7),
      0 0 12px rgba(0, 0, 0, 0.6);
  }

  .hero-feature__date {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-feature__title {
    margin: 0.35rem 0 0.75rem;
    font-size: clamp(2.2rem, 4vw, 3rem);
  }

  .hero-feature__title a {
    color: inherit;
    text-decoration: none;
  }

  .hero-feature__title a:hover {
    text-decoration: underline;
  }

  .hero-feature__summary {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-feature :global(.tag) {
    background: rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
    text-shadow:
      0 0 3px rgba(0, 0, 0, 0.85),
      0 0 6px rgba(0, 0, 0, 0.7);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-feature :global(.tag:hover),
  .hero-feature :global(.tag:focus-visible) {
    background: rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
  }

  .hero-feature--fallback {
    color: #101828;
    background-image: linear-gradient(35deg, #f3f4f6, #ffffff);
  }

  .hero-feature--fallback .hero-feature__summary {
    color: #4b5563;
  }

  .hero-feature--fallback :global(.tag) {
    background: rgba(15, 23, 42, 0.05);
    border-color: rgba(15, 23, 42, 0.2);
    color: rgba(15, 23, 42, 0.75);
    text-shadow: none;
  }
</style>
