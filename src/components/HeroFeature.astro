---
import TagList from "./TagList.astro";
import DateStamp from "./DateStamp.astro";
import { ellipsizeText } from "../lib/text";

interface Props {
  title: string;
  url: string;
  dateLabel?: string;
  dateTime?: string | Date;
  description?: string;
  tags?: string[];
  backgroundImage?: string | null;
}

const {
  title,
  url,
  dateLabel = "",
  dateTime,
  description = "",
  tags = [],
  backgroundImage = null,
} = Astro.props as Props;

const summary = ellipsizeText(description, 260);
const hasHeroImage = Boolean(backgroundImage);
const blobPalettes = [
  ["var(--accent)", "var(--accent-2)"],
  ["var(--accent-2)", "var(--accent-3)"],
  ["var(--accent-3)", "var(--accent)"],
  [
    "color-mix(in srgb, var(--accent) 70%, var(--accent-2))",
    "color-mix(in srgb, var(--accent-2) 70%, var(--accent))",
  ],
];
const blobs = hasHeroImage
  ? []
  : Array.from({ length: Math.floor(Math.random() * 3) + 3 }, () => {
      const size = Math.floor(160 + Math.random() * 260);
      const primary = Math.floor(Math.random() * 110) - 10;
      const secondary = Math.floor(Math.random() * 110) - 10;
      const left = Math.min(primary, secondary);
      const top = Math.max(primary, secondary);
      const palette =
        blobPalettes[Math.floor(Math.random() * blobPalettes.length)];
      const angle = Math.floor(Math.random() * 160) - 80;
      const opacity = (0.75 + Math.random() * 0.2).toFixed(2);

      return {
        size,
        top,
        left,
        palette,
        angle,
        opacity,
      };
    });
---

<article
  class={`hero-feature ${hasHeroImage ? "" : "hero-feature--fallback"}`}
  style={`background-image: ${hasHeroImage ? backgroundImage : "none"};`}
>
  {
    !hasHeroImage ? (
      <div class="hero-feature__blobs" aria-hidden="true">
        {blobs.map(({ size, top, left, palette, angle, opacity }) => (
          <span
            class="hero-feature__blob"
            style={`width:${size}px;height:${size}px;top:${top}%;left:${left}%;background:linear-gradient(${angle}deg, ${palette[0]}, ${palette[1]});opacity:${opacity};`}
          />
        ))}
      </div>
    ) : null
  }
  <div
    class={`hero-feature__body ${hasHeroImage ? "hero-feature__body--image" : ""}`}
  >
    {
      dateLabel && dateTime ? (
        <DateStamp
          datetime={dateTime}
          label={dateLabel}
          class="hero-feature__date"
        />
      ) : null
    }
    <h2 class="hero-feature__title">
      <a href={url}>{title}</a>
    </h2>
    {summary ? <p class="hero-feature__summary">{summary}</p> : null}
    <TagList tags={tags} />
  </div>
</article>

<style>
  .hero-feature {
    border-radius: 1rem;
    padding: 2.5rem;
    color: var(--fg-inverse);
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    min-height: 450px;
  }

  .hero-feature__body {
    position: relative;
    z-index: 1;
    text-shadow: none;
    background-color: rgb(var(--white-rgb) / 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-strong);
    border-radius: 25px;
    padding: 2.25rem;
  }

  .hero-feature__body--image {
    text-shadow:
      0 0 3px rgb(var(--shadow-rgb) / 0.85),
      0 0 6px rgb(var(--shadow-rgb) / 0.7),
      0 0 12px rgb(var(--shadow-rgb) / 0.6);
  }

  .hero-feature__title {
    margin: 0.35rem 0 0.75rem;
    font-size: clamp(2rem, 3vw, 2rem);
    line-height: 1.3;
  }

  @media (max-width: 760px) {
    .hero-feature {
      padding: 1.25rem;
    }

    .hero-feature__title {
      font-size: 1.8rem;
    }

    .hero-feature__summary {
      font-size: 1.1rem;
    }

    .hero-feature__body {
      padding: 2.25rem;
    }
  }

  .hero-feature__title a {
    color: inherit;
    text-decoration: none;
  }

  .hero-feature__title a:hover {
    text-decoration: underline;
  }

  .hero-feature__summary {
    margin: 0 0 1rem;
    color: var(--fg-inverse-soft);
  }

  .hero-feature :global(.tag) {
    background: rgb(var(--shadow-rgb) / 0.45);
    border-color: rgb(var(--white-rgb) / 0.5);
    color: var(--fg-inverse);
    text-shadow:
      0 0 3px rgb(var(--shadow-rgb) / 0.85),
      0 0 6px rgb(var(--shadow-rgb) / 0.7);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-feature :global(.tag:hover),
  .hero-feature :global(.tag:focus-visible) {
    background: rgb(var(--shadow-rgb) / 0.65);
    border-color: rgb(var(--white-rgb) / 0.8);
    color: var(--fg-inverse);
  }

  .hero-feature :global(.date-stamp) {
    color: var(--fg-inverse);
  }

  .hero-feature--fallback {
    color: var(--fg);
    background: var(--bg);
    border: var(--thin-border);
  }

  .hero-feature--fallback .hero-feature__summary {
    color: var(--fg);
  }

  .hero-feature--fallback .hero-feature__title,
  .hero-feature--fallback .hero-feature__summary,
  .hero-feature--fallback :global(.date-stamp) {
    text-shadow: 2px 2px 2px rgb(var(--white-rgb) / 0.5);
  }

  .hero-feature--fallback :global(.tag) {
    background: rgb(var(--ink-rgb) / 0.05);
    border-color: var(--thin-border-color);
    color: rgb(var(--ink-rgb) / 0.75);
    text-shadow: none;
  }

  .hero-feature--fallback :global(.tag:hover),
  .hero-feature--fallback :global(.tag:focus-visible) {
    background: rgb(var(--ink-rgb) / 0.12);
    border-color: var(--thin-border-color);
    color: rgb(var(--ink-rgb) / 0.85);
  }

  .hero-feature--fallback :global(.date-stamp) {
    color: var(--fg);
  }

  .hero-feature__blobs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .hero-feature__blob {
    position: absolute;
    border-radius: 999px;
    filter: saturate(1.15);
  }
</style>
