---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
}

const { eyebrow = "", title, description = "" } = Astro.props as Props;
const hasSlot = Astro.slots.has("description");
const hasDescription = description !== "";
---

<header class="page-intro">
  {eyebrow ? <p class="page-intro__eyebrow eyebrow-text">{eyebrow}</p> : null}
  <h1>{title}</h1>
  {hasSlot ? (
    <div class="page-intro__lede">
      <slot name="description" />
    </div>
  ) : hasDescription ? (
    <p class="page-intro__lede">{description}</p>
  ) : null}
</header>

<style>
  .page-intro {
    text-align: center;
    margin-bottom: 3rem;
    margin-top: 2rem;
  }

  .page-intro h1 {
    margin: 0.35rem 0 0.85rem;
    font-size: clamp(2.3rem, 5vw, 3.5rem);
  }

  .page-intro__lede {
    margin: 0 auto;
    max-width: 52ch;
    color: rgba(15, 23, 42, 0.75);
  }

  .page-intro__lede :global(p) {
    margin: 0 0 0.75rem;
  }
</style>
