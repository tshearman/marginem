---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
}

const { eyebrow = "", title, description = "" } = Astro.props as Props;
---

<header class="page-intro">
  {eyebrow ? <p class="page-intro__eyebrow">{eyebrow}</p> : null}
  <h1>{title}</h1>
  {description ? <p class="page-intro__lede">{description}</p> : null}
</header>

<style>
  .page-intro {
    text-align: center;
    margin-bottom: 3rem;
    margin-top: 2rem;
  }

  .page-intro__eyebrow {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: rgba(15, 23, 42, 0.55);
  }

  .page-intro h1 {
    margin: 0.35rem 0 0.85rem;
    font-size: clamp(2.3rem, 5vw, 3.5rem);
  }

  .page-intro__lede {
    margin: 0 auto;
    max-width: 52ch;
    color: rgba(15, 23, 42, 0.75);
  }
</style>
