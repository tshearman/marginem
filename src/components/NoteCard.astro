---
import Tag from "./Tag.astro";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
	content: string;
	source?: string;
	author?: string;
	tags?: string[];
	date?: Date;
	class?: string;
	style?: string;
	searchId?: string;
	searchUrl?: string;
	idOverride?: string;
}

const {
	content,
	source,
	author,
	tags = [],
	date,
	class: className,
	style,
	searchId,
	searchUrl,
	idOverride,
} = Astro.props as Props;
const noteId = idOverride ?? generateNoteId({ content, author, tags, date });
const interactive = Boolean(searchUrl);
---

<article
  class={`note-card ${className || ""} ${interactive ? "note-card--interactive" : ""}`}
  data-tags={JSON.stringify(tags)}
  id={noteId}
  data-search-id={searchId ?? undefined}
  data-search-url={searchUrl ?? undefined}
  style={style}
  role={interactive ? "link" : undefined}
  tabindex={interactive ? "0" : undefined}
>
  {
    !interactive ? (
      <a
        class="note-card__anchor-link"
        href={`#${noteId}`}
        aria-label="Permalink to this note"
      >
        #
      </a>
    ) : null
  }
  <div class="note-content-wrapper">
    <div class="note-content">
      <blockquote class="note-text">{content}</blockquote>
      <div class="note-attribution">
        {author ? <div class="note-author">{author}</div> : null}
        {source ? <div class="note-source">{source}</div> : null}
        {
          date ? (
            <time class="note-date" datetime={date.toISOString()}>
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          ) : null
        }
      </div>
    </div>
    {
      tags.length ? (
        <div class="note-tags">
          {tags.map((tagValue) => (
            <Tag tag={tagValue} variant="filter" size="small" clickable={!interactive} />
          ))}
        </div>
      ) : null
    }
  </div>
</article>

<style>
  .note-card {
    background: #fff;
    border: 0px solid rgba(15, 23, 42, 0.08);
    padding: 1.4rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    break-inside: avoid;
    margin-bottom: 1rem;
    position: relative;
  }

  .note-card--interactive {
    cursor: pointer;
  }

  .note-card--interactive:hover {
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .note-card--interactive:focus-visible {
    outline: 2px solid rgba(15, 23, 42, 0.5);
    outline-offset: 4px;
  }

  .note-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.45);
    pointer-events: none;
  }

  .note-card__anchor-link {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.85rem;
    color: rgba(15, 23, 42, 0.4);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .note-card:hover .note-card__anchor-link,
  .note-card:focus-within .note-card__anchor-link {
    opacity: 1;
  }

  .note-content-wrapper {
    position: relative;
  }

  .note-content {
    margin-bottom: 1rem;
  }

  .note-text {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--fg);
    font-style: italic;
  }

  .note-attribution {
    text-align: right;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: rgba(15, 23, 42, 0.7);
  }

  .note-author {
    font-weight: 600;
  }

  .note-source {
    font-style: italic;
  }

  .note-date {
    display: block;
    font-size: 0.8rem;
    color: rgba(15, 23, 42, 0.55);
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-left: 1.5rem;
    justify-content: flex-end;
  }

  .note-card.hidden {
    display: none;
  }

  .note-card.fade-out {
    opacity: 0.4;
  }

  @media (max-width: 760px) {
    .note-card {
      padding: 1rem;
    }
    .note-content {
      padding-left: 1rem;
    }
  }
</style>
