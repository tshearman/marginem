---
import LikeButton from "./LikeButton.astro";
import { NoteCard as PreactNoteCard } from "./preact/NoteCard";
import { formatDate } from "../lib/date";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
	content: string;
	source?: string;
	author?: string;
	tags?: string[];
	date?: Date;
	class?: string;
	style?: string;
	idOverride?: string;
}

const {
	content,
	source,
	author,
	tags = [],
	date,
	class: className,
	style,
	idOverride,
} = Astro.props as Props;
const noteId = idOverride ?? generateNoteId({ content, author, tags, date });
---

<PreactNoteCard
  content={content}
  source={source}
  author={author}
  tags={tags}
  dateLabel={date ? formatDate(date) : undefined}
  dateTime={date}
  className={className}
  style={style}
  id={noteId}
  dataTags={JSON.stringify(tags)}
>
  <LikeButton slug={noteId} target="note" align="right" />
</PreactNoteCard>
