---
import { renderNoteCard } from "../lib/card-html";
import { formatDate } from "../lib/date";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
	content: string;
	source?: string;
	author?: string;
	tags?: string[];
	date?: Date;
	class?: string;
	idOverride?: string;
}

const {
	content,
	source,
	author,
	tags = [],
	date,
	class: className,
	idOverride,
} = Astro.props as Props;
const html = renderNoteCard({
	content,
	source,
	author,
	tags,
	dateLabel: date ? formatDate(date) : undefined,
	dateTime: date,
	className,
	id: idOverride ?? generateNoteId({ content, author, date }),
});
---

<Fragment set:html={html} />
