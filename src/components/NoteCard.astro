---
import Tag from "./Tag.astro";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
  content: string;
  source?: string;
  author?: string;
  tags?: string[];
  date?: Date;
  class?: string;
  style?: string;
}

const {
  content,
  source,
  author,
  tags = [],
  date,
  class: className,
  style,
} = Astro.props as Props;
const noteId = generateNoteId({ content, author, tags, date });
---

<article
  class={`note-card ${className || ""}`}
  data-tags={JSON.stringify(tags)}
  id={noteId}
  style={style}
>
  <div class="note-content-wrapper">
    <div class="note-content">
      <blockquote class="note-text">{content}</blockquote>
      <div class="note-attribution">
        {author ? <div class="note-author">{author}</div> : null}
        {source ? <div class="note-source">{source}</div> : null}
        {
          date ? (
            <time class="note-date" datetime={date.toISOString()}>
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          ) : null
        }
      </div>
    </div>
    {
      tags.length ? (
        <div class="note-tags">
          {tags.map((tagValue) => (
            <Tag tag={tagValue} variant="filter" size="small" />
          ))}
        </div>
      ) : null
    }
  </div>
</article>

<style>
  .note-card {
    background: #fff;
    border: 0px solid rgba(15, 23, 42, 0.08);
    padding: 1.4rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    break-inside: avoid;
    margin-bottom: 1rem;
    position: relative;
  }

  .note-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.45);
    pointer-events: none;
  }

  .note-content-wrapper {
    position: relative;
  }

  .note-content {
    margin-bottom: 1rem;
  }

  .note-text {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--fg);
    font-style: italic;
  }

  .note-attribution {
    text-align: right;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: rgba(15, 23, 42, 0.7);
  }

  .note-author {
    font-weight: 600;
  }

  .note-source {
    font-style: italic;
  }

  .note-date {
    display: block;
    font-size: 0.8rem;
    color: rgba(15, 23, 42, 0.55);
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-left: 1.5rem;
    justify-content: flex-end;
  }

  .note-card.hidden {
    display: none;
  }

  .note-card.fade-out {
    opacity: 0.4;
  }

  @media (max-width: 760px) {
    .note-card {
      padding: 1rem;
    }
    .note-content {
      padding-left: 1rem;
    }
  }
</style>
