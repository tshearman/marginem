---
import { NoteCard as PreactNoteCard } from "./preact/NoteCard";
import { formatDate } from "../lib/date";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
	content: string;
	source?: string;
	author?: string;
	tags?: string[];
	date?: Date;
	class?: string;
	style?: string;
	idOverride?: string;
	permalinkBase?: string;
}

const {
	content,
	source,
	author,
	tags = [],
	date,
	class: className,
	style,
	idOverride,
	permalinkBase,
} = Astro.props as Props;
const noteId = idOverride ?? generateNoteId({ content, author, tags, date });
const resolvePermalink = (base: string | undefined, id: string) => {
	if (!base) return `#${id}`;
	const trimmed = base.trim();
	if (!trimmed) return `#${id}`;
	if (trimmed.includes("#")) {
		return trimmed.endsWith("#") ? `${trimmed}${id}` : trimmed;
	}
	const normalized = trimmed.endsWith("/") ? trimmed.slice(0, -1) : trimmed;
	return `${normalized}/#${id}`;
};
---

<PreactNoteCard
  content={content}
  source={source}
  author={author}
  tags={tags}
  dateLabel={date ? formatDate(date) : undefined}
  dateTime={date}
  className={className}
  style={style}
  id={noteId}
  dataTags={JSON.stringify(tags)}
  permalinkHref={resolvePermalink(permalinkBase, noteId)}
/>
