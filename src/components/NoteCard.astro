---
import Tag from "./Tag.astro";
import { generateNoteId } from "../lib/noteUtils";

interface Props {
	content: string;
	source?: string;
	author?: string;
	tags?: string[];
	date?: Date;
	class?: string;
	style?: string;
	idOverride?: string;
}

const {
	content,
	source,
	author,
	tags = [],
	date,
	class: className,
	style,
	idOverride,
} = Astro.props as Props;
const noteId = idOverride ?? generateNoteId({ content, author, tags, date });
---

<article
  class={`note-card ${className || ""}`}
  data-tags={JSON.stringify(tags)}
  id={noteId}
  style={style}
>
  <a
    class="note-card__anchor-link"
    href={`#${noteId}`}
    aria-label="Permalink to this note"
  >
    #
  </a>
  <div class="note-content-wrapper">
    <div class="note-content">
      <blockquote class="note-text">{content}</blockquote>
      <div class="note-attribution">
        {author ? <div class="note-author">{author}</div> : null}
        {source ? <div class="note-source">{source}</div> : null}
        {
          date ? (
            <time class="note-date" datetime={date.toISOString()}>
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          ) : null
        }
      </div>
    </div>
    {
      tags.length ? (
        <div class="note-tags">
          {tags.map((tagValue) => (
            <Tag tag={tagValue} variant="filter" size="small" />
          ))}
        </div>
      ) : null
    }
  </div>
</article>
