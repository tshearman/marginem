---
import Search from "./Search.astro";
import { MAIN_NAV, SITE_NAME } from "../lib/site";

interface MastheadProps {
	activePage?: string;
}

const { activePage } = Astro.props as MastheadProps;
---

<header class="masthead">
  <div class="meta">
    <a class="meta__brand" href="/">{SITE_NAME}</a>
    <nav class="meta__nav" aria-label="Primary">
      {
        MAIN_NAV.map((page, i) => {
          const isActive = activePage
            ? page.label.toLowerCase() === activePage.toLowerCase()
            : false;
          return (
            <>
              {i > 0 && <span class="meta__sep" aria-hidden="true"> / </span>}
              <a
                href={page.href}
                class={isActive ? "is-active" : undefined}
                aria-label={page.label}
                data-astro-prefetch="viewport"
              >
                <span class="meta__label">{page.label}</span>
                <span class="meta__abbr" aria-hidden="true">
                  {page.label.slice(0, 2)}
                </span>
              </a>
            </>
          );
        })
      }
    </nav>
    <div class="meta__search">
      <Search />
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">☀</span>
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
</header>

{/* The toggle is handled by the theme bootstrap in HtmlHead.astro. */}
<script>
  import "../scripts/highlight-hover.ts";
</script>

<style>
  .masthead {
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta__brand {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .meta__brand:hover,
  .meta__brand:focus-visible {
    background: var(--highlight);
    color: var(--highlight-fg);
  }

  .meta__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
  }

  .meta__nav a {
    color: var(--ink);
    text-decoration: none;
    padding: 2px 4px;
  }

  .meta__nav a:hover,
  .meta__nav a:focus-visible {
    background: var(--highlight);
    color: var(--highlight-fg);
  }

  .meta__nav a.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .meta__abbr {
    display: none;
  }

  .meta__search {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    font-family: inherit;
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--highlight);
    color: var(--highlight-fg);
    outline: none;
  }

  /* Show the icon for the theme you'd switch TO. */
  .theme-toggle__icon {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-toggle__icon--sun {
    display: inline;
  }
  :global(html:not([data-theme="dark"])) .theme-toggle__icon--moon {
    display: inline;
  }

  @media (max-width: 720px) {
    .meta {
      gap: 8px;
    }
    .meta__label {
      display: none;
    }
    .meta__abbr {
      /* Title-case (Wr/Co/Ga/Ne/Ar) — override the strip's uppercase. */
      display: inline;
      text-transform: none;
      letter-spacing: 0;
    }
  }
</style>
