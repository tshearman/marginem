---
import { DEFAULT_CONFIG } from "../scripts/banner";
import bannerSrcUrl from "../assets/banners/notebook_banner_c.webp?url";

interface BannerProps {
	text: string;
	textNarrow?: string;
	src?: string;
	height?: number;
	pixel?: number;
	invert?: boolean;
	shadowDx?: number;
	shadowDy?: number;
	narrowMax?: number;
	srLabel?: string;
}

const {
	text,
	textNarrow,
	src = bannerSrcUrl,
	height = 300,
	pixel = DEFAULT_CONFIG.pixel,
	invert = true,
	shadowDx = 5,
	shadowDy = 5,
	narrowMax = 720,
	srLabel,
} = Astro.props as BannerProps;

const bannerStyle = `--banner-h:${height}px;background-image:url(${src});`;
---

<div class="banner" style={bannerStyle}>
  <canvas
    data-banner
    data-src={src}
    data-text={text}
    data-text-narrow={textNarrow ?? ""}
    data-narrow-max={String(narrowMax)}
    data-height={String(height)}
    data-pixel={String(pixel)}
    data-invert={String(invert)}
    data-shadow-dx={String(shadowDx)}
    data-shadow-dy={String(shadowDy)}
    style={`height:${height}px;`}></canvas>
  <h1 class="sr-only">{srLabel ?? text}</h1>
</div>

<script is:inline define:vars={{ src }}>
  // Start fetching + decoding the banner image during HTML parse, before the
  // deferred banner module loads. The module picks this up from
  // window.__bannerImgs to skip its own request.
  (function () {
    var w = window;
    var bag = (w.__bannerImgs = w.__bannerImgs || {});
    if (bag[src]) return;
    var img = new Image();
    img.decoding = "async";
    img.fetchPriority = "high";
    img.src = src;
    if (img.decode) img.decode().catch(function () {});
    bag[src] = img;
  })();
</script>
<script>
  import "../scripts/banner.ts";
</script>

<style>
  .banner {
    --shadow: var(--highlight);
    width: min(860px, 100%);
    margin: 0 auto;
    /* Stays raw black — matches the dark notebook scan painted into the canvas
       so there's no light strip during image load, regardless of theme. */
    background-color: #000;
    /* Fixed natural size keyed to the canvas's CSS width — the canvas, the
       CSS background, and the image content all live at the same 1:1 scale
       regardless of viewport. Narrow viewports see a centered crop of the
       composite, not a downscaled version. */
    background-size: 860px auto;
    background-position: center;
    background-repeat: no-repeat;
    line-height: 0;
    border-bottom: 6px solid var(--ink);
    min-height: var(--banner-h, 300px);
    overflow: hidden;
  }
  .banner canvas {
    display: block;
    /* Canvas adapts to the parent's width — so the title text reflows to fit
       narrow viewports. The IMAGE content drawn into the canvas uses a fixed
       scale (see banner.ts), so the image stays at its natural pixel size and
       narrow viewports show a centered crop of it. */
    width: 100%;
    height: var(--banner-h, 300px);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
