---
interface BannerProps {
	text: string;
	textNarrow?: string;
	src?: string;
	height?: number;
	pixel?: number;
	invert?: boolean;
	shadowDx?: number;
	shadowDy?: number;
	narrowMax?: number;
	srLabel?: string;
}

const {
	text,
	textNarrow,
	src = "/banners/notebook_banner_c.png",
	height = 300,
	pixel = 1,
	invert = true,
	shadowDx = 5,
	shadowDy = 5,
	narrowMax = 720,
	srLabel,
} = Astro.props as BannerProps;
---

<div class="banner" style={`--banner-h:${height}px;background-image:url(${src});`}>
  <canvas
    data-banner
    data-src={src}
    data-text={text}
    data-text-narrow={textNarrow ?? ""}
    data-narrow-max={String(narrowMax)}
    data-height={String(height)}
    data-pixel={String(pixel)}
    data-invert={String(invert)}
    data-shadow-dx={String(shadowDx)}
    data-shadow-dy={String(shadowDy)}
    style={`height:${height}px;`}></canvas>
  <h1 class="sr-only">{srLabel ?? text}</h1>
</div>

<script>
  import "../scripts/banner.ts";
</script>

<style>
  .banner {
    --shadow: var(--highlight);
    width: min(860px, 100%);
    margin: 0 auto;
    background-color: #000;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    line-height: 0;
    border-bottom: 6px solid #000;
    min-height: var(--banner-h, 300px);
  }
  .banner canvas {
    display: block;
    width: 100%;
    height: var(--banner-h, 300px);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
