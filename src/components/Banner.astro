---
import bannerSrcUrl from "../assets/banners/_optimized/notebook_banner_c.webp?url";

// Canvas tunables (pixel block size, ink inversion, shadow offset, narrow
// breakpoint) use DEFAULT_CONFIG in scripts/banner.ts; add a data-* attribute
// below to override one.
interface Props {
	text: string;
	textNarrow?: string;
	src?: string;
	/** Banner height in CSS px. Capped at ~400 by the asset pipeline: banners
	 *  are pre-cropped to 1720 × 800 device px (see scripts/optimize-banner.mjs),
	 *  which covers up to 400 CSS px at 2× DPR. Beyond that the canvas
	 *  letterboxes with the background fill. */
	height?: number;
	srLabel?: string;
}

const {
	text,
	textNarrow,
	src = bannerSrcUrl,
	height = 300,
	srLabel,
} = Astro.props;
---

<div class="banner" style={`--banner-h:${height}px;background-image:url(${src});`}>
  <canvas
    data-banner
    data-src={src}
    data-text={text}
    data-text-narrow={textNarrow}
    data-height={height}></canvas>
  <h1 class="sr-only">{srLabel ?? text}</h1>
</div>

<script is:inline define:vars={{ src }}>
  // Start fetching + decoding the banner image during HTML parse, before the
  // deferred banner module loads. The module picks this up from
  // window.__bannerImgs to skip its own request.
  (function () {
    var w = window;
    var bag = (w.__bannerImgs = w.__bannerImgs || {});
    if (bag[src]) return;
    var img = new Image();
    img.decoding = "async";
    img.fetchPriority = "high";
    img.src = src;
    if (img.decode) img.decode().catch(function () {});
    bag[src] = img;
  })();
</script>
<script>
  import "../scripts/banner.ts";
</script>

<style>
  .banner {
    --shadow: var(--highlight);
    /* Stays raw black — matches the dark notebook scan painted into the canvas
       so there's no light strip during image load, regardless of theme. */
    background-color: #000;
    /* Fixed natural size keyed to the canvas's CSS width — the canvas, the
       CSS background, and the image content all live at the same 1:1 scale
       regardless of viewport. Narrow viewports see a centered crop of the
       composite, not a downscaled version. */
    background-size: 860px auto;
    background-position: center;
    background-repeat: no-repeat;
    line-height: 0;
    border-bottom: 6px solid var(--ink);
    min-height: var(--banner-h, 300px);
    overflow: hidden;
  }
  .banner canvas {
    display: block;
    /* Canvas adapts to the parent's width — so the title text reflows to fit
       narrow viewports. The IMAGE content drawn into the canvas uses a fixed
       scale (see banner.ts), so the image stays at its natural pixel size and
       narrow viewports show a centered crop of it. */
    width: 100%;
    height: var(--banner-h, 300px);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
