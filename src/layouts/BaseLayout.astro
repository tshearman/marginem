---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import SiteNav from "../components/SiteNav.astro";
import PostPreview from "../components/PostPreview.astro";
import { getCollection } from "astro:content";

const {
  title = "Notebook",
  description = "Explorations in math, code, and visualization",
  hero = "Notebook",
} = Astro.props;

const posts = await getCollection("blog", ({ data }) => !data.draft);
const searchDateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const searchEntries = posts.map((post) => {
  const pubDate = post.data.pubDate ?? null;
  const isoDate = pubDate ? pubDate.toISOString() : "";
  return {
    id: post.slug,
    title: post.data.title,
    description: post.data.description ?? "",
    pubDate: isoDate,
    displayDate: pubDate ? searchDateFormatter.format(pubDate) : "",
    tags: post.data.tags ?? [],
    url: `/posts/${post.slug}/`,
    content: post.body ?? "",
  };
});
const searchDataJson = JSON.stringify(searchEntries);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div
      id="search-data"
      data-search-data={searchDataJson}
      hidden
      aria-hidden="true"
    >
    </div>
    <div id="search-result-store" hidden aria-hidden="true">
      {
        searchEntries.map((entry) => (
          <PostPreview
            id={entry.id}
            title={entry.title}
            url={entry.url}
            pubDate={entry.pubDate}
            displayDate={entry.displayDate}
            description={entry.description}
            tags={entry.tags}
          />
        ))
      }
    </div>
    <SiteNav />
    <main class="site-main">
      <header class="site-header">
        <p>{description}</p>
        <h1>{hero}</h1>
      </header>
      <slot />
      <footer class="site-footer"></footer>
    </main>
    <script type="module" is:inline>
      import initFootnotes from "/src/scripts/footnotes.js";
      initFootnotes();
    </script>
  </body>
</html>

<style>
  .site-main {
    width: min(74ch, 100%);
    margin: 0 auto;
    padding: 2.25rem 1.5rem 3rem;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.04);
  }

  .site-header p {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .site-header h1 {
    margin: 0.25rem 0 1.5rem;
    font-size: clamp(2.2rem, 4vw, 3.1rem);
    font-weight: 500;
    color: var(--fg);
  }

  .site-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border: 0;
  }
</style>
