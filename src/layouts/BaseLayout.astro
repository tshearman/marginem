---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Masthead from "../components/Masthead.astro";
import Banner from "../components/Banner.astro";
import { SITE_NAME } from "../lib/site";
import favicon from "../assets/favicon.png";

interface BaseLayoutProps {
	title?: string;
	description?: string;
	hero?: string;
	showHero?: boolean;
	includeFootnotes?: boolean;
	activePage?: string;
	bodyClass?: string;
}

const {
	title = SITE_NAME,
	description = "Explorations in math, code, and visualization",
	hero = SITE_NAME,
	showHero = true,
	includeFootnotes = false,
	activePage,
	bodyClass,
} = Astro.props as BaseLayoutProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon.src} type="image/png" />
  </head>
  <body class={bodyClass}>
    <Masthead activePage={activePage} />
    {
      showHero && (
        <Banner
          text={hero.toUpperCase()}
          srLabel={hero}
        />
      )
    }
    <main class="site-main">
      <slot />
      <footer class="site-footer"></footer>
    </main>
    {
      includeFootnotes ? (
        <script>import "../scripts/init-footnotes.js";</script>
      ) : null
    }
  </body>
</html>

<style>
  .site-main {
    width: min(var(--site-max-width), 100%);
    margin: 0 auto;
    padding: 2.25rem 1.5rem 3rem;
    background: var(--bg);
    border: 0;
  }

  .site-header h1 {
    margin: 0.25rem 0 1.5rem;
    font-size: var(--fs-display-md);
    font-weight: 500;
    color: var(--fg);
  }

  .site-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border: 0;
  }
</style>
