---
import "../styles/global.css";
import Masthead from "../components/Masthead.astro";
import Banner from "../components/Banner.astro";
import HtmlHead from "../components/HtmlHead.astro";
import { SITE_NAME } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
	/** Banner title (painted uppercase). Also the default screen-reader label. */
	hero?: string;
	/** Optional narrow-viewport banner title; "\n" forces a line break. */
	heroNarrow?: string;
	/** Small stamp overlaid on the banner. */
	eyebrow?: string;
	/** Strip under the banner. */
	subtitle?: string;
	/** Banner height in CSS px. */
	heroHeight?: number;
	/** Banner image; defaults to the site-wide notebook banner. */
	bannerSrc?: string;
	/** Screen-reader label for the banner; defaults to `hero`. */
	bannerSrLabel?: string;
	showHero?: boolean;
	/** Matched case-insensitively against MAIN_NAV labels. */
	activePage?: string;
	bodyClass?: string;
}

const {
	title = SITE_NAME,
	description,
	hero = SITE_NAME,
	heroNarrow,
	eyebrow,
	subtitle,
	heroHeight = 300,
	bannerSrc,
	bannerSrLabel,
	showHero = true,
	activePage,
	bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HtmlHead title={title} description={description} bannerSrc={bannerSrc} />
  </head>
  <body class={bodyClass}>
    <Masthead activePage={activePage} />
    {
      showHero && (
        <div class="page-hero">
          <div class="page-hero__banner">
            <Banner
              text={hero.toUpperCase()}
              textNarrow={heroNarrow}
              src={bannerSrc}
              height={heroHeight}
              srLabel={bannerSrLabel ?? hero}
            />
            {eyebrow && <span class="page-hero__eyebrow">{eyebrow}</span>}
          </div>
          {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
        </div>
      )
    }
    <main class="site-main">
      <slot />
      <footer class="site-footer">
        <span>{SITE_NAME}</span>
        <span>Notes from the margins</span>
        <span>&copy; 2026</span>
      </footer>
    </main>
  </body>
</html>
