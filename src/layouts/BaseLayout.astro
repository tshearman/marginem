---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import SiteNav from '../components/SiteNav.astro';
import PostPreview from '../components/PostPreview.astro';
import { getCollection } from 'astro:content';

const {
  title = 'Notebook',
  description = 'Explorations in math, code, and visualization',
  hero = 'Notebook'
} = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const searchDateFormatter = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
const searchEntries = posts.map((post) => {
  const pubDate = post.data.pubDate ?? null;
  const isoDate = pubDate ? pubDate.toISOString() : '';
  return {
    id: post.slug,
    title: post.data.title,
    description: post.data.description ?? '',
    pubDate: isoDate,
    displayDate: pubDate ? searchDateFormatter.format(pubDate) : '',
    tags: post.data.tags ?? [],
    url: `/posts/${post.slug}/`,
    content: post.body ?? ''
  };
});
const searchDataJson = JSON.stringify(searchEntries);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div id="search-data" data-search-data={searchDataJson} hidden aria-hidden="true"></div>
    <div id="search-result-store" hidden aria-hidden="true">
      {searchEntries.map((entry) => (
        <PostPreview
          id={entry.id}
          title={entry.title}
          url={entry.url}
          pubDate={entry.pubDate}
          displayDate={entry.displayDate}
          description={entry.description}
          tags={entry.tags}
        />
      ))}
    </div>
    <SiteNav />
    <main>
      <header>
        <p style="letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.75rem; color: #64748b;">{description}</p>
        <h1 style="margin: 0.3rem 0 1rem; font-size: clamp(2.4rem, 4vw, 3.2rem);">{hero}</h1>
      </header>
      <slot />
      <footer>
        <p>© {new Date().getFullYear()} — Built with Astro &amp; MDX.</p>
      </footer>
    </main>
    <script type="module" is:inline>
      import initFootnotes from '/src/scripts/footnotes.js';
      initFootnotes();
    </script>
  </body>
</html>
