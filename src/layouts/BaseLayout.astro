---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Masthead from "../components/Masthead.astro";
import Banner from "../components/Banner.astro";
import { SITE_NAME } from "../lib/site";
import favicon from "../assets/favicon.png";
import bannerSrcUrl from "../assets/banners/notebook_banner_c.webp?url";

interface BaseLayoutProps {
	title?: string;
	description?: string;
	hero?: string;
	/** Optional per-page banner image src. Defaults to Banner's own default
	 *  (the site-wide notebook banner) when omitted. PostLayout uses this
	 *  to forward a heroImage-derived dithered banner. */
	bannerSrc?: string;
	showHero?: boolean;
	includeFootnotes?: boolean;
	activePage?: string;
	bodyClass?: string;
}

const {
	title = SITE_NAME,
	description = "Explorations in math, code, and visualization",
	hero = SITE_NAME,
	bannerSrc,
	showHero = true,
	includeFootnotes = false,
	activePage,
	bodyClass,
} = Astro.props as BaseLayoutProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon.src} type="image/png" />
    <link
      rel="preload"
      as="image"
      href={bannerSrcUrl}
      type="image/webp"
      fetchpriority="high"
    />
  </head>
  <body class={bodyClass}>
    <Masthead activePage={activePage} />
    {
      showHero && (
        <Banner
          text={hero.toUpperCase()}
          src={bannerSrc}
          srLabel={hero}
        />
      )
    }
    <main class="site-main">
      <slot />
      <footer class="site-footer"></footer>
    </main>
    {
      includeFootnotes ? (
        <script>import "../scripts/init-footnotes.js";</script>
      ) : null
    }
  </body>
</html>

<style>
  .site-main {
    width: min(var(--site-max-width), 100%);
    margin: 0 auto;
    padding: 2.25rem 1.5rem 3rem;
    background: var(--bg);
    border: 0;
  }

  .site-header h1 {
    margin: 0.25rem 0 1.5rem;
    font-size: var(--fs-display-md);
    font-weight: 500;
    color: var(--fg);
  }

  .site-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border: 0;
  }
</style>

<style is:global>
  /* Brutalist chrome shared by all top-level page kinds. Scoped to body
     classes so 404 / subscribe pages (which set no body class) keep the
     bare footer from the scoped block above. */
  body.archive-page .site-main,
  body.commonplace-page .site-main,
  body.garden-page .site-main,
  body.newsletter-page .site-main,
  body.post-page .site-main {
    width: 100%;
    max-width: none;
    padding: 0;
    background: var(--paper);
  }

  body.archive-page .site-footer,
  body.commonplace-page .site-footer,
  body.garden-page .site-footer,
  body.newsletter-page .site-footer,
  body.post-page .site-footer {
    margin-top: 4rem;
    padding: 12px;
    border-top: 6px solid var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  body.archive-page .site-footer::before,
  body.commonplace-page .site-footer::before,
  body.garden-page .site-footer::before,
  body.newsletter-page .site-footer::before,
  body.post-page .site-footer::before {
    content: "AD MARGINEM";
  }

  body.archive-page .site-footer::after,
  body.commonplace-page .site-footer::after,
  body.garden-page .site-footer::after,
  body.newsletter-page .site-footer::after,
  body.post-page .site-footer::after {
    content: "© 2026";
  }

  /* Newsletter sits flush against its hero banner. */
  body.newsletter-page .site-footer {
    margin-top: 0;
  }
</style>
