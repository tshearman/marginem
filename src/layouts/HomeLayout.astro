---
import type { CollectionEntry } from "astro:content";
import PostPreview from "../components/PostPreview.astro";
import HeroFeature from "../components/HeroFeature.astro";
import { formatDate as formatDateHelper } from "../lib/date";

type BlogEntry = CollectionEntry<"blog">;
interface Props {
	posts?: BlogEntry[];
	formatDate?: (date: Date) => string;
}

const { posts = [], formatDate: customFormatDate } = Astro.props as Props;
const format = customFormatDate ?? ((date: Date) => formatDateHelper(date));

const heroImage = (post: BlogEntry | undefined) =>
	post?.data?.heroImage ?? null;
const heroStyle = (
	post: BlogEntry | undefined,
	overlay = "rgba(0,0,0,0.45)",
) => {
	const src = heroImage(post);
	if (!src) return null;
	return `linear-gradient(135deg, ${overlay}, rgba(0,0,0,0.2)), url(${src})`;
};
const getUrl = (post: BlogEntry) => `/posts/${post.slug}/`;
const getAbstract = (post: BlogEntry) =>
	post.data.abstract ?? post.data.description ?? "";
const hasPosts = posts.length > 0;
const mostRecentPost = posts[0];
const hybridListPosts = posts.slice(1);
---

{
  !hasPosts ? (
    <p>No posts yet. Check back soon.</p>
  ) : (
    mostRecentPost && (
      <section class="home-layout home-layout--stack">
        <div class="home-layout__lead-row">
          <div class="home-layout__hero">
            <HeroFeature
              id={mostRecentPost.slug}
              title={mostRecentPost.data.title}
              url={getUrl(mostRecentPost)}
              dateLabel={format(mostRecentPost.data.pubDate)}
              dateTime={mostRecentPost.data.pubDate}
              description={getAbstract(mostRecentPost)}
              tags={mostRecentPost.data.tags}
              backgroundImage={heroStyle(mostRecentPost, "rgba(18,18,18,0.75)")}
            />
          </div>
        </div>
        {/* Featured marquee temporarily disabled to avoid loading its scripts */}
        <div class="home-layout__posts">
          {hybridListPosts.map((post) => (
            <PostPreview
              id={post.slug}
              title={post.data.title}
              url={getUrl(post)}
              pubDate={post.data.pubDate?.toISOString?.() ?? ""}
              displayDate={format(post.data.pubDate)}
              description={post.data.description ?? ""}
              abstract={getAbstract(post)}
              tags={post.data.tags}
              showLikes={true}
            />
          ))}
        </div>
      </section>
    )
  )
}

<style>
  .home-layout {
    display: block;
    margin-top: 3rem;
  }

  .home-layout--stack {
    margin-top: 2rem;
  }

  .home-layout__lead-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 2.5rem 0;
  }

  .home-layout__hero {
    flex: 2 1 60%;
  }

  .home-layout__posts {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .home-layout__lead-row {
      flex-direction: column;
      margin: 1.5rem 0 1rem;
      padding-bottom: 2.5rem;
    }
    .home-layout__hero {
      max-height: none;
    }
    .home-layout__posts {
      margin-top: 1rem;
    }
  }

  @media (min-width: 900px) {
    .home-layout__lead-row {
      flex-direction: row;
      align-items: stretch;
    }
    .home-layout__hero {
      flex: 2 1 66%;
    }
  }
</style>
