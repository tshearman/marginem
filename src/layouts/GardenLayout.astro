---
import BaseLayout from "./BaseLayout.astro";
import FilterableCount from "../components/FilterableCount.astro";
import ForceGraph from "../components/ForceGraph.astro";
import GardenNotePreview from "../components/GardenNotePreview.astro";
import { MAIN_PAGES } from "../lib/site";
import "../styles/garden.css";

type GardenCard = {
	slug: string;
	title: string;
	excerpt: string;
	updatedAt: Date;
	relativePath: string;
};

type Breadcrumb = {
	label: string;
	href?: string;
};

type GraphData = {
	nodes: Array<{ id: string; title?: string; url?: string; group?: number }>;
	links: Array<{ source: string; target: string }>;
	height?: number;
	labelKey?: string;
};

interface GardenLayoutProps {
	pageTitle: string;
	description: string;
	eyebrow: string;
	heading: string;
	intro: string;
	notes: GardenCard[];
	breadcrumbs?: Breadcrumb[];
	graph?: GraphData;
	emptyMessage?: string;
}

const {
	pageTitle,
	description,
	eyebrow,
	heading,
	intro,
	notes,
	breadcrumbs = [],
	graph,
	emptyMessage,
} = Astro.props as GardenLayoutProps;

const showEmpty = notes.length === 0;
const showGraph = graph?.nodes.length;
const gardenTooltips = notes.map((note) => ({ ...note, id: note.slug }));
---

<BaseLayout
  title={pageTitle}
  description={description}
  hero={heading}
  heroHeight={140}
  eyebrow={eyebrow}
  subtitle={intro}
  activePage={MAIN_PAGES.garden.label}
  bodyClass="garden-page"
>

  <div class="page-shell">
    {
      breadcrumbs.length ? (
        <nav class="garden-entry__breadcrumbs" aria-label="Breadcrumb">
          <a href="/garden/">Garden</a>
          {breadcrumbs.map((crumb) => (
            <>
              <span aria-hidden="true">/</span>
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span>{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      ) : null
    }

    {
      showEmpty ? (
        <div class="garden-empty">
          <p set:html={emptyMessage ?? "No notes available yet."} />
        </div>
      ) : (
        <section class="garden-content">
          {showGraph ? (
            <ForceGraph
              nodes={graph.nodes}
              links={graph.links}
              height={graph.height ?? 420}
              labelKey={graph.labelKey ?? "title"}
              gardenTooltips={gardenTooltips}
            />
          ) : null}

          <FilterableCount contentType="notes" totalCount={notes.length} />
          <div class="garden-grid">
            {notes.map((note) => (
              <GardenNotePreview note={note} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
