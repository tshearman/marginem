---
import BaseLayout from "./BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import FilterableCount from "../components/FilterableCount.astro";
import ForceGraph from "../components/ForceGraph.astro";
import GardenNoteCard from "../components/GardenNoteCard.astro";

type GardenCard = {
  slug: string;
  title: string;
  excerpt: string;
  updatedAt: Date;
  relativePath: string;
};

type Breadcrumb = {
  label: string;
  href?: string;
};

type GraphData = {
  nodes: Array<{ id: string; title?: string; url?: string; group?: number }>;
  links: Array<{ source: string; target: string }>;
  height?: number;
  labelKey?: string;
};

interface GardenLayoutProps {
  pageTitle: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  notes: GardenCard[];
  vaultRoot?: string;
  breadcrumbs?: Breadcrumb[];
  graph?: GraphData;
  emptyMessage?: string;
  activePage?: string;
}

const {
  pageTitle,
  description,
  eyebrow,
  heading,
  intro,
  notes,
  vaultRoot,
  breadcrumbs = [],
  graph,
  emptyMessage,
  activePage,
} = Astro.props as GardenLayoutProps;

const showEmpty = notes.length === 0;
const showGraph = graph && graph.nodes.length;
const gardenTooltips = notes.map((note) => ({
  id: note.slug,
  slug: note.slug,
  title: note.title,
  excerpt: note.excerpt,
  updatedAt: note.updatedAt,
  relativePath: note.relativePath,
  vaultRoot,
}));
---

<BaseLayout
  title={pageTitle}
  description={description}
  hero="Garden"
  showHero={false}
  activePage={activePage}
>
  <PageIntro eyebrow={eyebrow} title={heading} description={intro}>
    {
      breadcrumbs.length ? (
        <div slot="description">
          <p>{intro}</p>
          <nav class="garden-entry__breadcrumbs" aria-label="Breadcrumb">
            <a href="/garden/">Garden</a>
            {breadcrumbs.map((crumb) => (
              <>
                <span aria-hidden="true">/</span>
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span>{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        </div>
      ) : null
    }
  </PageIntro>
  {
    showEmpty ? (
      <div class="garden-empty">
        <p set:html={emptyMessage ?? "No notes available yet."} />
      </div>
    ) : (
      <section class="garden-content">
        {showGraph ? (
          <ForceGraph
            nodes={graph.nodes}
            links={graph.links}
            height={graph.height ?? 420}
            labelKey={graph.labelKey ?? "title"}
            gardenTooltips={gardenTooltips}
          />
        ) : null}

        <FilterableCount
          contentType="notes"
          totalCount={notes.length}
          class="garden-count"
        />
        <div class="garden-grid">
          {notes.map((note) => (
            <GardenNoteCard
              slug={note.slug}
              title={note.title}
              excerpt={note.excerpt}
              updatedAt={note.updatedAt}
              relativePath={note.relativePath}
              vaultRoot={vaultRoot}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .garden-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .garden-count {
    padding: 0 0.25rem;
  }

  .garden-grid {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }

  .garden-empty {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border: 1px dashed rgba(15, 23, 42, 0.18);
    border-radius: 0.85rem;
    background: rgba(15, 23, 42, 0.02);
  }

  .garden-entry__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.95rem;
    color: rgba(15, 23, 42, 0.7);
  }

  .garden-entry__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .garden-entry__breadcrumbs a:hover,
  .garden-entry__breadcrumbs a:focus-visible {
    text-decoration: underline;
  }
</style>
