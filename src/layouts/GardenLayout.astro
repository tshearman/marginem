---
import BaseLayout from "./BaseLayout.astro";
import Banner from "../components/Banner.astro";
import FilterableCount from "../components/FilterableCount.astro";
import ForceGraph from "../components/ForceGraph.astro";
import GardenNotePreview from "../components/GardenNotePreview.astro";
import "../styles/garden.css";

type GardenCard = {
	slug: string;
	title: string;
	excerpt: string;
	updatedAt: Date;
	relativePath: string;
};

type Breadcrumb = {
	label: string;
	href?: string;
};

type GraphData = {
	nodes: Array<{ id: string; title?: string; url?: string; group?: number }>;
	links: Array<{ source: string; target: string }>;
	height?: number;
	labelKey?: string;
};

interface GardenLayoutProps {
	pageTitle: string;
	description: string;
	eyebrow: string;
	heading: string;
	intro: string;
	notes: GardenCard[];
	vaultRoot?: string;
	breadcrumbs?: Breadcrumb[];
	graph?: GraphData;
	emptyMessage?: string;
	activePage?: string;
}

const {
	pageTitle,
	description,
	eyebrow,
	heading,
	intro,
	notes,
	vaultRoot,
	breadcrumbs = [],
	graph,
	emptyMessage,
	activePage,
} = Astro.props as GardenLayoutProps;

const showEmpty = notes.length === 0;
const showGraph = graph?.nodes.length;
const gardenTooltips = notes.map((note) => ({
	id: note.slug,
	slug: note.slug,
	title: note.title,
	excerpt: note.excerpt,
	updatedAt: note.updatedAt,
	relativePath: note.relativePath,
	vaultRoot,
}));

const bannerText = heading.toUpperCase();
---

<BaseLayout
  title={pageTitle}
  description={description}
  hero={heading}
  showHero={false}
  activePage={activePage}
  bodyClass="garden-page"
>
  <div class="garden-hero">
    <div class="garden-hero__banner">
      <Banner
        text={bannerText}
        height={140}
        srLabel={heading}
      />
      <span class="garden-hero__eyebrow">{eyebrow}</span>
    </div>
    <p class="garden-hero__subtitle">{intro}</p>
  </div>

  <div class="garden-shell">
    {
      breadcrumbs.length ? (
        <nav class="garden-entry__breadcrumbs" aria-label="Breadcrumb">
          <a href="/garden/">Garden</a>
          {breadcrumbs.map((crumb) => (
            <>
              <span aria-hidden="true">/</span>
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span>{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      ) : null
    }

    {
      showEmpty ? (
        <div class="garden-empty">
          <p set:html={emptyMessage ?? "No notes available yet."} />
        </div>
      ) : (
        <section class="garden-content">
          {showGraph ? (
            <ForceGraph
              nodes={graph.nodes}
              links={graph.links}
              height={graph.height ?? 420}
              labelKey={graph.labelKey ?? "title"}
              gardenTooltips={gardenTooltips}
            />
          ) : null}

          <FilterableCount
            contentType="notes"
            totalCount={notes.length}
            class="garden-count"
          />
          <div class="garden-grid">
            {notes.map((note) => (
              <GardenNotePreview note={note} vaultRoot={vaultRoot} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
