---
import BaseLayout from "./BaseLayout.astro";
import DateStamp from "../components/DateStamp.astro";
import TagList from "../components/TagList.astro";
import { formatDate } from "../lib/date";
import { SITE_NAME } from "../lib/site";
import SubscribeForm from "src/components/SubscribeForm.astro";

interface Frontmatter {
	title?: string;
	description?: string;
	pubDate?: string | Date;
	issueNumber?: number;
	tags?: string[];
}

interface Props {
	frontmatter: Frontmatter;
	slug: string;
	activePage?: string;
}

const { frontmatter: rawFrontmatter, activePage } = Astro.props as Props;
const frontmatter = rawFrontmatter ?? {};
const title =
	typeof frontmatter.title === "string" ? frontmatter.title : "Newsletter";
const description =
	typeof frontmatter.description === "string" ? frontmatter.description : "";
const pubDate =
	typeof frontmatter.pubDate === "string" || frontmatter.pubDate instanceof Date
		? frontmatter.pubDate
		: undefined;
const formattedDate = pubDate
	? formatDate(pubDate, {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: "";
const issueNumber =
	typeof frontmatter.issueNumber === "number" ? frontmatter.issueNumber : null;
const issueLabel =
	issueNumber !== null ? `Issue ${issueNumber}: ${title}` : title;
const tags = Array.isArray(frontmatter.tags) ? frontmatter.tags : [];
---

<BaseLayout
  title={`${issueLabel} | ${SITE_NAME}`}
  description={description}
  hero={issueLabel}
  showHero={false}
  activePage={activePage}
>
  <header class="newsletter-hero">
    <p class="newsletter-hero__eyebrow">Newsletter</p>
    <h1 class="newsletter-hero__title">{title}</h1>
    <h2>
      {issueNumber !== null ? <span>Issue #{issueNumber}</span> : null}
    </h2>
    {description ? <p class="newsletter-hero__lede">{description}</p> : null}
    <div class="newsletter-hero__meta">
      {
        formattedDate && pubDate ? (
          <DateStamp datetime={pubDate} label={formattedDate} />
        ) : null
      }
    </div>
    {
      tags.length ? (
        <div class="newsletter-hero__tags">
          <TagList tags={tags} align="center" variant="display" />
        </div>
      ) : null
    }
  </header>
  <article class="newsletter-body">
    <slot />
  </article>
  <hr class="newsletter-divider" />
  <div class="newsletter-archive__subscribe">
    <SubscribeForm variant="compact" redirectUrl="/subscribe/confirmed" />
  </div>
</BaseLayout>

<style>
  .newsletter-hero {
    text-align: center;
    margin: 2rem auto 2.5rem;
    max-width: 60ch;
  }

  .newsletter-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    color: rgb(var(--ink-rgb) / 0.6);
    margin: 0 0 0.5rem;
  }

  .newsletter-hero__title {
    margin: 0.25rem 0 0.75rem;
    font-size: var(--fs-display-md);
  }

  .newsletter-hero__meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-base);
    color: rgb(var(--ink-rgb) / 0.7);
  }

  .newsletter-hero__issue {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: var(--thin-border);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .newsletter-hero__lede {
    margin-top: 1rem;
    color: rgb(var(--ink-rgb) / 0.75);
  }

  .newsletter-hero__tags {
    margin-top: 1rem;
  }

  .newsletter-hero__tags :global(.tag) {
    font-size: var(--fs-sm);
  }

  .newsletter-body {
    font-size: var(--fs-md);
    line-height: 1.85;
    color: var(--fg);
  }

  .newsletter-body > *:first-child {
    margin-top: 0;
  }

  .newsletter-divider {
    border: 0;
    border-top: var(--thin-border);
    margin: 5rem 0 5rem;
  }
</style>
