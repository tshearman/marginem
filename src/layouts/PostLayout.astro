---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import LikeButton from "../components/LikeButton.astro";
import DateStamp from "../components/DateStamp.astro";
import { formatDate } from "../lib/date";

interface Frontmatter {
	title?: string;
	description?: string;
	abstract?: string;
	pubDate?: string | Date;
	tags?: string[];
}

interface Props {
	frontmatter: Frontmatter;
	slug: string;
	activePage?: string;
}

const { frontmatter: rawFrontmatter, slug, activePage } = Astro.props as Props;
const frontmatter = rawFrontmatter ?? {};
const pubDate =
	typeof frontmatter.pubDate === "string" || frontmatter.pubDate instanceof Date
		? frontmatter.pubDate
		: undefined;
const formattedDate = pubDate
	? formatDate(pubDate, {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: "";
const abstractText =
	typeof frontmatter.abstract === "string"
		? frontmatter.abstract
		: typeof frontmatter.description === "string"
			? frontmatter.description
			: "";
const tags = Array.isArray(frontmatter.tags)
	? frontmatter.tags.filter((tag): tag is string => typeof tag === "string")
	: [];
const title = typeof frontmatter.title === "string" ? frontmatter.title : "Post";
const description =
	typeof frontmatter.description === "string" ? frontmatter.description : "";
---

<BaseLayout
  title={`${title} | Notebook`}
  description={description}
  hero={title}
  showHero={false}
  includeFootnotes={true}
  activePage={activePage}
>
  <section class="paper-title">
    <div class="paper-title__rule paper-title__rule--thick" aria-hidden="true">
    </div>
    <h1 class="paper-title__heading">{title}</h1>
    <div class="paper-title__rule paper-title__rule--thin" aria-hidden="true">
    </div>
    <div class="paper-title__meta">
      {
        formattedDate && pubDate ? (
          <DateStamp datetime={pubDate} label={formattedDate} />
        ) : null
      }
    </div>
    {
      tags.length ? (
        <div class="paper-title__tags">
          <TagList
            tags={tags}
            align="center"
            linkToTags
            variant="default"
          />
        </div>
      ) : null
    }
    {
      abstractText ? (
        <section class="paper-abstract">
          <strong class="paper-abstract__heading">Abstract.</strong>
          <p class="paper-abstract__body">{abstractText}</p>
        </section>
      ) : null
    }
    <div class="paper-title__likes">
      <LikeButton slug={slug} target="post" />
    </div>
    <div class="paper-title__rule paper-title__rule--thin" aria-hidden="true">
    </div>
  </section>
  <article class="paper-body">
    <slot />
  </article>
</BaseLayout>

<style>
  .paper-title {
    text-align: center;
    margin-bottom: 2.5rem;
    margin-top: 2.5rem;
  }

  .paper-title__heading {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .paper-title__rule {
    width: 100%;
    margin: 0 auto;
    background: var(--fg);
  }

  .paper-title__rule--thick {
    height: 8px;
    margin-bottom: 1.75rem;
  }

  .paper-title__rule--thin {
    height: 1px;
    margin: 1.25rem auto;
  }

  .paper-title__tags {
    margin-top: 0.75rem;
    display: flex;
    justify-content: center;
  }

  .paper-title__tags .tag-list {
    margin: 0.5rem 0 1.25rem;
  }

  .paper-abstract {
    max-width: 60ch;
    margin: 0 auto 2.5rem;
    text-align: left;
  }

  .paper-abstract__heading {
    display: block;
    text-align: center;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .paper-abstract__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    text-align: left;
  }

  .paper-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--fg);
  }

  .paper-body > *:first-child {
    margin-top: 0;
  }

  .paper-title__likes {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
