---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import DateStamp from "../components/DateStamp.astro";
import { formatDate } from "../lib/date";
import { SITE_NAME } from "../lib/site";
import "../styles/post.css";

interface Frontmatter {
	title?: string;
	subtitle?: string;
	description?: string;
	abstract?: string;
	pubDate?: string | Date;
	tags?: string[];
}

interface Props {
	frontmatter: Frontmatter;
	activePage?: string;
}

const { frontmatter: rawFrontmatter, activePage } = Astro.props as Props;
const frontmatter = rawFrontmatter ?? {};
const pubDate =
	typeof frontmatter.pubDate === "string" || frontmatter.pubDate instanceof Date
		? frontmatter.pubDate
		: undefined;
const formattedDate = pubDate
	? formatDate(pubDate, {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: "";
const abstractText =
	typeof frontmatter.abstract === "string"
		? frontmatter.abstract
		: typeof frontmatter.description === "string"
			? frontmatter.description
			: "";
const tags = Array.isArray(frontmatter.tags)
	? frontmatter.tags.filter((tag): tag is string => typeof tag === "string")
	: [];
const title =
	typeof frontmatter.title === "string" ? frontmatter.title : "Post";
const subtitle =
	typeof frontmatter.subtitle === "string" && frontmatter.subtitle.trim().length
		? frontmatter.subtitle.trim()
		: undefined;
const description =
	typeof frontmatter.description === "string" ? frontmatter.description : "";
---

<BaseLayout
  title={`${title} | ${SITE_NAME}`}
  description={description}
  hero={title}
  showHero={true}
  includeFootnotes={true}
  activePage={activePage}
  bodyClass="post-page"
>
  <div class="post-shell">
    <section class="paper-title">
      <p class="paper-title__eyebrow">Essay</p>
      <h1 class="paper-title__heading">{title}</h1>
      {
        subtitle ? (
          <p class="paper-title__subtitle">
            <span class="paper-title__subtitle-rule" aria-hidden="true" />
            <span class="paper-title__subtitle-text">{subtitle}</span>
          </p>
        ) : null
      }
      <div class="paper-title__meta">
        {
          formattedDate && pubDate ? (
            <DateStamp datetime={pubDate} label={formattedDate} />
          ) : null
        }
      </div>
      {
        tags.length ? (
          <div class="paper-title__tags">
            <TagList
              tags={tags}
              align="start"
              linkToTags
              variant="default"
            />
          </div>
        ) : null
      }
      {
        abstractText ? (
          <section class="paper-abstract">
            <strong class="paper-abstract__heading">Abstract</strong>
            <p class="paper-abstract__body">{abstractText}</p>
          </section>
        ) : null
      }
    </section>
    <article class="paper-body">
      <slot />
    </article>
  </div>
</BaseLayout>
