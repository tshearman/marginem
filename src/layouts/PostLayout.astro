---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import DateStamp from "../components/DateStamp.astro";
import { POST_BANNERS } from "../assets/post-banners";
import { formatDate } from "../lib/date";
import { SITE_NAME } from "../lib/site";
import "../styles/post.css";
// KaTeX CSS only ships on routes that render math: here and the garden note
// page (src/pages/garden/[...slug].astro), which mirrors these imports.
import "katex/dist/katex.min.css";
import "../styles/katex.css";

interface Props {
	frontmatter: {
		title: string;
		subtitle?: string;
		description?: string;
		abstract?: string;
		pubDate?: Date;
		tags?: string[];
		heroImage?: string;
	};
	activePage?: string;
	showHero?: boolean;
	eyebrow?: string;
	showAbstract?: boolean;
}

const {
	frontmatter,
	activePage,
	showHero = true,
	eyebrow = "Essay",
	showAbstract = true,
} = Astro.props;
const { title, subtitle, description, pubDate, tags = [] } = frontmatter;
const abstractText = frontmatter.abstract ?? description;
// Posts whose heroImage has been processed by `npm run banner:image` get a
// dithered banner; everything else falls back to the site banner.
const bannerSrc = frontmatter.heroImage
	? POST_BANNERS[frontmatter.heroImage]
	: undefined;
---

<BaseLayout
  title={`${title} | ${SITE_NAME}`}
  description={description}
  hero={title}
  bannerSrc={bannerSrc}
  showHero={showHero}
  activePage={activePage}
  bodyClass="post-page"
>
  <div class="post-shell">
    <section class="paper-title">
      <p class="paper-title__eyebrow">{eyebrow}</p>
      <h1 class="paper-title__heading">{title}</h1>
      {
        subtitle?.trim() && (
          <p class="paper-title__subtitle">
            <span class="paper-title__subtitle-rule" aria-hidden="true" />
            <span class="paper-title__subtitle-text">{subtitle.trim()}</span>
          </p>
        )
      }
      <div class="paper-title__meta">
        {
          pubDate && (
            <DateStamp
              datetime={pubDate}
              label={formatDate(pubDate, {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            />
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="paper-title__tags">
            <TagList tags={tags} align="start" linkToTags variant="default" />
          </div>
        )
      }
      {
        showAbstract && abstractText && (
          <section class="paper-abstract">
            <strong class="paper-abstract__heading">Abstract</strong>
            <p class="paper-abstract__body">{abstractText}</p>
          </section>
        )
      }
    </section>
    <article class="paper-body">
      <slot />
    </article>
  </div>
  <slot name="after-body" />
</BaseLayout>

<script>
  import "../scripts/init-footnotes.js";
</script>
