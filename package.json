{
  "name": "marginem",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "banner:image": "node scripts/optimize-banner.mjs",
    "fonts:build": "node scripts/subset-fonts.mjs",
    "predev": "npm run banner:image",
    "prebuild": "npm run banner:image",
    "prebuild:static": "npm run banner:image",
    "build-cloudflare": "bash scripts/cloudflare_build.sh",
    "build:static": "RUN_CODE_SNIPPETS=false astro build",
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf dist .astro .wrangler src/.wrangler node_modules",
    "deploy": "bash scripts/deploy.sh promote",
    "deploy-cloudflare": "bash scripts/cloudflare_deploy.sh",
    "deploy:status": "bash scripts/deploy.sh status",
    "dev": "astro dev",
    "format:snippets": "node scripts/format-snippets.mjs",
    "format:source": "biome format --write src plugins astro.config.mjs",
    "format": "npm run format:source && npm run format:snippets",
    "gitleaks:staged": "gitleaks protect --staged --redact",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks": "sh .githooks/pre-commit",
    "lint:snippets": "node scripts/lint-snippets.mjs",
    "lint:source": "biome lint src plugins astro.config.mjs",
    "lint": "npm run check && npm run lint:source && npm run lint:snippets",
    "postinstall": "node scripts/patch-katex.mjs && npm run hooks:install",
    "preview": "npx wrangler pages dev ../dist --port 4321 --compatibility-date=2024-10-01 --cwd src --env-file ../.dev.vars",
    "preview:static": "npm run build:static && npx --yes serve dist -l tcp://0.0.0.0:4321",
    "rollback": "bash scripts/deploy.sh rollback",
    "start": "astro dev",
    "sync:obsidian": "node scripts/sync-obsidian.mjs",
    "test:blocks": "node scripts/run-code-blocks.mjs",
    "test": "vitest run && npm run test:blocks",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/mdx": "^4.3.13",
    "astro": "^5.16.15",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "katex": "^0.16.27",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.0.10",
    "clean-css": "^5.3.3",
    "happy-dom": "^20.3.7",
    "inline-css": "^4.0.3",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.60.0"
  },
  "overrides": {
    "undici": "^7.18.2",
    "lodash": "^4.17.23"
  }
}
