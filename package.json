{
  "name": "marginem",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:obsidian": "node scripts/sync-obsidian.mjs",
    "deploy": "node scripts/deploy.mjs",
    "predeploy": "npm run verify",
    "build": "PAGES_FUNCTIONS=true astro build",
    "build:static": "PAGES_FUNCTIONS=true RUN_CODE_SNIPPETS=false astro build",
    "preview": "PAGES_FUNCTIONS=true npx wrangler pages dev ../dist --port 4321 --compatibility-date=2024-10-01 --cwd src --env-file ../.dev.vars",
    "clean": "rm -rf dist .astro .wrangler",
    "check": "astro check",
    "test:blocks": "node scripts/run-code-blocks.mjs",
    "test": "vitest run && npm run test:blocks",
    "verify": "npm run lint && npm test && npm run build",
    "lint:source": "biome lint src plugins astro.config.mjs",
    "lint:snippets": "node scripts/lint-snippets.mjs",
    "lint": "npm run check && npm run lint:source && npm run lint:snippets",
    "format:source": "biome format --write src plugins astro.config.mjs",
    "format:snippets": "node scripts/format-snippets.mjs",
    "format": "npm run format:source && npm run format:snippets",
    "postinstall": "node scripts/patch-katex.mjs && npm run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks": "sh .githooks/pre-commit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.0.0",
    "@astrojs/preact": "^4.1.2",
    "astro": "^5.16.9",
    "astro-feelback": "^0.3.4",
    "better-sqlite3": "^11.8.1",
    "d3": "^7.9.0",
    "katex": "^0.16.9",
    "plotly.js": "^3.3.1",
    "preact": "^10.27.2",
    "prismjs": "^1.29.0",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^1.6.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.3.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "wrangler": "^4.60.0",
    "juice": "^10.0.1",
    "clean-css": "^5.3.3",
    "inline-css": "^4.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-mdx": "^3.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "overrides": {
    "undici": "^7.18.2",
    "lodash": "^4.17.23"
  }
}
