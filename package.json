{
  "name": "marginem",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:obsidian": "node scripts/sync-obsidian.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build": "astro build",
    "build:static": "RUN_CODE_SNIPPETS=false astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:blocks": "node scripts/run-code-blocks.mjs",
    "test": "vitest run && npm run test:blocks",
    "lint:source": "biome lint src plugins astro.config.mjs",
    "lint:snippets": "node scripts/lint-snippets.mjs",
    "lint": "npm run check && npm run lint:source && npm run lint:snippets",
    "format:source": "biome format --write src plugins astro.config.mjs",
    "format:snippets": "node scripts/format-snippets.mjs",
    "format": "npm run format:source && npm run format:snippets"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.0.0",
    "@astrojs/preact": "^4.1.2",
    "astro": "^5.16.9",
    "astro-feelback": "^0.3.4",
    "better-sqlite3": "^11.8.1",
    "d3": "^7.9.0",
    "katex": "^0.16.9",
    "plotly.js-dist-min": "^3.3.1",
    "preact": "^10.27.2",
    "prismjs": "^1.29.0",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^1.6.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
