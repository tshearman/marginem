{
  "name": "blogupdate",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "lint:source": "biome lint src plugins astro.config.mjs",
    "lint:snippets": "node scripts/lint-snippets.mjs",
    "lint": "npm run check && npm run lint:source && npm run lint:snippets",
    "format:source": "biome format --write src plugins astro.config.mjs",
    "format:snippets": "node scripts/format-snippets.mjs",
    "format": "npm run format:source && npm run format:snippets"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/mdx": "^4.3.13",
    "astro": "^5.16.9",
    "better-sqlite3": "^11.8.1",
    "d3": "^7.9.0",
    "katex": "^0.16.9",
    "plotly.js-dist-min": "^3.3.1",
    "prismjs": "^1.29.0",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^1.6.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
