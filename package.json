{
  "name": "blogupdate",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:blocks": "node scripts/run-code-blocks.mjs",
    "preview:inactive": "deploy/scripts/preview.sh",
    "promote": "deploy/scripts/promote.sh",
    "lint:source": "biome lint src plugins astro.config.mjs",
    "lint:snippets": "node scripts/lint-snippets.mjs",
    "lint": "npm run check && npm run lint:source && npm run lint:snippets",
    "format:source": "biome format --write src plugins astro.config.mjs",
    "format:snippets": "node scripts/format-snippets.mjs",
    "format": "npm run format:source && npm run format:snippets"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.2",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.0.0",
    "astro": "^5.16.9",
    "better-sqlite3": "^11.8.1",
    "d3": "^7.9.0",
    "katex": "^0.16.9",
    "nodemailer": "^7.0.12",
    "plotly.js-dist-min": "^3.3.1",
    "preact": "^10.27.2",
    "prismjs": "^1.29.0",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^1.6.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/d3": "^7.4.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "happy-dom": "^20.3.1"
  }
}
