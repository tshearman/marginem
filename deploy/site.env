# The site's identity for scripts/deploy.sh — the only per-repo part of
# the deploy tooling (the lab repo's docs/site-design.md, "Adding a
# site"). Plain KEY=value lines, sourced by bash.
#
#   SITE     the lab.nix `sites` entry name: namespace site-$SITE, the
#            Deployments $SITE / $SITE-preview, the tailnet names
#            https://$SITE.$DOMAIN / https://$SITE-preview.$DOMAIN
#   REPO     the GitHub owner/name build.yml runs in
#   DOMAIN   the lab's ingress domain (default goblin.farm)
SITE=marginem
REPO=tshearman/marginem
